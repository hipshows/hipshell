import { ScrollView, ListView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
// 输入框用项目内的精简版 (ui/widgets/lineedit.slint): 选中文字为绿色, 不带内置显示密码按钮.
import { LineEdit } from "lineedit.slint";

global Theme {
    in-out property <bool> light: false;
    // 背景层级
    out property <color> window: light ? #edeff0 : #101214;
    out property <color> panel: light ? #ffffff : #17191c;
    out property <color> dialog: light ? #ffffff : #1b1e21;
    out property <color> surface: light ? #f4f6f6 : #131517;
    out property <color> row: light ? #f6f8f8 : #181b1e;
    out property <color> header: light ? #edf0f0 : #1e2125;
    out property <color> hover: light ? #e7ecea : #202428;
    out property <color> selected: light ? #d3e9e2 : #1e3a34;
    // 输入框选中文字的底色, ui/widgets/lineedit.slint 中用同一组值.
    out property <color> text-selection: light ? #159b7f40 : #38b29b66;
    // 文本
    out property <color> text: light ? #22272b : #e4e7e9;
    out property <color> secondary: light ? #4e585e : #9fa7ad;
    out property <color> muted: light ? #7d868d : #6f777e;
    // 线条
    out property <color> border: light ? #d8dcdf : #2b2f34;
    out property <color> separator: light ? #e4e7e8 : #23272b;
    // 按钮与强调色
    out property <color> button: light ? #eef0f1 : #22262b;
    out property <color> button-hover: light ? #e3e7e6 : #2b3036;
    out property <color> button-pressed: light ? #d5dbd9 : #343a41;
    out property <color> accent: light ? #159b7f : #38b29b;
    out property <color> accent-hover: light ? #0f8a70 : #4ec5af;
    out property <color> accent-pressed: light ? #0b7760 : #2c9c86;
    out property <color> accent-text: #ffffff;
    out property <color> danger: light ? #d24a43 : #d95d55;
    out property <color> danger-hover: light ? #e05a52 : #e5756d;
    out property <color> danger-pressed: light ? #b53c36 : #c04a43;
    out property <color> warning: light ? #c03428 : #ff8d81;
    // 状态栏警告 (琥珀色), 与错误红色区分.
    out property <color> caution: light ? #b7791f : #e0a33a;
    // 悬停说明: 半透明深灰底白字, 两种主题都与页面区分开.
    out property <color> tooltip: light ? #2b3138dd : #4a515bd9;
    out property <color> tooltip-text: #ffffff;
    // 仅文件连接与 MCP 连接类操作的蓝色、MCP 执行命令类操作的橙色.
    out property <color> info: light ? #2f7fd6 : #3b8beb;
    out property <color> risk: light ? #d06a1f : #e8873a;
    // 图表与进度
    out property <color> track: light ? #e3e7e6 : #101416;
    out property <color> chart: light ? #f2f4f4 : #14171a;
    out property <color> plot: light ? #ffffff : #101315;
    out property <color> grid: light ? #e0e4e3 : #2a2f34;
    out property <color> overlay: light ? #22272b66 : #05080acc;
    out property <color> cpu: light ? #3a86c8 : #5aa9e6;
    out property <color> memory: light ? #1f9e82 : #45c4a6;
    out property <color> swap: light ? #8f76c9 : #ac8ee8;
    out property <color> cache: light ? #c08f3e : #dfa85c;
    out property <color> network: light ? #4da34d : #6fc26f;
    // 终端默认底色随主题切换, 远端ANSI显式颜色不受影响.
    out property <color> terminal: light ? #ffffff : #131517;
    out property <color> terminal-text: light ? #2b3138 : #dce6f2;
    out property <color> cursor: light ? #159b7f30 : #38b29b33;
    out property <color> cursor-border: light ? #159b7f : #38b29b;
}

export struct ConnectionRow { id: string, label: string, name: string, auth: string, proxy: string, proxy-id: string, host: string, port: string, username: string, group: string }
// label 不含分组; group 为空表示快速连接标签.
export struct SessionRow { id: string, name: string, label: string, group: string, empty: bool, connected: bool, state: int }
export struct ConnectionTreeRow { id: string, name: string, auth: string, proxy: string, proxy-id: string, host: string, port: string, username: string, group: string, folder: bool, expanded: bool, count: int }
export struct TerminalRun { row: int, col: int, cells: int, text: string, block: int, fg: color, bg: color, fg-default: bool, bg-default: bool, inverse: bool, bold: bool, underline: bool, dim: bool, italic: bool }
export struct SelectionSpan { row: int, col: int, cells: int }
export struct FileRow { path: string, label: string, directory: bool, selected: bool, name: string, icon: int, size-text: string, size-bytes: string, kind-text: string, modified-text: string, permissions: string, mode: int, owner: string }
export struct DirectoryRow { path: string, name: string, depth: int, expanded: bool }
// kind: 0 命令 / 1 上传 / 2 下载; state: 0 进行中 / 1 成功 / 2 失败 / 3 已取消; ratio < 0 表示无进度.
// server 为服务器显示名 (按"显示分组"设置决定是否带 [分组]); local 为传输任务的本机路径.
export struct TaskRow { id: string, title: string, server: string, ai: bool, source: string, kind: int, state: int, status: string, detail: string, ratio: float, cancellable: bool, local: string }
// 代理管理中的一项; kind: socks5 / http.
export struct ProxyRow { id: string, name: string, kind: string, host: string, port: string, username: string, has-password: bool, users: int }
export struct PromptRow { prompt: string, echo: bool }
export struct QuickCommandRow { id: string, label: string, group: string, command: string }
export struct ProcessRow { pid: int, name: string, cpu-text: string, memory-text: string }
// state: 0 未安装 / 1 下载中 / 2 已安装.
export struct FontDownloadRow { name: string, state: int }
// MCP 操作记录: label 为 "动作 · 客户端", detail 为对象, info 为执行内容, risk 为风险等级 (0 只读, 1 连接, 2 传输, 3 执行).
export struct McpActivityRow { time: string, label: string, detail: string, ok: bool, info: string, error: string, risk: int }

component Icon inherits Image {
    in property <int> index;
    source: root.index == 0 ? @image-url("icons/folder.svg")
        : root.index == 1 ? @image-url("icons/folder-open.svg")
        : root.index == 3 ? @image-url("icons/file-text.svg")
        : root.index == 4 ? @image-url("icons/file-code.svg")
        : root.index == 5 ? @image-url("icons/file-cog.svg")
        : root.index == 6 ? @image-url("icons/file-archive.svg")
        : root.index == 7 ? @image-url("icons/file-image.svg")
        : root.index == 8 ? @image-url("icons/link.svg")
        : root.index == 11 ? @image-url("icons/x.svg")
        : root.index == 12 ? @image-url("icons/terminal.svg")
        : root.index == 13 ? @image-url("icons/settings.svg")
        : root.index == 14 ? @image-url("icons/eye.svg")
        : root.index == 15 ? @image-url("icons/eye-off.svg")
        : root.index == 16 ? @image-url("icons/loader.svg") : @image-url("icons/file.svg");
    width: 16px; height: 16px;
    colorize: Theme.secondary;
}

// 加载转圈: 标准 Spinner 用蓝色强调色, 这里用绿色与全局统一. 只在读取时创建, 平时不触发重绘.
// 旋转不能加在组件根元素上, 所以包一层.
component LoadSpinner inherits Rectangle {
    Icon {
        width: parent.width; height: parent.height; index: 16; colorize: Theme.accent;
        transform-rotation: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
    }
}

component FileIcon inherits Icon {
    colorize: root.index < 2 ? Theme.cache : root.index == 4 || root.index == 5 || root.index == 12 ? Theme.cpu : root.index == 6 ? Theme.swap : root.index == 7 ? Theme.memory : Theme.secondary;
}

// 使用同一套中文菜单与主题, 内容为滚动条留出空间.
component TextEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> read-only: false;
    in property <TextWrap> wrap: word-wrap;
    in property <string> font-family;
    in property <length> font-size: 13px;
    in property <bool> command-actions: false;
    in property <bool> command-connected: false;
    // 展示区 (命令内容、执行结果) 的提示居中; 输入框保持左上角提示.
    in property <bool> center-placeholder: false;
    callback execute-command(bool);
    in-out property <length> content-x <=> scroll.content-x;
    in-out property <length> content-y <=> scroll.content-y;
    horizontal-stretch: 1; vertical-stretch: 1;
    border-radius: 6px; border-width: 1px; border-color: Theme.border;
    background: Theme.surface;
    forward-focus: input;
    accessible-role: text-input;
    accessible-value <=> root.text;
    accessible-read-only: root.read-only;
    accessible-placeholder-text: root.placeholder-text;
    accessible-action-set-value(value) => { if !root.read-only { root.text = value; } }
    accessible-action-set-selection-offsets(anchor, focus) => { input.set-selection-offsets(anchor, focus); }
    public function select-all() { input.select-all(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }
    ContextMenuArea {
        Menu {
            if root.command-actions: MenuItem { title: "在当前终端执行"; enabled: root.command-connected && root.text != ""; activated => { root.execute-command(false); } }
            if root.command-actions: MenuItem { title: "独立执行"; enabled: root.command-connected && root.text != ""; activated => { root.execute-command(true); } }
            if root.command-actions: MenuSeparator {}
            MenuItem { title: "复制全部"; enabled: root.text != ""; activated => { copy-helper.text = root.text; copy-helper.select-all(); copy-helper.copy(); } }
            MenuItem { title: "复制所选"; enabled: root.text != ""; activated => { input.copy(); } }
            MenuSeparator {}
            MenuItem { title: "剪切"; enabled: !root.read-only; activated => { input.cut(); } }
            MenuItem { title: "粘贴"; enabled: !root.read-only; activated => { input.paste(); } }
            MenuSeparator {}
            MenuItem { title: "全选"; enabled: root.text != ""; activated => { input.select-all(); } }
        }
        scroll := ScrollView {
            x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
            content-width: max(self.visible-width, (root.wrap == TextWrap.no-wrap ? input.preferred-width : self.visible-width - 16px) + 16px);
            content-height: max(self.visible-height, input.preferred-height + 16px);
            input := TextInput {
                width: scroll.content-width - 16px;
                height: max(scroll.visible-height - 16px, self.preferred-height);
                single-line: false; wrap: root.wrap;
                read-only: root.read-only;
                font-family: root.font-family; font-size: root.font-size;
                color: Theme.text;
                selection-background-color: Theme.text-selection;
                selection-foreground-color: Theme.text;
                page-height: scroll.visible-height - 16px;
                accessible-role: none;
                cursor-position-changed(position) => {
                    if !root.read-only {
                        if position.x + scroll.content-x < 0px { scroll.content-x = -position.x; }
                        else if position.x + scroll.content-x > scroll.visible-width - 16px { scroll.content-x = min(0px, scroll.visible-width - 16px - position.x); }
                        if position.y + scroll.content-y < 0px { scroll.content-y = -position.y; }
                        else if position.y + scroll.content-y > scroll.visible-height - 16px { scroll.content-y = min(0px, scroll.visible-height - 16px - position.y); }
                    }
                }
            }
            if root.text == "" && !root.center-placeholder: Text { width: scroll.visible-width - 16px; text: root.placeholder-text; color: Theme.muted; font-size: root.font-size; wrap: word-wrap; }
        }
    }
    if root.text == "" && root.center-placeholder: Text {
        width: parent.width - 24px; x: 12px; text: root.placeholder-text; color: Theme.muted; font-size: 12px;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
    }
    copy-helper := TextInput { visible: false; read-only: true; }
}

// 矢量折线箭头, 不依赖字体: Windows 默认界面字体没有 ▾ ▸ 等字形, 写成文字会显示为方块.
// direction: 0 左 / 1 右 / 2 上 / 3 下; 按 16×16 视图绘制, 随宽高缩放.
component Chevron inherits Path {
    in property <int> direction;
    in property <color> color: Theme.muted;
    width: 10px; height: 10px;
    viewbox-width: 16; viewbox-height: 16;
    commands: root.direction == 0 ? "M 10 3.5 L 5.5 8 L 10 12.5" : root.direction == 1 ? "M 6 3.5 L 10.5 8 L 6 12.5" : root.direction == 2 ? "M 3.5 10 L 8 5.5 L 12.5 10" : "M 3.5 6 L 8 10.5 L 12.5 6";
    stroke: root.color; stroke-width: 1.6px; stroke-line-cap: round; stroke-line-join: round;
}

// 上传/下载的竖向箭头, 同样用矢量绘制; up 为 true 时向上.
component TransferArrow inherits Path {
    in property <bool> up;
    in property <color> color;
    width: 10px; height: 10px;
    viewbox-width: 16; viewbox-height: 16;
    commands: root.up ? "M 8 13.5 L 8 2.5 M 3.5 7 L 8 2.5 L 12.5 7" : "M 8 2.5 L 8 13.5 M 3.5 9 L 8 13.5 L 12.5 9";
    stroke: root.color; stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round;
}

// 顶栏传输图标: 与设置图标同高 (16px) 的线条图标, 左边上箭头表示上传、右边下箭头表示下载, 两支可分别着色;
// 宽 18px, 两支箭头头部之间留出间隔, 不挤在一起.
component TransferIcon inherits Rectangle {
    in property <color> up-color;
    in property <color> down-color;
    width: 18px; height: 16px;
    Path {
        width: 100%; height: 100%; viewbox-width: 18; viewbox-height: 16;
        commands: "M 4 13.5 L 4 2.5 M 1 5.5 L 4 2.5 L 7 5.5";
        stroke: root.up-color; stroke-width: 1.6px; stroke-line-cap: round; stroke-line-join: round;
    }
    Path {
        width: 100%; height: 100%; viewbox-width: 18; viewbox-height: 16;
        commands: "M 14 2.5 L 14 13.5 M 11 10.5 L 14 13.5 L 17 10.5";
        stroke: root.down-color; stroke-width: 1.6px; stroke-line-cap: round; stroke-line-join: round;
    }
}

// 列表的竖向滚动条: 内容超出即显示 (不等鼠标移入), 平时是 4px 滑块加一条浅色滑轨, 只超出一点时滑块接近满长也能看出可以滚动;
// 鼠标移到滚动条区域时加宽到 6px 并显示轨道底色. 放在列表同一父元素内、贴列表右边; 列表本身关闭自带竖向滚动条
// (自带的会把整行高亮挡住一截). 支持拖动, 点轨道空白处跳到该位置; 内容不超出时不显示.
component SlimScrollBar inherits Rectangle {
    in-out property <length> viewport-y;
    in property <length> viewport-height;
    in property <length> visible-height;
    property <length> max-scroll: max(0px, root.viewport-height - root.visible-height);
    property <length> track: root.height - 4px;
    property <length> thumb-h: min(root.track, max(24px, root.track * root.visible-height / max(1px, root.viewport-height)));
    property <length> travel: max(1px, root.track - root.thumb-h);
    property <length> thumb-y: 2px + (root.max-scroll > 0 ? -root.viewport-y / root.max-scroll * root.travel : 0px);
    width: 14px;
    border-radius: 7px;
    background: slim-touch.has-hover || slim-touch.pressed ? Palette.alternate-background : transparent;
    animate background { duration: 150ms; }
    visible: root.max-scroll > 1px;
    property <length> bar-w: slim-touch.has-hover || slim-touch.pressed ? 6px : 4px;
    // 滑轨: 标出可滚动的全长.
    Rectangle {
        x: parent.width - self.width - 4px; y: 2px;
        width: root.bar-w; height: root.track;
        border-radius: self.width / 2;
        background: Theme.border.with-alpha(0.6);
        animate width { duration: 150ms; easing: ease-out; }
    }
    Rectangle {
        x: parent.width - self.width - 4px; y: root.thumb-y;
        width: root.bar-w; height: root.thumb-h;
        border-radius: self.width / 2;
        background: slim-touch.has-hover || slim-touch.pressed ? Theme.secondary : Theme.muted;
        animate width { duration: 150ms; easing: ease-out; }
    }
    slim-touch := TouchArea {
        property <length> start-y;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                if self.mouse-y < root.thumb-y || self.mouse-y > root.thumb-y + root.thumb-h {
                    root.viewport-y = -max(0px, min(root.travel, self.mouse-y - 2px - root.thumb-h / 2)) / root.travel * root.max-scroll;
                }
                self.start-y = root.viewport-y;
            }
        }
        moved => {
            if self.pressed {
                root.viewport-y = max(-root.max-scroll, min(0px, self.start-y - (self.mouse-y - self.pressed-y) / root.travel * root.max-scroll));
            }
        }
    }
}

component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <bool> align-left: false;
    in property <int> icon: -1;
    in property <length> font-size: 13px;
    in property <length> horizontal-padding: 14px;
    // 文字后的矢量箭头方向 (同 Chevron), -1 不显示; 没有文字时箭头居中.
    in property <int> chevron: -1;
    callback clicked;
    horizontal-stretch: 0;
    preferred-width: inner.preferred-width;
    height: 30px;
    border-radius: 6px;
    border-width: root.primary || root.danger ? 0px : 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;
    background: !root.enabled ? Theme.button
        : root.primary ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : root.danger ? (touch.pressed ? Theme.danger-pressed : touch.has-hover ? Theme.danger-hover : Theme.danger)
        : root.checked ? Theme.selected
        : touch.pressed ? Theme.button-pressed
        : touch.has-hover ? Theme.button-hover
        : Theme.button;
    animate background { duration: 110ms; }
    inner := HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: root.align-left ? 10px : root.horizontal-padding;
        padding-right: root.align-left ? 10px : root.horizontal-padding;
        alignment: root.align-left ? start : center;
        spacing: root.text == "" ? 0px : 6px;
        label := Text {
            visible: root.icon < 0;
            text: root.text;
            color: !root.enabled ? Theme.muted : root.primary || root.danger ? Theme.accent-text : Theme.text;
            font-size: root.font-size;
            font-weight: root.primary ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.chevron >= 0: VerticalLayout {
            alignment: center;
            // 只有箭头的按钮把箭头放大到与图标相近, 跟文字一起时保持小箭头.
            Chevron { direction: root.chevron; color: label.color; width: root.text == "" ? 14px : 10px; height: self.width; }
        }
    }
    if root.icon >= 0: Icon { index: root.icon; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Theme.text; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
        accessible-role: button;
        accessible-label: root.text;
        accessible-action-default => { root.clicked(); }
    }
}

component SortSwitch inherits Rectangle {
    in-out property <int> index;
    callback changed();
    horizontal-stretch: 0;
    width: 112px;
    height: 26px;
    border-radius: 6px;
    background: Theme.button;
    border-width: 1px;
    border-color: Theme.border;
    Rectangle {
        x: root.index == 0 ? 2px : parent.width / 2 + 1px;
        y: 2px; width: parent.width / 2 - 3px; height: 22px; border-radius: 4px;
        background: Theme.accent;
        animate x { duration: 120ms; easing: ease-in-out; }
    }
    Text { x: 0px; width: parent.width / 2; height: 100%; text: "CPU"; color: root.index == 0 ? Theme.accent-text : Theme.secondary; font-size: 11.5px; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: parent.width / 2; width: parent.width / 2; height: 100%; text: "内存"; color: root.index == 1 ? Theme.accent-text : Theme.secondary; font-size: 11.5px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.index = root.index == 0 ? 1 : 0; root.changed(); }
        accessible-role: button;
        accessible-label: "进程排序";
        accessible-action-default => { self.clicked(); }
    }
}

// 数值步进: − 数值 + 一体样式, 代替系统 SpinBox 的上下小箭头.
component Stepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <string> label;
    width: 96px; height: 30px; border-radius: 6px;
    background: Theme.button; border-width: 1px; border-color: Theme.border;
    for step[i] in [-1, 1]: Rectangle {
        x: i == 0 ? 1px : parent.width - self.width - 1px; y: 1px; width: 28px; height: parent.height - 2px;
        border-radius: 5px;
        background: step-touch.pressed ? Theme.button-pressed : step-touch.has-hover ? Theme.button-hover : transparent;
        property <bool> active: step < 0 ? root.value > root.minimum : root.value < root.maximum;
        Text { text: step < 0 ? "−" : "+"; color: parent.active ? Theme.text : Theme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
        step-touch := TouchArea {
            enabled: parent.active;
            mouse-cursor: parent.active ? pointer : default;
            clicked => { root.value = max(root.minimum, min(root.maximum, root.value + step)); }
            accessible-role: button;
            accessible-label: (step < 0 ? "减小" : "增大") + root.label;
        }
    }
    Rectangle { x: 29px; width: 1px; height: parent.height - 12px; background: Theme.separator; }
    Rectangle { x: parent.width - 30px; width: 1px; height: parent.height - 12px; background: Theme.separator; }
    Text { x: 30px; width: parent.width - 60px; height: 100%; text: root.value; color: Theme.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea {
        x: 30px; width: parent.width - 60px;
        // 滚轮调节数值.
        scroll-event(event) => {
            if event.delta-y != 0 { root.value = max(root.minimum, min(root.maximum, root.value + (event.delta-y > 0 ? 1 : -1))); return accept; }
            return reject;
        }
        accessible-role: spinbox; accessible-label: root.label; accessible-value: root.value;
    }
}

// 紧凑下拉: 只显示一个小箭头; 列表用 PopupWindow 显示在最上层, 不会被后面的图表遮挡, 点外部自动关闭.
component MiniDropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> index;
    in property <string> label;
    callback changed();
    width: 22px; height: 20px; border-radius: 5px;
    background: drop-touch.has-hover ? Theme.hover : transparent;
    Path {
        x: 5px; y: 4px; width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12;
        commands: "M 2 4 L 6 8 L 10 4";
        stroke: drop-touch.has-hover ? Theme.accent : Theme.secondary; stroke-width: 1.6px;
    }
    drop-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { self.clicked(); }
    }
    popup := PopupWindow {
        x: root.width - 168px; y: root.height + 4px;
        width: 168px; height: min(184px, root.model.length * 27px + 8px);
        Rectangle {
            background: Theme.dialog; border-radius: 6px; border-width: 1px; border-color: Theme.border;
            drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 2px;
            ScrollView {
                VerticalLayout {
                    padding: 4px; spacing: 1px;
                    for item[i] in root.model: Rectangle {
                        height: 26px; border-radius: 4px;
                        background: i == root.index ? Theme.selected : item-touch.has-hover ? Theme.hover : transparent;
                        Text { x: 10px; width: parent.width - 20px; height: 100%; text: item; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                        item-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.index = i; root.changed(); popup.close(); }
                            accessible-role: button;
                            accessible-label: item;
                        }
                    }
                }
            }
        }
    }
}

// 下拉选择框: 外观同输入框, 点击在下方弹出列表, 选中即收起.
// 不用标准 ComboBox: 它在列表收起后会把焦点收回自身, 留下白色焦点框; 这里不取焦点, 也就没有焦点框.
component AppSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <string> label;
    in property <bool> enabled: true;
    callback selected(string);
    property <length> item-height: 28px;
    min-width: 80px; height: 32px; horizontal-stretch: 1;
    border-radius: 4px; border-width: 1px; border-color: Theme.border;
    background: select-touch.has-hover && root.enabled ? Theme.button-hover : Palette.control-background;
    opacity: root.enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding-left: 11px; padding-right: 10px; spacing: 6px;
        Text { horizontal-stretch: 1; text: root.model[root.current-index]; color: Theme.text; vertical-alignment: center; overflow: elide; }
        VerticalLayout { alignment: center; Chevron { direction: 3; color: Theme.secondary; } }
    }
    select-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { popup.show(); }
        accessible-role: combobox; accessible-label: root.label; accessible-value: root.model[root.current-index];
        accessible-action-default => { self.clicked(); }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 3px; width: root.width;
        height: min(8, root.model.length) * root.item-height + 8px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.dialog; border-radius: 6px; border-width: 1px; border-color: Theme.border;
            drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 2px;
            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    for item[i] in root.model: Rectangle {
                        height: root.item-height; border-radius: 4px;
                        background: item-touch.has-hover ? Theme.hover : i == root.current-index ? Theme.selected : transparent;
                        Text { x: 8px; width: parent.width - 16px; height: 100%; text: item; color: Theme.text; vertical-alignment: center; overflow: elide; }
                        item-touch := TouchArea {
                            mouse-cursor: pointer;
                            // 先更新选中项再收起: 收起会销毁列表项, 之后的语句不再可靠执行.
                            clicked => {
                                if i != root.current-index { root.current-index = i; root.selected(item); }
                                popup.close();
                            }
                            accessible-role: button; accessible-label: item;
                        }
                    }
                }
            }
        }
    }
}

// 勾选框: 选中为绿底白勾, 与全局强调色一致 (标准 CheckBox 是蓝色).
component AppCheckBox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> label: root.text;
    min-height: 20px;
    HorizontalLayout {
        spacing: 8px; alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px; height: 18px; border-radius: 4px;
                border-width: root.checked ? 0px : 1.5px; border-color: check-touch.has-hover ? Theme.accent : Theme.muted;
                background: !root.checked ? transparent : check-touch.has-hover ? Theme.accent-hover : Theme.accent;
                animate background { duration: 100ms; }
                if root.checked: Path {
                    x: 3px; y: 3px; width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12;
                    commands: "M 2 6.2 L 4.8 9 L 10 3.2";
                    stroke: Theme.accent-text; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
                }
            }
        }
        if root.text != "": Text { text: root.text; color: Theme.text; vertical-alignment: center; }
    }
    check-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
        accessible-role: checkbox; accessible-checked: root.checked; accessible-label: root.label;
        accessible-action-default => { self.clicked(); }
    }
}

// 密码框: 右侧眼睛按钮切换明文显示, 只影响本机显示. 与齿轮等方形按钮同样放在输入框外, 长密码不会被按钮遮住.
component PasswordEdit inherits HorizontalLayout {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    callback accepted();
    property <bool> reveal;
    // 间距与分组行的齿轮按钮相同, 眼睛与齿轮上下对齐.
    spacing: 8px; horizontal-stretch: 1;
    LineEdit {
        horizontal-stretch: 1; text <=> root.text; enabled: root.enabled; read-only: root.read-only;
        input-type: root.reveal ? InputType.text : InputType.password; placeholder-text: root.placeholder-text;
        accepted => { root.accepted(); }
    }
    AppButton {
        width: 32px; horizontal-padding: 0px; enabled: root.enabled;
        icon: root.reveal ? 15 : 14; text: root.reveal ? "隐藏密码" : "显示密码";
        clicked => { root.reveal = !root.reveal; }
    }
}

component SessionTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> has-connection;
    in property <bool> connected;
    // 0 未连接, 1 连接中, 2 已连接, 3 仅文件传输, 4 失败.
    in property <int> state;
    callback focused;
    callback closed;
    callback tab-action(string);
    callback copy-name();
    // 拖动排序: 按下/松开, 移动时传相对按下点的横向位移; 插入位置由标签栏计算.
    callback drag-press;
    callback drag-move(length);
    callback drag-release;
    in property <bool> dragging;
    // 插入标记: 0 无, 1 本标签前 (画在前方间距中), 2 本标签后 (仅最后一个), 3 第一个标签前 (滚动区左缘会裁掉间距, 画在标签内).
    in property <int> drop-mark;
    horizontal-stretch: 0;
    // 拖动中原位置留浅色占位, 跟随鼠标的是标签栏上的浮动标签.
    opacity: root.dragging ? 0.35 : 1;
    // 保底 160px, 名称长时按文字加宽, 最多 280px (再长末尾省略).
    out property <length> natural-width: max(160px, min(280px, (root.has-connection ? 24px : 10px) + tab-label.preferred-width + 30px));
    width: root.natural-width;
    height: 32px;
    border-radius: 6px;
    background: root.active ? Theme.panel : tab-touch.has-hover ? Theme.hover : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border;
    animate background { duration: 110ms; }
    Rectangle {
        x: 10px; y: parent.height - 2px; width: parent.width - 20px; height: 2px; border-radius: 1px;
        background: root.active ? Theme.accent : transparent;
    }
    if root.has-connection: Rectangle {
        x: 10px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px;
        background: root.state == 2 ? Theme.network : root.state == 3 ? Theme.info : root.state == 1 ? Theme.warning : root.state == 4 ? Theme.danger : Theme.muted;
    }
    tab-label := Text {
        x: root.has-connection ? 24px : 10px; width: parent.width - self.x - 30px; height: 100%;
        text: root.label; color: root.active ? Theme.text : Theme.secondary; font-size: 12.5px;
        overflow: elide; vertical-alignment: center;
    }
    if root.drop-mark != 0: Rectangle {
        x: root.drop-mark == 1 ? -4.5px : root.drop-mark == 2 ? parent.width + 1.5px : 0px;
        y: 2px; width: 3px; height: parent.height - 4px; border-radius: 1.5px;
        background: Theme.accent;
        drop-shadow-blur: 6px; drop-shadow-color: Theme.accent.with-alpha(0.7);
    }
    tab-touch := TouchArea {
        x: 0px; width: parent.width - 30px;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.drag-press(); }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.drag-release(); }
        }
        moved => { if self.pressed { root.drag-move(self.mouse-x - self.pressed-x); } }
        clicked => { root.focused(); }
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { root.focused(); }
    }
    Rectangle {
        x: parent.width - 26px; y: 7px; width: 18px; height: 18px; border-radius: 4px;
        background: close-touch.has-hover ? Theme.danger : transparent;
        // 关闭叉用 SVG 图标并按主题着色: 字体里的 × 和小尺寸 Path 在 Windows (Skia) 上会变形, 图片在两个平台一致.
        Image {
            x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
            source: @image-url("close.svg");
            colorize: close-touch.has-hover ? Theme.accent-text : Theme.muted;
        }
        close-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.closed(); }
            accessible-role: button;
            accessible-label: "关闭会话";
            accessible-action-default => { root.closed(); }
        }
    }
    ContextMenuArea {
        width: parent.width; height: parent.height;
        // 第一组为本标签的连接操作 (按状态只列出可用项), 第二组关闭本标签.
        Menu {
            if root.has-connection && (root.state == 0 || root.state == 4): MenuItem { title: "连接"; activated => { root.tab-action("connect_tab"); } }
            if root.has-connection && (root.state == 0 || root.state == 4): MenuItem { title: "连接 (仅文件)"; activated => { root.tab-action("connect_tab_files"); } }
            if root.state == 3: MenuItem { title: "重新连接终端"; activated => { root.tab-action("open_terminal"); } }
            if root.state == 2: MenuItem { title: "关闭终端 (保留文件)"; activated => { root.tab-action("close_terminal"); } }
            if root.has-connection && root.state != 0: MenuItem { title: "重新连接"; activated => { root.tab-action("reconnect"); } }
            if root.state == 1 || root.state == 2 || root.state == 3: MenuItem { title: "断开连接"; activated => { root.tab-action("disconnect_keep"); } }
            if root.has-connection: MenuSeparator {}
            // 只复制名称, 不带分组: 与 MCP 的 state 返回的 name 一致, 可直接告诉 AI 操作哪台服务器.
            if root.has-connection: MenuItem { title: "复制服务器名称"; activated => { root.copy-name(); } }
            // 打开连接管理的编辑框; 已连接的会话不受影响, 保存后下次连接或重新连接时生效.
            if root.has-connection: MenuItem { title: "编辑连接…"; activated => { root.tab-action("edit_tab_connection"); } }
            if root.has-connection: MenuSeparator {}
            MenuItem { title: "关闭标签"; activated => { root.closed(); } }
        }
    }
}

component PageTab inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    horizontal-stretch: 0;
    preferred-width: inner.preferred-width;
    height: 39px;
    inner := HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: 13px; padding-right: 13px;
        alignment: center;
        label := Text {
            text: root.text;
            color: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.secondary;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 10px; y: parent.height - 1px; width: parent.width - 20px; height: 2px; border-radius: 1px;
        background: root.active ? Theme.accent : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        accessible-role: button;
        accessible-label: root.text;
        accessible-action-default => { root.clicked(); }
    }
}

// 资源占用条: 名称与数值在条上方, 不压在彩色进度上, 深浅主题下都清晰.
component UsageBar inherits Rectangle {
    in property <string> label;
    in property <string> usage;
    in property <float> ratio;
    in property <color> fill;
    height: 30px;
    Text { x: 0px; y: 0px; height: 15px; text: root.label; color: Theme.secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
    Text { x: 40px; y: 0px; width: parent.width - 40px; height: 15px; text: root.usage; color: Theme.text; font-size: 10.5px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Rectangle {
        y: 20px; height: 7px; border-radius: 3.5px; background: Theme.track; clip: true;
        Rectangle {
            x: 0px; height: 100%; border-radius: 3.5px; background: root.fill;
            width: max(0, min(1, root.ratio)) * parent.width;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component MiniBar inherits Rectangle {
    in property <float> ratio;
    in property <color> fill;
    height: 56px;
    Rectangle {
        x: (parent.width - 10px) / 2; width: 10px; height: 100%;
        background: Theme.track; border-radius: 3px; border-width: 1px; border-color: Theme.border; clip: true;
        Rectangle {
            y: parent.height * (1 - max(0, min(1, root.ratio)));
            height: parent.height * max(0, min(1, root.ratio));
            width: 100%;
            background: root.fill;
        }
    }
}

// 表头列宽分隔线: 拖动时把相对按下点的位移交给表格; 分隔线随列宽移动, 位移即增量.
component ColumnGrip inherits Rectangle {
    callback resized(length);
    y: 0px; width: 8px; height: 100%;
    Rectangle { x: 3px; y: 7px; width: 1px; height: parent.height - 14px; background: grip-touch.has-hover || grip-touch.pressed ? Theme.accent : Theme.border; }
    grip-touch := TouchArea {
        mouse-cursor: col-resize;
        moved => { if self.pressed { root.resized(self.mouse-x - self.pressed-x); } }
    }
}

// 侧栏 MCP 状态卡片: 标题行显示已启用服务器数与运行状态, 下方为可滚动的最近操作.
component McpCard inherits Rectangle {
    in property <bool> running;
    in property <int> servers;
    in property <[McpActivityRow]> activity;
    property <McpActivityRow> pop-item;
    property <length> pop-row-y;
    property <int> pop-index;
    property <bool> pop-open;
    property <length> list-x0;
    property <length> list-x1;
    property <length> list-y0;
    property <length> list-y1;
    // 窗口尺寸: 浮层打开时铺满窗口接收点击, 点其他记录直接切换, 点别处关闭.
    in property <length> window-width;
    in property <length> window-height;
    // 色条: 失败红, 执行命令橙, 文件传输黄, 连接蓝, 只读灰.
    function risk-color(c_item: McpActivityRow) -> color {
        return !c_item.ok ? Theme.danger : c_item.risk == 3 ? Theme.risk : c_item.risk == 2 ? Theme.caution : c_item.risk == 1 ? Theme.info : Theme.muted;
    }
    background: Theme.surface;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 10px; spacing: 6px;
        HorizontalLayout {
            // 右侧留出与记录时间相同的边距, "运行"与下方时间右对齐.
            spacing: 6px; height: 20px; padding-right: 8px;
            Text { text: "MCP"; color: Theme.text; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
            Text { text: root.servers + " 台"; color: Theme.secondary; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
            Rectangle { width: 7px; height: 7px; y: (parent.height - 7px) / 2; border-radius: 3.5px; background: root.running ? Theme.network : Theme.danger; }
            Text { text: root.running ? "运行" : "停止"; color: root.running ? Theme.network : Theme.danger; font-size: 11px; font-weight: 600; vertical-alignment: center; }
        }
        // 没有操作时也保留 3 条的高度, 卡片大小不随有无记录跳动.
        if root.activity.length == 0: Rectangle {
            min-height: 3 * 42px; vertical-stretch: 1;
            Text { text: "暂无操作"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
        }
        // 至少完整显示 3 条, 更多时在卡片内滚动. 每条两行: 动作 · 客户端 / 对象; 左侧色条按风险着色, 单击弹出详情.
        if root.activity.length > 0: Rectangle {
          min-height: 3 * 42px; vertical-stretch: 1;
          activity-list := ListView {
            vertical-scrollbar-policy: always-off;
            for item[i] in root.activity: row := Rectangle {
                height: 42px;
                border-radius: 5px;
                // 详情浮层打开时所属记录显示选中色.
                background: root.pop-open && root.pop-index == i ? Theme.selected : row-touch.has-hover ? Theme.hover : transparent;
                Rectangle { x: 0px; y: 7px; width: 3px; height: parent.height - 14px; border-radius: 1.5px; background: root.risk-color(item); }
                Text { x: 10px; y: item.detail == "" ? 13px : 5px; width: parent.width - 72px; height: 16px; text: item.label; color: item.ok ? Theme.text : Theme.danger; font-size: 11px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                Text { x: parent.width - 62px; y: item.detail == "" ? 13px : 5px; width: 54px; height: 16px; text: item.time; color: Theme.muted; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                Text { x: 10px; y: 22px; width: parent.width - 18px; height: 15px; text: item.detail; color: Theme.secondary; font-size: 10px; overflow: elide; vertical-alignment: center; }
                Rectangle { y: parent.height - 1px; width: parent.width - 8px; height: 1px; background: Theme.separator; }
                row-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pop-item = item;
                        root.pop-index = i;
                        root.pop-row-y = row.absolute-position.y - root.absolute-position.y;
                        // 记下列表可见区域 (卡片坐标): 浮层打开期间点到其他记录时据此换成该条.
                        root.list-x0 = activity-list.absolute-position.x - root.absolute-position.x;
                        root.list-x1 = root.list-x0 + activity-list.width;
                        root.list-y0 = activity-list.absolute-position.y - root.absolute-position.y;
                        root.list-y1 = root.list-y0 + activity-list.height;
                        root.pop-open = true; detail-popup.show();
                    }
                }
            }
        }
          SlimScrollBar {
            x: activity-list.x + activity-list.width - self.width; y: activity-list.y; height: activity-list.height;
            viewport-y <=> activity-list.content-y; viewport-height: activity-list.content-height; visible-height: activity-list.visible-height;
          }
        }
    }
    // 详情小浮层: 显示在卡片左侧 (终端区上方), 与所点记录顶端对齐, 右侧小箭头指向该记录; 靠近卡片底部时上移不超出.
    // 浮层是铺满窗口的透明层: 点到列表中其他记录直接换成那条, 再点同一条或点别处关闭 (不需要先点空白处).
    detail-popup := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: root.window-width;
        height: root.window-height;
        close-policy: no-auto-close;
        TouchArea {
            clicked => {
                // 换算为卡片坐标; 列表在浮层打开期间不会滚动, 按行高推算点中的记录.
                let l_x = self.mouse-x - root.absolute-position.x;
                let l_y = self.mouse-y - root.absolute-position.y;
                if l_x >= root.list-x0 && l_x < root.list-x1 && l_y >= root.list-y0 && l_y < root.list-y1 {
                    let l_delta = floor((l_y - root.pop-row-y) / 42px);
                    let l_index = root.pop-index + l_delta;
                    if l_delta != 0 && l_index >= 0 && l_index < root.activity.length {
                        root.pop-index = l_index;
                        root.pop-item = root.activity[l_index];
                        root.pop-row-y += l_delta * 42px;
                        return;
                    }
                }
                detail-popup.close(); root.pop-open = false;
            }
            // 滚轮直接关闭浮层, 不会卡在打开状态; 关闭后再滚动即可滚动下方内容.
            scroll-event(event) => {
                detail-popup.close(); root.pop-open = false;
                return accept;
            }
        }
        panel := Rectangle {
            x: root.absolute-position.x - self.width - 12px;
            y: root.absolute-position.y + min(root.pop-row-y, root.height - self.height);
            width: 262px;
            height: pop-layout.preferred-height;
            background: Theme.dialog; border-radius: 8px; border-width: 1px; border-color: Theme.accent;
            drop-shadow-blur: 18px; drop-shadow-color: #00000070; drop-shadow-offset-y: 3px;
            // 点在浮层自身不关闭.
            TouchArea {}
            pop-layout := VerticalLayout {
                padding: 9px; spacing: 5px;
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle { width: 7px; height: 7px; y: (parent.height - 7px) / 2; border-radius: 3.5px; background: root.risk-color(root.pop-item); }
                    // 浮层里完整显示客户端名, 过长时换行.
                    Text { text: root.pop-item.label; color: root.pop-item.ok ? Theme.text : Theme.danger; font-size: 11px; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: root.pop-item.time; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                }
                if root.pop-item.detail != "": Text { text: root.pop-item.detail; color: Theme.secondary; font-size: 10.5px; overflow: elide; }
                if root.pop-item.info != "": Rectangle {
                    background: Theme.surface; border-radius: 5px;
                    VerticalLayout {
                        padding: 6px;
                        Text { text: root.pop-item.info; color: Theme.text; vertical-alignment: top; font-size: 10.5px; wrap: word-wrap; max-height: 8 * 14px; overflow: elide; }
                    }
                }
                if root.pop-item.error != "": Text { text: "失败: " + root.pop-item.error; color: Theme.danger; font-size: 10.5px; wrap: word-wrap; max-height: 4 * 14px; overflow: elide; }
            }
        }
        // 指向记录的小箭头, 对准记录第一行.
        Path {
            x: panel.x + panel.width - 1px; y: root.absolute-position.y + root.pop-row-y + 7px;
            width: 7px; height: 12px;
            commands: "M 0 0 L 6 6 L 0 12 Z";
            fill: Theme.dialog;
        }
        Path {
            x: panel.x + panel.width - 1px; y: root.absolute-position.y + root.pop-row-y + 7px;
            width: 7px; height: 12px;
            commands: "M 0 0 L 6 6 L 0 12";
            stroke: Theme.accent; stroke-width: 1px;
        }
    }
}
component Dialog inherits Rectangle {
    in property <length> panel-width: 380px;
    in property <length> panel-height: 200px;
    in property <bool> autofocus: false;
    in property <bool> enter-confirms: true;
    callback cancel();
    callback confirm();
    background: Theme.overlay;
    TouchArea {}
    FocusScope {
        init => { if root.autofocus { self.focus(); } }
        // 先于子输入框处理 Esc, 输入框获得焦点时也能取消.
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        key-pressed(event) => {
            if root.enter-confirms && event.text == Key.Return { root.confirm(); return accept; }
            return reject;
        }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: root.panel-width; height: root.panel-height;
            background: Theme.dialog; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            drop-shadow-blur: 28px; drop-shadow-color: #00000066; drop-shadow-offset-y: 6px;
            @children
        }
    }
}

// 对话框内的错误条: 浅红底、红色圆标与文字, 所有对话框统一使用.
// 高度按是否需要换行取一行或两行的固定值, 对话框可据此预留高度; 超过两行省略.
component ErrorBanner inherits Rectangle {
    in property <string> text;
    property <bool> wrapped: measure.preferred-width > msg.width;
    height: root.wrapped ? 50px : 34px;
    border-radius: 6px;
    background: Theme.danger.with-alpha(0.10);
    border-width: 1px;
    border-color: Theme.danger.with-alpha(0.35);
    Rectangle {
        x: 10px; y: (parent.height - self.height) / 2; width: 16px; height: 16px; border-radius: 8px; background: Theme.danger;
        Text { width: 100%; height: 100%; text: "!"; color: #ffffff; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
    // 只用于测量单行宽度, 不显示.
    measure := Text { visible: false; width: 0px; height: 0px; text: root.text; font-size: 12px; }
    msg := Text {
        x: 34px; width: parent.width - 46px; height: 100%;
        text: root.text; color: Theme.warning; font-size: 12px; wrap: word-wrap; overflow: elide; vertical-alignment: center;
    }
}

// 设置页的分组卡片: 标题、说明和内容, 让各项设置在视觉上分开.
// 设置分组: 卡片上方为小标题, 卡片内放若干设置行 (SettingsRow) 或其他内容, 卡片下方可放补充说明.
// 行内说明保持一行, 较长的补充写在 footer, 避免小字换行后行距过紧.
// 当前悬停说明: 悬停区域写入文字和锚点 (窗口坐标, 区域下边缘中点), 窗口最上层的气泡据此显示.
// 不用弹出窗口: 弹出窗口会截走主窗口的鼠标事件, 悬停状态随之丢失而反复闪烁.
global TipState {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
}

// 悬停区域: 盖在名称、状态标签等元素上, 鼠标进入时登记说明, 离开时清除.
component HoverTip inherits TouchArea {
    in property <string> text;
    changed has-hover => {
        if self.has-hover && root.text != "" {
            TipState.x = self.absolute-position.x + self.width / 2;
            TipState.y = self.absolute-position.y + self.height;
            TipState.text = root.text;
        } else if !self.has-hover && TipState.text == root.text {
            TipState.text = "";
        }
    }
}

// 悬停说明的气泡, 所有悬停说明统一用它: 向上的箭头对准锚点, 下接半透明圆角底.
// 不加阴影和边框 (底色半透明时阴影会透出来, 显得发脏).
component TipBubble inherits Rectangle {
    in property <string> text;
    // 箭头尖端相对气泡左边的位置.
    in property <length> arrow-x: 16px;
    width: body.width; height: 6px + body.height;
    Path {
        x: max(8px, min(body.width - 20px, root.arrow-x - 6px)); y: 0px; width: 12px; height: 6px;
        commands: "M 0 6 L 6 0 L 12 6 Z";
        fill: Theme.tooltip;
    }
    body := Rectangle {
        y: 6px;
        width: min(380px, bubble-text.preferred-width + 20px); height: bubble-text.preferred-height + 12px;
        background: Theme.tooltip; border-radius: 6px;
        bubble-text := Text { x: 10px; y: 6px; width: parent.width - 20px; text: root.text; color: Theme.tooltip-text; font-size: 12px; wrap: word-wrap; }
    }
}

// 名称后的小问号: 鼠标移到问号上才弹出说明, 箭头对准问号; 悬停时问号加亮.
component InfoMark inherits Rectangle {
    in property <string> tip;
    width: 13px; height: 13px; border-radius: 6.5px; border-width: 1px;
    border-color: mark-touch.has-hover ? Theme.text : Theme.muted;
    Text { text: "?"; color: mark-touch.has-hover ? Theme.text : Theme.muted; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    mark-touch := HoverTip { text: root.tip; }
}

// 设置分组: 标题、卡片; tip 不为空时标题后带问号, 悬停问号显示说明.
component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> tip;
    spacing: 6px;
    vertical-stretch: 0;
    if root.title != "": Rectangle {
        vertical-stretch: 0; height: title-row.preferred-height;
        title-row := HorizontalLayout {
            alignment: start; spacing: 5px;
            Text { text: root.title; color: Theme.muted; font-size: 11.5px; font-weight: 600; vertical-alignment: center; }
            if root.tip != "": VerticalLayout { alignment: center; InfoMark { tip: root.tip; } }
        }
    }
    // 组被拉伸时 (如服务器列表) 只拉伸卡片, 标题与脚注保持原高.
    Rectangle {
        vertical-stretch: 1;
        background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
        VerticalLayout {
            padding-left: 14px; padding-right: 14px;
            @children
        }
    }
}

// 设置行: 左侧名称与状态说明, 右侧为控件并垂直居中; divider 在行顶部画分隔线 (组内第一行不画).
// 固定的解释写在 tip: 名称后带问号, 悬停问号时在下方显示, 平时不占位置.
component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> tip;
    in property <color> hint-color: Theme.muted;
    in property <bool> divider;
    min-height: 50px;
    if root.divider: Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.separator; }
    HorizontalLayout {
        padding-top: 10px; padding-bottom: 10px; spacing: 16px;
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            HorizontalLayout {
                alignment: start; spacing: 5px;
                Text { text: root.label; color: Theme.text; font-size: 13px; overflow: elide; }
                if root.tip != "": VerticalLayout { alignment: center; InfoMark { tip: root.tip; } }
            }
            if root.hint != "": Text { text: root.hint; color: root.hint-color; font-size: 11.5px; overflow: elide; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            HorizontalLayout { spacing: 8px; @children }
        }
    }
}

// 状态标签: 彩色圆点加简短结论, 可点击; 鼠标移上去时在下方弹出一句说明.
component StatusTip inherits Rectangle {
    in property <color> tone;
    in property <string> text;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: chip.preferred-width; height: 24px; border-radius: 12px;
    background: root.tone.with-alpha(0.12); border-width: 1px; border-color: root.tone.with-alpha(0.35);
    chip := HorizontalLayout {
        padding-left: 9px; padding-right: 11px; spacing: 6px;
        VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.tone; } }
        Text { text: root.text; color: root.tone; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    }
    // 检测结果在悬停期间更新时, 同步更新正在显示的说明.
    changed tip => { if tip-touch.has-hover { TipState.text = root.tip; } }
    tip-touch := HoverTip {
        text: root.tip;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
        accessible-role: button; accessible-label: root.text + ", " + root.tip;
        accessible-action-default => { self.clicked(); }
    }
}

// 分段选择: 一组互斥选项, 当前项高亮; 选中后由调用方立即应用.
component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <string> label;
    callback selected(int);
    height: 30px; border-radius: 7px; background: Theme.button; border-width: 1px; border-color: Theme.border;
    width: segment-row.preferred-width;
    segment-row := HorizontalLayout {
        padding: 2px; spacing: 2px;
        for item[i] in root.items: Rectangle {
            width: max(52px, segment-text.preferred-width + 20px); border-radius: 5px;
            background: root.current == i ? Theme.accent : segment-touch.has-hover ? Theme.button-hover : transparent;
            animate background { duration: 100ms; }
            segment-text := Text {
                text: item; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                color: root.current == i ? Theme.accent-text : Theme.secondary; font-weight: root.current == i ? 600 : 400;
            }
            segment-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { if root.current != i { root.selected(i); } }
                accessible-role: button; accessible-label: root.label + " " + item;
                accessible-action-default => { self.clicked(); }
            }
        }
    }
}

// 表单卡片: 小标题 + 一组 FormRow, 浅色底与细边框把一组字段圈在一起. 并排的卡片由外层布局拉成同高.
component FormCard inherits Rectangle {
    in property <string> title;
    horizontal-stretch: 1;
    background: Theme.window.with-alpha(0.45); border-radius: 8px; border-width: 1px; border-color: Theme.separator;
    VerticalLayout {
        padding: 14px; padding-top: 12px; spacing: 10px; alignment: start;
        Text { text: root.title; color: Theme.muted; font-size: 11px; font-weight: 600; }
        @children
    }
}

// 表单行: 固定宽度的标签 + 输入控件, 同一卡片内标签宽度一致, 各行标签列对齐.
component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 44px;
    // 行高按输入框 (32px) 固定: 只有按钮、页签的行与有输入框的行一样高, 切换内容时卡片高度不变.
    spacing: 8px; height: 32px;
    Text { text: root.label; width: root.label-width; color: Theme.secondary; font-size: 12.5px; vertical-alignment: center; }
    @children
}

// 开关: 点击即切换, 由调用方立即应用.
component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();
    width: 40px; height: 22px; border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.button-pressed;
    animate background { duration: 120ms; }
    accessible-role: checkbox; accessible-checked: root.checked; accessible-label: root.label;
    accessible-action-default => { root.toggled(); }
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px; y: 2px; width: 18px; height: 18px; border-radius: 9px;
        background: #ffffff; drop-shadow-blur: 2px; drop-shadow-color: #00000040;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// 面板展开/收起按钮: 带边框的方形按钮, 箭头指向面板将要移动的方向, 悬停时变为强调色.
// direction: 0 左 / 1 右 / 2 上 / 3 下.
// 面板标题栏里的小图标按钮: 有 source 时显示图片 (按主题着色), 否则显示 chevron 方向的箭头.
component BarButton inherits Rectangle {
    in property <image> source;
    in property <int> chevron: -1;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 26px; height: 26px; border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: !root.enabled ? transparent : bar-touch.pressed ? Theme.button-pressed : bar-touch.has-hover ? Theme.button-hover : transparent;
    animate background { duration: 110ms; }
    if root.chevron >= 0: Chevron {
        x: (parent.width - 14px) / 2; y: (parent.height - 14px) / 2; width: 14px; height: 14px;
        direction: root.chevron; color: bar-touch.has-hover && root.enabled ? Theme.accent : Theme.secondary; stroke-width: 1.8px;
    }
    if root.chevron < 0: Image {
        x: (parent.width - 14px) / 2; y: (parent.height - 14px) / 2; width: 14px; height: 14px;
        source: root.source; colorize: bar-touch.has-hover && root.enabled ? Theme.accent : Theme.secondary;
    }
    bar-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
        accessible-role: button; accessible-label: root.label;
        accessible-action-default => { root.clicked(); }
    }
}

component PanelToggle inherits Rectangle {
    in property <int> direction;
    in property <string> label;
    callback clicked();
    width: 30px; height: 30px; border-radius: 7px;
    border-width: 1px;
    border-color: toggle-touch.has-hover ? Theme.accent.with-alpha(0.6) : Theme.border;
    background: toggle-touch.pressed ? Theme.button-pressed : toggle-touch.has-hover ? Theme.accent.with-alpha(0.12) : Theme.button;
    animate background, border-color { duration: 110ms; }
    Chevron {
        x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2; width: 16px; height: 16px;
        direction: root.direction; color: toggle-touch.has-hover ? Theme.accent : Theme.secondary; stroke-width: 2px;
    }
    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        accessible-role: button; accessible-label: root.label;
        accessible-action-default => { root.clicked(); }
    }
}

// 目录读取遮罩: 文件列表和目录树共用, 跟随父元素大小居中; 挡住下层操作, 让慢网络下也能看到点击已生效.
component LoadingMask inherits Rectangle {
    in property <string> text;
    background: Theme.surface.with-alpha(0.72); border-radius: 6px;
    TouchArea {}
    HorizontalLayout {
        alignment: center; spacing: 10px;
        LoadSpinner { width: 20px; height: 20px; y: (parent.height - 20px) / 2; }
        Text { text: root.text; color: Theme.secondary; font-size: 12px; vertical-alignment: center; overflow: elide; }
    }
}

component FileTable inherits Rectangle {
    in property <[FileRow]> rows;
    in property <string> time-label: "修改时间";
    in property <bool> ready;
    in property <bool> has-parent;
    in property <int> selected-count;
    in-out property <length> scroll-y <=> table.content-y;
    in-out property <length> view-height;
    // 行数减少 (删除、刷新) 后原滚动位置可能超出内容, 首行会被表头遮住: 收回到有效范围.
    private property <int> row-count: root.rows.length;
    changed row-count => {
        table.content-y = max(table.content-y, min(0px, table.visible-height - table.content-height));
    }
    callback select(FileRow, bool, bool, bool);
    // 单击列表空白处 (行以外) 取消全部选中.
    callback clear-selection();
    // 空白处右键: 坐标相对本组件, 由外层弹出目录菜单.
    callback blank-menu(length, length);
    callback activate(FileRow);
    callback file-action(string, FileRow);
    // Delete / Backspace (macOS 的 delete 键) 删除所选: 单个文件为普通删除, 多选或含目录为快速删除 (rm -rf); 均先弹确认框.
    callback delete-pressed();
    // Ctrl/⌘+A 全选当前目录, 与 Delete 一样需先单击行让列表获得键盘焦点.
    callback select-all-pressed();
    // 单击行后获得键盘焦点; 不占位置, 不影响行的点击.
    keys := FocusScope {
        width: 0px; height: 0px;
        key-pressed(event) => {
            if root.ready && root.selected-count > 0 && (event.text == Key.Delete || event.text == Key.Backspace) {
                root.delete-pressed();
                return accept;
            }
            // Slint 在 macOS 上把 Command 报为 control, 物理 Ctrl 报为 meta; 大写 A 为开启大写锁定时的按键.
            if root.ready && (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && !event.modifiers.alt && (event.text == "a" || event.text == "A") {
                root.select-all-pressed();
                return accept;
            }
            return reject;
        }
    }
    // 各列宽度含右侧 10px 间距, 拖动表头分隔线调整; 行与表头铺满, 滚动条悬浮其上不留暗边.
    in-out property <length> name-w: 214px;
    in-out property <length> size-w: 90px;
    in-out property <length> type-w: 60px;
    in-out property <length> time-w: 120px;
    in-out property <length> perm-w: 116px;
    in-out property <length> owner-w: 120px;
    property <length> size-x: 10px + root.name-w;
    property <length> type-x: root.size-x + root.size-w;
    property <length> time-x: root.type-x + root.type-w;
    property <length> perm-x: root.time-x + root.time-w;
    property <length> owner-x: root.perm-x + root.perm-w;
    property <length> row-w: max(table.visible-width, root.owner-x + root.owner-w + 8px);
    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    Rectangle {
        x: table.content-x; y: 0px; width: root.row-w; height: 28px;
        background: Theme.header;
        Text { x: 10px; width: root.name-w - 10px; height: 100%; text: "名称"; color: Theme.secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Text { x: root.size-x; width: root.size-w - 10px; height: 100%; text: "大小"; color: Theme.secondary; font-size: 11px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Text { x: root.type-x; width: root.type-w - 10px; height: 100%; text: "类型"; color: Theme.secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Text { x: root.time-x; width: root.time-w - 10px; height: 100%; text: root.time-label; color: Theme.secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Text { x: root.perm-x; width: root.perm-w - 10px; height: 100%; text: "权限"; color: Theme.secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Text { x: root.owner-x; width: root.owner-w - 10px; height: 100%; text: "用户 / 用户组"; color: Theme.secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        ColumnGrip { x: root.size-x - 4px; resized(c_delta) => { root.name-w = max(90px, root.name-w + c_delta); } }
        ColumnGrip { x: root.type-x - 4px; resized(c_delta) => { root.size-w = max(50px, root.size-w + c_delta); } }
        ColumnGrip { x: root.time-x - 4px; resized(c_delta) => { root.type-w = max(44px, root.type-w + c_delta); } }
        ColumnGrip { x: root.perm-x - 4px; resized(c_delta) => { root.time-w = max(80px, root.time-w + c_delta); } }
        ColumnGrip { x: root.owner-x - 4px; resized(c_delta) => { root.perm-w = max(60px, root.perm-w + c_delta); } }
        ColumnGrip { x: root.owner-x + root.owner-w - 4px; resized(c_delta) => { root.owner-w = max(60px, root.owner-w + c_delta); } }
    }
    // 位于列表下层: 行上的点击由行处理, 空白处的左键穿过列表 (Fluent 风格鼠标不拖动平移) 落到这里.
    TouchArea {
        y: 28px; width: parent.width; height: parent.height - 28px;
        // 触控区会吞掉右键, 外层菜单收不到, 需手动通知外层弹出.
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.blank-menu(self.x + self.mouse-x, self.y + self.mouse-y); }
        }
        clicked => {
            keys.focus();
            if root.selected-count > 0 { root.clear-selection(); }
        }
    }
    table := ListView {
        vertical-scrollbar-policy: always-off;
        y: 28px; width: parent.width; height: parent.height - 28px;
        content-width: root.row-w;
        init => { root.view-height = self.visible-height; }
        changed visible-height => { root.view-height = self.visible-height; }
        for file in root.rows: Rectangle {
            width: root.row-w; height: 26px;
            background: file.selected ? Theme.selected : row-touch.has-hover ? Theme.hover : transparent;
            FileIcon { x: 10px; y: 5px; index: file.icon; }
            Text { x: 34px; width: root.name-w - 34px; height: 100%; text: file.name; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; }
            Text { x: root.size-x; width: root.size-w - 10px; height: 100%; text: file.size-text; color: Theme.secondary; font-size: 11px; horizontal-alignment: right; overflow: elide; vertical-alignment: center; }
            Text { x: root.type-x; width: root.type-w - 10px; height: 100%; text: file.kind-text; color: Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Text { x: root.time-x; width: root.time-w - 10px; height: 100%; text: file.modified-text; color: Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Text { x: root.perm-x; width: root.perm-w - 10px; height: 100%; text: file.permissions; color: Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Text { x: root.owner-x; width: root.owner-w - 10px; height: 100%; text: file.owner; color: Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
            row-menu := ContextMenuArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                enabled: root.ready;
                Menu {
                    if file.directory: MenuItem { title: "打开目录"; activated => { root.activate(file); } }
                    MenuItem { title: "返回上级目录"; enabled: root.has-parent; activated => { root.file-action("parent", file); } }
                    MenuItem { title: "刷新"; activated => { root.file-action("refresh", file); } }
                    MenuSeparator {}
                    // "下载" 存入下载目录 (传输面板中可更改), "下载到…" 另选位置.
                    MenuItem { title: root.selected-count > 1 ? "下载所选" : "下载"; activated => { root.file-action("download", file); } }
                    MenuItem { title: root.selected-count > 1 ? "下载所选到…" : "下载到…"; activated => { root.file-action("download_to", file); } }
                    // 系统选择框不能同时选文件和文件夹 (Windows), 所以分两项, 收进同一个子菜单.
                    Menu {
                        title: file.directory ? "上传到此目录" : "上传到当前目录";
                        MenuItem { title: "文件…"; activated => { root.file-action("upload", file); } }
                        MenuItem { title: "文件夹…"; activated => { root.file-action("upload_folder", file); } }
                    }
                    Menu {
                        title: "新建";
                        MenuItem { title: "文件夹…"; activated => { root.file-action("create_directory", file); } }
                        MenuItem { title: "文件…"; activated => { root.file-action("create_file", file); } }
                    }
                    MenuSeparator {}
                    MenuItem { title: "重命名…"; enabled: root.selected-count == 1; activated => { root.file-action("rename", file); } }
                    MenuItem { title: "创建副本"; enabled: root.selected-count == 1; activated => { root.file-action("duplicate", file); } }
                    MenuItem { title: "修改权限…"; enabled: root.selected-count == 1 && file.kind-text != "链接"; activated => { root.file-action("permissions", file); } }
                    MenuItem { title: "复制路径"; activated => { root.file-action("copy_path", file); } }
                    MenuSeparator {}
                    MenuItem { title: root.selected-count > 1 ? "删除所选…" : "删除…"; activated => { root.file-action("delete", file); } }
                    MenuItem { title: root.selected-count > 1 ? "快速删除所选 (rm -rf)…" : "快速删除 (rm -rf)…"; activated => { root.file-action("fast_delete", file); } }
                }
                row-touch := TouchArea {
                    accessible-role: button; accessible-label: file.label;
                    accessible-action-default => { root.select(file, false, false, false); }
                    double-clicked => { root.activate(file); }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            keys.focus();
                            if event.button == PointerEventButton.left {
                                // Slint 在 macOS 上把 Command 报为 control, 物理 Ctrl 报为 meta; 两者都按多选处理, Windows 的 Ctrl 不受影响.
                                root.select(file, event.modifiers.control || event.modifiers.meta, event.modifiers.shift, false);
                            } else if event.button == PointerEventButton.right && root.ready {
                                root.select(file, false, false, true);
                                row-menu.show({x: self.mouse-x, y: self.mouse-y});
                            }
                        }
                    }
                }
            }
        }
    }
    SlimScrollBar {
        x: table.x + table.width - self.width; y: table.y; height: table.height;
        viewport-y <=> table.content-y; viewport-height: table.content-height; visible-height: table.visible-height;
    }
}

// 权限表的一行: 角色名 + 读/写/执行三列勾选, 列宽与表头一致.
// 权限表的一行: 角色与说明 + 读/写/执行三列勾选, 列位置与表头一致.
component PermissionRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in-out property <bool> read;
    in-out property <bool> write;
    in-out property <bool> execute;
    height: 34px;
    Text { x: 12px; width: 64px; height: 100%; text: root.label; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    Text { x: 76px; width: parent.width - 76px - 186px; height: 100%; text: root.detail; color: Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; }
    AppCheckBox { x: parent.width - 172px; y: (parent.height - self.height) / 2; width: 20px; height: 20px; checked <=> root.read; label: root.label + " 读取"; }
    AppCheckBox { x: parent.width - 112px; y: (parent.height - self.height) / 2; width: 20px; height: 20px; checked <=> root.write; label: root.label + " 写入"; }
    AppCheckBox { x: parent.width - 52px; y: (parent.height - self.height) / 2; width: 20px; height: 20px; checked <=> root.execute; label: root.label + " 执行"; }
}

// 侧栏统一卡片: 相同底色、边框与内边距, 各分区视觉一致.
component SideCard inherits Rectangle {
    vertical-stretch: 0;
    background: Theme.surface;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 10px; spacing: 8px;
        @children
    }
}

// 网络流量图: 下行蓝色填充、上行红色线条, 与标题中的 ↓↑ 颜色一致; 峰值标在图内左上角.
component NetChart inherits Rectangle {
    in property <string> rx-line;
    in property <string> rx-area;
    in property <string> tx-line;
    in property <string> tx-area;
    in property <string> peak;
    height: 64px;
    border-radius: 5px;
    background: Theme.plot;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    for step in [1, 2, 3]: Rectangle { y: step * parent.height / 4; height: 1px; background: Theme.grid; }
    Path { width: 100%; height: 100%; viewbox-width: 59; viewbox-height: 100; fit: fill; commands: root.rx-area; fill: Theme.cpu.with-alpha(0.16); }
    Path { width: 100%; height: 100%; viewbox-width: 59; viewbox-height: 100; fit: fill; commands: root.tx-area; fill: Theme.danger.with-alpha(0.08); }
    Path { width: 100%; height: 100%; viewbox-width: 59; viewbox-height: 100; fit: fill; commands: root.rx-line; stroke: Theme.cpu; stroke-width: 1.5px; }
    Path { width: 100%; height: 100%; viewbox-width: 59; viewbox-height: 100; fit: fill; commands: root.tx-line; stroke: Theme.danger; stroke-width: 1.2px; }
    // 峰值标签加底色, 曲线经过时不遮挡文字.
    if root.peak != "": Rectangle {
        x: 4px; y: 3px; width: peak-text.preferred-width + 8px; height: 14px; border-radius: 3px; background: Theme.plot.with-alpha(0.88);
        peak-text := Text { x: 4px; height: 100%; text: root.peak; color: Theme.muted; font-size: 9.5px; vertical-alignment: center; }
    }
}

export component AppWindow inherits Window {
    // 窗口标题带版本号, 版本由程序按 Cargo.toml 写入 app-version.
    title: root.app-version == "" ? "HiPShell" : "HiPShell " + root.app-version;
    icon: @image-url("../assets/hipshell-window-icon.png");
    // 下限按 1366×768、125% 缩放的屏幕留出标题栏和任务栏; 屏幕放不下默认尺寸时启动即最大化 (见 native_drop).
    preferred-width: 1240px; preferred-height: 830px;
    min-width: 800px; min-height: 540px;
    background: Theme.window;
    default-font-size: 13px;
    in property <[ConnectionRow]> connections;
    in property <[ConnectionRow]> recent-connections;
    in property <[ConnectionTreeRow]> connection-tree;
    // 连接管理中展开的分组, 随窗口布局保存, 下次启动恢复; 未列出的分组 (含新分组) 默认收起.
    in-out property <[string]> expanded-connection-groups;
    in-out property <string> selected-connection-group: "默认";
    in property <[string]> connection-groups;
    in-out property <int> edit-group-index;
    // 分组名称对话框的保存目标: command 命令分组 / connection 连接分组.
    in-out property <string> group-target: "command";
    in property <[SessionRow]> sessions;
    // 标签名前是否显示 [分组] (设置 → 界面).
    in-out property <bool> tab-show-group: true;
    callback tab-show-group-changed(bool);
    function tab-label(c_session: SessionRow) -> string {
        return root.tab-show-group && c_session.group != "" ? "[" + c_session.group + "] " + c_session.label : c_session.label;
    }
    in-out property <int> active-tab-index: -1;
    in property <[TerminalRun]> terminal-runs;
    in property <[FileRow]> files;
    in-out property <[DirectoryRow]> directory-tree;
    in-out property <string> tree-loading;
    in-out property <string> file-loading-path;
    in-out property <bool> goto-editing;
    in-out property <string> goto-path;
    in-out property <length> file-scroll-y;
    in-out property <length> file-view-height;
    in-out property <length> tree-scroll-y;
    // 目录树可视高度: 列表在条件块内, 根组件取不到, 由列表写入.
    in-out property <length> tree-view-height;
    in-out property <bool> remote-ready;
    in-out property <string> upload-target;
    in-out property <bool> permissions-editing;
    in-out property <string> permissions-path;
    in-out property <string> permissions-session;
    in-out property <string> permissions-owner;
    in-out property <string> permissions-group;
    in-out property <bool> owner-read;
    in-out property <bool> owner-write;
    in-out property <bool> owner-execute;
    in-out property <bool> group-read;
    in-out property <bool> group-write;
    in-out property <bool> group-execute;
    in-out property <bool> other-read;
    in-out property <bool> other-write;
    in-out property <bool> other-execute;
    in-out property <bool> rename-editing;
    in-out property <string> rename-path;
    in-out property <string> rename-session;
    in-out property <string> rename-name;
    in-out property <bool> create-editing;
    in-out property <bool> create-directory;
    in-out property <string> create-session;
    in-out property <string> create-parent;
    in-out property <string> create-name;
    in-out property <bool> delete-editing;
    // 快速删除走服务器 rm -rf, 可递归删除非空目录.
    in-out property <bool> delete-fast;
    in-out property <string> delete-session;
    in-out property <[string]> delete-paths;
    in-out property <bool> file-operation-busy;
    in-out property <string> file-operation-error;
    in-out property <int> selected-files-count;
    in-out property <string> selected-file-paths;
    in property <[QuickCommandRow]> quick-commands;
    in property <[QuickCommandRow]> visible-commands;
    in property <[string]> command-groups;
    in-out property <string> selected-command-group: "默认";
    in-out property <int> saved-command-group-index;
    in-out property <bool> group-editing;
    // 分组、命令、连接对话框的错误提示, 打开或关闭对话框时清空.
    in-out property <string> form-error;
    in-out property <string> group-old-name;
    in-out property <string> group-name;
    in property <[TaskRow]> tasks;
    in property <[PromptRow]> prompts;
    in-out property <string> selected-connection;
    in-out property <string> active-session;
    in-out property <int> view-generation;
    in-out property <int> file-request-generation;
    in-out property <bool> active-session-empty: true;
    // 当前标签状态 (同标签圆点): 0 未连接, 1 连接中, 2 已连接, 3 仅文件, 4 失败.
    in-out property <int> active-state;
    // 已连接但终端未打开 (仅文件): 终端不接收输入, 中间显示提示与"重新连接终端".
    property <bool> active-terminal-closed: root.active-state == 3;
    // 有连接目标但当前未连上 (断开或失败): 终端居中提示重新连接, 文件区居中提示.
    // 当前标签的连接 ID 与失败原因, 供断开遮罩显示原因和"编辑连接".
    in property <string> active-connection-id;
    in property <string> active-error;
    property <bool> active-offline: root.active-session != "" && !root.active-session-empty && (root.active-state == 0 || root.active-state == 4);
    // 文件区未就绪时的居中提示.
    property <string> file-hint: root.active-session == "" || root.active-session-empty ? "连接服务器后显示文件"
        : root.active-state == 1 ? "正在连接…" : root.active-offline ? "连接已断开" : "";
    // 目录读取失败的原因与所属 "会话\n路径": 只在该目录上、列表未就绪时显示在文件区, 换目录或重新读取即消失.
    in-out property <string> file-error;
    in-out property <string> file-error-key;
    property <bool> show-file-error: root.file-error != "" && !root.remote-ready && root.file-loading-path == "" && root.file-hint == ""
        && root.file-error-key == root.active-session + "\n" + root.browse-path;
    // 已连接 (含仅文件) 且不在读取中: 目录列表读取失败后仍可返回上级.
    property <bool> can-go-parent: (root.active-state == 2 || root.active-state == 3) && root.file-loading-path == "" && root.browse-path != "/";
    in-out property <string> status: "正在加载连接...";
    private property <bool> status-idle: false;
    private property <int> status-age;
    // 状态栏消息类别: 0 提示, 1 成功, 2 警告, 3 错误; 由程序按来源指定, 不再按文字猜测.
    in-out property <int> status-kind;
    // 可重试的失败附带操作名与参数, 状态栏显示“重试”.
    in-out property <string> status-retry;
    in-out property <string> status-retry-arg;
    private property <int> status-serial;
    in property <bool> active-connected;
    // 终端尺寸文字由程序写入; 直接绑定 terminal-cols 会与布局形成循环依赖.
    in property <string> terminal-size-text;
    in-out property <string> monitor-text: "尚未连接";
    in property <string> monitor-server-name;
    in property <string> monitor-server-host;
    in property <float> cpu-ratio;
    in property <float> memory-ratio;
    in property <float> swap-ratio;
    in property <float> cache-ratio;
    in property <string> cpu-usage;
    in property <string> memory-usage;
    in property <string> swap-usage;
    in property <string> cache-usage;
    in property <string> network-rx-line;
    in property <string> network-rx-area;
    in property <string> network-tx-line;
    in property <string> network-tx-area;
    in property <string> network-peak;
    in property <[ProcessRow]> processes;
    in-out property <int> process-sort;
    in property <[string]> network-interfaces;
    in-out property <int> network-interface-index;
    in-out property <string> network-interface-name;
    in property <string> network-download-rate: "—";
    in property <string> network-upload-rate: "—";
    in property <bool> mcp-running;
    in property <[McpActivityRow]> mcp-activity;
    in-out property <int> theme-index;
    in-out property <string> terminal-text;
    in-out property <string> task-output;
    in-out property <string> selected-task;
    in-out property <string> browse-path: ".";
    in-out property <string> command-text;
    in-out property <bool> managing;
    // 连接管理列宽 (逻辑像素): 拖动表头列之间的分隔线调整, 松开后保存; 名称列占剩余宽度.
    in-out property <int> conn-col-host: 130;
    in-out property <int> conn-col-port: 50;
    in-out property <int> conn-col-user: 80;
    in-out property <int> conn-col-auth: 48;
    in-out property <int> conn-col-proxy: 80;
    callback conn-columns-changed();
    in property <string> app-version;
    in-out property <bool> settings-open;
    in-out property <int> bottom-page;
    in-out property <string> selected-remote;
    in-out property <string> remote-listed-session;
    in-out property <string> file-time-label: "修改时间";
    in-out property <bool> command-editing;
    in-out property <string> saved-command-id;
    in-out property <string> saved-command-name;
    in-out property <string> saved-command-group;
    in-out property <string> saved-command-text;
    in-out property <[SelectionSpan]> selection-spans;
    in-out property <string> selected-terminal-text;
    in-out property <bool> selection-dragging;
    private property <int> selection-start-row;
    private property <int> selection-start-col;
    private property <int> selection-end-row;
    private property <int> selection-end-col;
    private property <bool> terminal-pasting;
    in-out property <bool> editing;
    // 代理: 单独管理, 连接管理中为每台服务器选择直连或某个代理.
    in property <[ProxyRow]> proxies;
    // 编辑连接的代理以 ID 保存, 下拉位置只用于显示; edit-proxy-ids 与 edit-proxy-choices 一一对应.
    in-out property <string> edit-proxy-id;
    in property <[string]> edit-proxy-ids: [""];
    in property <[string]> edit-proxy-choices: ["直连"];
    in-out property <int> edit-proxy-index;
    in-out property <bool> proxy-managing;
    in-out property <bool> proxy-editing;
    in-out property <string> proxy-edit-id;
    in-out property <string> proxy-edit-name;
    in-out property <int> proxy-edit-kind;
    in-out property <string> proxy-edit-host;
    in-out property <string> proxy-edit-port: "1080";
    in-out property <string> proxy-edit-user;
    in-out property <string> proxy-edit-password;
    in-out property <bool> proxy-edit-has-password;
    callback save-proxy();
    // 打开代理编辑框; id 为空的空白项即新建.
    function edit-proxy(c_proxy: ProxyRow) {
        root.proxy-edit-id = c_proxy.id; root.proxy-edit-name = c_proxy.name; root.proxy-edit-kind = c_proxy.kind == "http" ? 1 : 0;
        root.proxy-edit-host = c_proxy.id == "" ? "127.0.0.1" : c_proxy.host; root.proxy-edit-port = c_proxy.id == "" ? "1080" : c_proxy.port;
        root.proxy-edit-user = c_proxy.username; root.proxy-edit-password = ""; root.proxy-edit-has-password = c_proxy.has-password;
        root.form-error = ""; root.proxy-editing = true;
    }
    in-out property <string> edit-id;
    in-out property <string> edit-name;
    in-out property <string> edit-host;
    in-out property <string> edit-port: "22";
    in-out property <string> edit-user: "root";
    in-out property <string> edit-group;
    in-out property <int> edit-auth;
    in-out property <string> edit-key-path;
    in-out property <string> edit-password;
    // 管理员密码: 0 不设置, 1 同登录密码, 2 单独设置; edit-admin-saved 表示已保存过单独密码 (留空保持不变).
    in-out property <int> edit-admin;
    in-out property <bool> edit-admin-saved;
    in-out property <string> edit-admin-password;
    in-out property <bool> edit-mcp;
    in-out property <string> trust-session;
    in-out property <string> trust-fingerprint;
    in-out property <bool> trust-changed;
    in-out property <string> auth-session;
    in-out property <int> auth-generation;
    in property <int> cursor-row;
    in property <int> cursor-col;
    in property <bool> is-macos;
    in-out property <bool> native-modifiers-valid;
    // 翻转即整窗标记为需重绘 (Windows 最小化恢复后补画, 见 native_drop).
    in-out property <bool> repaint-flip;
    in-out property <bool> native-control;
    in-out property <bool> native-meta;
    in-out property <bool> native-alt;
    in-out property <bool> native-shift;
    in-out property <bool> bracketed-paste;
    in-out property <bool> application-cursor;
    in-out property <int> modified-keys;
    in-out property <bool> hide-cursor;
    // 0 方块, 1 下划线, 2 竖线 (vim 插入模式等).
    in-out property <int> cursor-shape;
    // 远端程序开启的鼠标上报: 0 未开启, 1 传统编码, 2 SGR 编码.
    in-out property <int> mouse-mode;
    private property <length> wheel-rest;
    in-out property <string> terminal-font: "Menlo";
    in property <int> terminal-display-cols;
    in property <int> terminal-display-rows;
    // 自动折行的行号, 选择复制时这些行与下一行之间不插入换行.
    in property <[int]> terminal-wrapped-rows;
    in property <int> terminal-history-lines;
    in property <int> terminal-view-offset;
    in-out property <int> terminal-scroll-offset;
    private property <int> terminal-view-first-row: max(0, root.terminal-history-lines - root.terminal-view-offset);
    in property <bool> alternate-screen;
    // 顶栏传输按钮: 进行中的上传/下载数, 各方向合计进度 (-1 为无进行中或大小未知), 各方向合计速度 (无进行中为空), 是否有失败.
    in property <int> transfer-uploads;
    in property <int> transfer-downloads;
    in property <float> transfer-up-progress: -1;
    in property <float> transfer-down-progress: -1;
    in property <string> transfer-up-speed;
    in property <string> transfer-down-speed;
    in-out property <bool> transfer-failed;
    // 传输面板: 未清除的上传下载任务; 用户发起传输时自动打开, 点按钮或面板外任意处收起.
    in-out property <[TaskRow]> transfers;
    in-out property <bool> transfers-open;
    // 下载目录: 未设置时为桌面, 传输面板与设置中更改后保存.
    in-out property <string> download-dir;
    // 界面内询问框 (同名询问与下载确认共用打开状态和回调): conflict-kind 0 为同名询问, 1 为下载确认.
    in-out property <bool> conflict-open;
    in property <int> conflict-kind;
    in property <string> conflict-names;
    // 下载确认: 本次下载项数, 目录取 download-dir.
    in property <int> conflict-count;
    // 同名询问: 0 取消, 1 覆盖, 2 保留两者, 3 跳过; 下载确认: 0 取消, 1 开始下载.
    callback conflict-decided(int);
    in property <string> peer-status;
    in-out property <bool> monitor-expanded: false;
    in-out property <bool> bottom-collapsed: true;
    // 拖动边缘调整的侧栏宽度与底部面板高度 (关闭窗口时连同窗口位置大小保存, 下次启动恢复).
    in-out property <length> monitor-width: 260px;
    in-out property <length> bottom-height: 232px;
    // 快速连接与代理列表的选中项 (单击选中, 双击执行).
    private property <string> quick-selected;
    private property <string> proxy-selected;
    in-out property <length> term-font-size: 13px;
    private property <bool> terminal-font-mono: max(font-probe-wide.preferred-width - font-probe-narrow.preferred-width, font-probe-narrow.preferred-width - font-probe-wide.preferred-width) < 2px;
    private property <bool> draft-font-mono: max(draft-probe-wide.preferred-width - draft-probe-narrow.preferred-width, draft-probe-narrow.preferred-width - draft-probe-wide.preferred-width) < 2px;
    out property <string> effective-terminal-font: root.terminal-font-mono ? root.terminal-font : root.default-terminal-font;
    // 设置中的字体草稿, 仅预览; 点击应用后才影响终端行列.
    private property <string> default-terminal-font: root.is-macos ? "Menlo" : "Consolas";
    // 本机已安装或已下载的候选等宽字体, 由程序检测后提供.
    in property <[string]> font-candidates;
    in property <[FontDownloadRow]> font-downloads;
    in-out property <string> font-draft;
    in-out property <int> font-draft-index: -1;
    private property <int> font-size-draft: 13;
    private property <[string]> settings-pages: ["外观", "通用", "MCP", "关于"];
    private property <int> settings-page: 0;
    // MCP 的 HTTP 配置; 端口不可用时 mcp-error 给出原因.
    in property <string> mcp-config;
    in property <string> mcp-prompt;
    in property <string> mcp-url;
    in property <string> mcp-error;
    // MCP 服务开关与端口: 当前生效值和设置页草稿, 应用后后台立即启停或换端口.
    in property <bool> mcp-enabled;
    in property <string> mcp-port;
    in-out property <string> mcp-port-draft;
    callback mcp-apply(bool, string);
    // 自检结果: 级别 0 正常 / 1 需注意 / 2 服务不可用, 一句结论和一句说明; 结论为空时不显示. mcp-checking 期间按钮不可点.
    in property <int> mcp-check-level;
    in property <string> mcp-check-title;
    in property <string> mcp-check-detail;
    in property <bool> mcp-checking;
    callback mcp-self-check();
    // 允许 MCP 使用的服务器, 每项为 "名称 · 用户@主机".
    in property <[string]> mcp-servers;
    // Slint会向上取整文本宽度, 用64个等宽字符摊平误差, 避免长行分段出现空隙.
    private property <length> cell-width: max(1px, cell-probe.preferred-width / 64);
    private property <length> cell-height: cell-probe.preferred-height + 3px;
    out property <int> terminal-cols: max(20, floor((terminal-scroll.visible-width - 24px) / root.cell-width));
    out property <int> terminal-rows: max(5, floor((terminal-scroll.visible-height - 30px) / root.cell-height));
    callback action(string, string);
    callback edit-connection(string);
    callback save-connection();
    callback terminal-input(string, bool);
    // 全屏程序或开启鼠标上报时把滚轮交给远端; 返回 false 表示仍由界面滚动历史.
    callback terminal-wheel(int, int, int) -> bool;
    callback terminal-key(string, bool, bool, bool, bool) -> bool;
    callback terminal-selection(int, int, int, int, bool);
    callback choose-path(string);
    callback auth-edit(int, string);
    callback save-command();
    callback edit-command(string);
    callback theme-changed(int);
    // 恢复默认布局: 面板在界面内复位, 窗口大小与保存的布局由程序处理.
    callback reset-layout();
    reset-layout => {
        root.monitor-expanded = false; root.monitor-width = 260px;
        root.bottom-collapsed = true; root.bottom-height = 232px; root.bottom-page = 0;
        root.reset-window();
    }
    callback reset-window();
    callback monitor-selection-changed();
    callback restore-terminal-view();
    callback terminal-font-changed(string, int);
    // 终端历史行数 (设置), 新连接生效.
    in-out property <int> terminal-history-limit: 2000;
    // 设置中的历史行数草稿, 点击应用后保存.
    callback terminal-history-changed(int);
    callback font-download(string);
    pure callback font-index(string) -> int;
    callback terminal-refresh();
    callback reveal-session-tab(int);
    private property <length> active-tab-x;
    private property <length> active-tab-w;
    pure callback accepts-files(data-transfer) -> bool;
    callback drop-files(data-transfer);
    callback native-drop-target(length, length) -> bool;
    callback file-selection(FileRow, bool, bool, bool);
    callback file-command(string, FileRow);

    native-drop-target(c_x, c_y) => {
        return root.remote-ready && !root.bottom-collapsed && root.bottom-page == 0
            && !root.managing && !root.settings-open && !root.editing && !root.command-editing && !root.group-editing
            && !root.permissions-editing && !root.rename-editing && !root.delete-editing && !root.create-editing && !root.conflict-open
            && root.trust-session == "" && root.auth-session == ""
            && c_x >= files-panel.absolute-position.x && c_x < files-panel.absolute-position.x + files-panel.width
            && c_y >= files-panel.absolute-position.y + 41px && c_y < files-panel.absolute-position.y + files-panel.height;
    }

    function apply-theme() {
        Theme.light = root.theme-index == 1;
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
    }
    init => { root.apply-theme(); }
    changed theme-index => { root.apply-theme(); }
    // 同一文字重复出现也要重新计时, 因此按序号而不是文字变化触发.
    changed status-serial => { root.status-age = 0; root.status-idle = root.status == "" || root.status == "就绪"; }
    public function notify(kind: int, text: string) {
        root.status-kind = kind;
        root.status = text;
        root.status-retry = "";
        root.status-serial += 1;
    }
    // 某项操作随后成功 (如读取目录失败后进入了其他目录): 收起它留下的可重试错误, 其他消息不受影响.
    public function dismiss-retry(action: string) {
        if root.status-retry == action { root.status-retry = ""; root.status-idle = true; }
    }

    // 逻辑长行可以横向滚动, 光标移动时只调整视口, 不改变PTY列数.
    function reveal-cursor() {
        if root.terminal-scroll-offset > 0 || root.selection-dragging || root.selected-terminal-text != "" || root.active-session == "" { return; }
        let z_x = 8px + max(0, root.cursor-col) * root.cell-width;
        let z_y = 8px + (root.terminal-history-lines + max(0, root.cursor-row)) * root.cell-height;
        if z_x + root.cell-width + terminal-scroll.content-x > terminal-scroll.visible-width - 16px {
            terminal-scroll.content-x = max(min(0px, terminal-scroll.visible-width - terminal-scroll.content-width), min(0px, terminal-scroll.visible-width - 16px - z_x - root.cell-width));
        } else if z_x + terminal-scroll.content-x < 8px {
            terminal-scroll.content-x = min(0px, 8px - z_x);
        }
        if z_y + root.cell-height + terminal-scroll.content-y > terminal-scroll.visible-height - 22px {
            terminal-scroll.content-y = max(min(0px, terminal-scroll.visible-height - terminal-scroll.content-height), min(0px, terminal-scroll.visible-height - 22px - z_y - root.cell-height));
        } else if z_y + terminal-scroll.content-y < 8px {
            terminal-scroll.content-y = min(0px, 8px - z_y);
        }
    }
    changed cursor-col => { root.reveal-cursor(); }
    changed cursor-row => { root.reveal-cursor(); }
    changed terminal-display-cols => { root.reveal-cursor(); }
    changed terminal-display-rows => { root.reveal-cursor(); }
    changed terminal-history-lines => { root.sync-terminal-scroll(); root.reveal-cursor(); }
    changed active-session => {
        // 在两个空标签之间切换时页面不重建, 同样清除.
        root.quick-selected = "";
        root.clear-terminal-selection(); terminal-scroll.content-x = 0px;
        // 各标签共用这个输入框: 切换前在拼写中的输入法内容必须结束, 否则之后确认的候选词会发到新标签的服务器.
        // 失焦时系统输入法随之关闭、组合被取消, 再清掉残留文字后重新聚焦.
        if terminal-input.has-focus {
            terminal-input.clear-focus();
            terminal-input.text = "";
            terminal-input.focus();
        }
    }
    changed terminal-scroll-offset => {
        // 滚动产生的变化与当前位置相差不到一行, 不强行对齐整行, 否则会和触控板平滑滚动来回拉扯;
        // 只有程序跳转 (返回底部、查看历史) 才对齐. 位置变化后立即请求新画面, 不等定时刷新.
        if abs(terminal-scroll.content-y - (min(0px, terminal-scroll.visible-height - terminal-scroll.content-height) + root.terminal-scroll-offset * root.cell-height)) > root.cell-height {
            root.sync-terminal-scroll();
        }
        root.terminal-refresh();
    }
    function sync-terminal-scroll() {
        terminal-scroll.content-y = min(0px, terminal-scroll.visible-height - terminal-scroll.content-height) + root.terminal-scroll-offset * root.cell-height;
    }
    restore-terminal-view => {
        root.sync-terminal-scroll(); root.reveal-cursor();
        if !root.active-session-empty && !root.conflict-open { terminal-input.focus(); }
    }
    reveal-session-tab(c_index) => {
        root.active-tab-index = c_index;
        if c_index < 0 { return; }
        // 标签宽度随名称变化, 位置取当前标签记下的实际坐标.
        // 两端留出渐隐的宽度, 滚到的标签不被渐隐遮住.
        let z_width = root.active-tab-w + 24px;
        let z_x = root.active-tab-x - 24px;
        if z_x + z_width + tab-strip.content-x > tab-strip.visible-width {
            tab-strip.content-x = max(min(0px, tab-strip.visible-width - tab-strip.content-width), tab-strip.visible-width - z_x - z_width);
        } else if z_x + tab-strip.content-x < 0px {
            tab-strip.content-x = min(0px, -z_x);
        }
    }

    // 拖动排序 (连接管理、命令分组、命令、标签): 按下记下源行, 移动超过 6px 才算拖动, 插入位置为行间序号 0..count;
    // 松开时交给 Rust 按列表数据计算新顺序并保存. 拖动后的那次单击不再触发选中或展开.
    in-out property <string> drag-list;
    in-out property <int> drag-from: -1;
    in-out property <int> drag-to: -1;
    in-out property <bool> drag-moved;
    // 标签拖动: 判定点 x 及浮动标签的位置宽度 (均为标签行坐标).
    private property <length> tab-drop-x;
    private property <length> tab-ghost-x;
    private property <length> tab-ghost-w;
    callback list-drop(string, int, int);
    function drag-press(c_list: string, c_index: int) {
        root.drag-list = c_list; root.drag-from = c_index; root.drag-to = -1; root.drag-moved = false;
    }
    function drag-move(c_list: string, c_index: int, c_count: int, c_mouse: length, c_offset: length, c_row: length) {
        if root.drag-list != c_list || root.drag-from != c_index { return; }
        if !root.drag-moved && abs(c_offset) < 6px { return; }
        root.drag-moved = true;
        root.drag-to = max(0, min(c_count, round(c_index + c_mouse / c_row)));
    }
    function drag-release(c_list: string) {
        if root.drag-list == c_list && root.drag-moved && root.drag-to >= 0 { root.list-drop(c_list, root.drag-from, root.drag-to); }
        root.drag-from = -1; root.drag-to = -1;
    }
    function clear-terminal-selection() {
        root.selected-terminal-text = "";
        root.selection-spans = [];
        root.selection-dragging = false;
    }
    function paste-terminal() {
        root.return-to-live-terminal();
        root.terminal-pasting = true;
        terminal-input.paste();
        root.terminal-pasting = false;
    }
    function return-to-live-terminal() {
        root.clear-terminal-selection();
        root.terminal-scroll-offset = 0;
        root.reveal-cursor();
        terminal-input.focus();
    }

    function select-remote(c_file: FileRow) {
        root.selected-remote = c_file.path;
    }
    // 对话框提交: 空输入给出提示而不是静默无反应 (输入法未上屏的文字不会计入输入框).
    function submit-create() {
        if root.file-operation-busy { return; }
        if root.create-name == "" { root.file-operation-error = "请输入名称; 使用输入法时请先确认候选词"; return; }
        root.action(root.create-directory ? "create_directory" : "create_file", "");
    }
    function submit-rename() {
        if root.file-operation-busy { return; }
        if root.rename-name == "" { root.file-operation-error = "请输入新名称"; return; }
        root.action("rename_file", root.rename-path);
    }
    function submit-group() {
        if root.group-name == "" { root.form-error = "请输入分组名称; 使用输入法时请先确认候选词"; return; }
        root.form-error = "";
        root.action(root.group-target == "connection" ? "save_connection_group" : "save_command_group", "");
    }
    changed group-editing => { root.form-error = ""; }
    changed command-editing => { root.form-error = ""; }
    changed editing => { root.form-error = ""; }
    function activate-remote(c_file: FileRow) {
        root.select-remote(c_file);
        // 路径由读取入口统一更新, 这里只发目标路径: 先改路径会让入口误判"同一目录", 跳过缓存和滚动复位.
        if c_file.directory { root.action("list_files", c_file.path); }
    }
    public function copy-text(c_text: string) {
        clipboard-helper.text = c_text;
        clipboard-helper.select-all();
        clipboard-helper.copy();
    }
    function choose-upload(c_directory: string, c_kind: string) {
        root.upload-target = c_directory;
        root.choose-path(c_kind);
    }
    function file-action(c_action: string, c_file: FileRow) {
        if c_action == "copy_path" { root.copy-text(root.selected-file-paths == "" ? c_file.path : root.selected-file-paths); return; }
        if !root.remote-ready { return; }
        if c_action == "parent" { root.action("remote_parent", ""); return; }
        root.file-selection(c_file, false, false, true);
        root.select-remote(c_file);
        if c_action == "upload" || c_action == "upload_folder" { root.choose-upload(c_file.directory ? c_file.path : root.browse-path, c_action); }
        if c_action == "download" || c_action == "download_to" { root.choose-path(c_action); }
        if c_action == "permissions" || c_action == "rename" { root.file-command(c_action, c_file); }
        if c_action == "delete" { root.action("prepare_delete", ""); }
        if c_action == "fast_delete" { root.action("prepare_delete", "fast"); }
        if c_action == "refresh" { root.action("list_files", root.browse-path); }
        if c_action == "duplicate" { root.action("duplicate_file", c_file.path); }
        if c_action == "create_directory" { root.action("prepare_create_directory", ""); }
        if c_action == "create_file" { root.action("prepare_create_file", ""); }
    }
    clipboard-helper := TextInput { visible: false; read-only: true; }
    // 铺满窗口的近乎透明层 (透明度 1/255, 肉眼不可见): 颜色变化使整窗进入重绘区域.
    Rectangle { x: 0; y: 0; width: 100%; height: 100%; background: root.repaint-flip ? #00000001 : #00000000; }

    VerticalBox {
        padding: 12px; spacing: 10px;
        HorizontalBox {
            height: 32px; spacing: 8px; padding: 0px;
            // 标签宽度保底 160px, 名称长时加宽 (见 SessionTab). 放不下时: 滚轮或触控板横向滚动标签, 切换标签自动滚到可见,
            // 两端渐隐提示还有标签; 新建按钮左侧出现"全部标签"下拉列表, 不显示滚动条, 也不再用左右翻页按钮.
            // 是否放得下按整个标签区宽度判断; 标签区不用布局而按坐标摆放, 宽度不随按钮出现变化, 避免宽度互相依赖.
            tab-area := Rectangle {
                horizontal-stretch: 1;
                // 末尾留 40px 给新建按钮: 放得下时紧跟最后一个标签, 放不下时固定在标签区右端, 不随标签缩小.
                property <length> usable: self.width - 40px;
                property <bool> overflowing: tab-row.preferred-width > self.usable;
                tab-strip := ScrollView {
                    x: 0px; y: 0px; height: 32px;
                    // 放不下时再让出下拉按钮 (34px) 与间距.
                    width: tab-area.usable - (tab-area.overflowing ? 40px : 0px);
                    vertical-scrollbar-policy: always-off;
                    horizontal-scrollbar-policy: always-off;
                    content-height: 32px;
                    content-width: max(self.visible-width, tab-row.preferred-width);
                    changed visible-width => { root.reveal-session-tab(root.active-tab-index); }
                    // 竖向滚轮也横向滚动标签; 触控板横向滑动交给滚动区自身处理.
                    TouchArea {
                        width: tab-strip.content-width; height: 32px;
                        scroll-event(event) => {
                            if abs(event.delta-y) <= abs(event.delta-x) { return reject; }
                            tab-strip.content-x = max(min(0px, tab-strip.visible-width - tab-strip.content-width), min(0px, tab-strip.content-x + event.delta-y));
                            return accept;
                        }
                        tab-row := HorizontalBox {
                            width: tab-strip.content-width; height: 32px; padding: 0px; spacing: 6px; alignment: start;
                            for session[i] in root.sessions: SessionTab {
                                // 标签宽度不一, 不能按固定宽度换算插入位置: 每个标签判断判定点 (浮动标签的前沿) 是否落在自己的范围,
                                // 左半 (含前方间距) 为插入到本标签前, 右半为插入到其后; 首尾两侧超出时归到首尾.
                                // 用前沿而非鼠标判定: 浮动标签盖过相邻标签一半即换位, 不必把鼠标拖到相邻标签中间.
                                property <int> drop-slot: root.drag-list != "tab" || !root.drag-moved || root.drag-from < 0 ? -1
                                    : root.tab-drop-x < self.x + self.width / 2 ? (i == 0 || root.tab-drop-x >= self.x - 6px ? i : -1)
                                    : (i == root.sessions.length - 1 || root.tab-drop-x < self.x + self.width ? i + 1 : -1);
                                changed drop-slot => { if self.drop-slot >= 0 { root.drag-to = self.drop-slot; } }
                                dragging: root.drag-list == "tab" && root.drag-moved && root.drag-from == i;
                                drop-mark: root.drag-list != "tab" || !root.drag-moved || root.drag-from < 0 || root.drag-to == root.drag-from || root.drag-to == root.drag-from + 1 ? 0
                                    : root.drag-to == i ? (i == 0 ? 3 : 1) : root.drag-to == i + 1 && i == root.sessions.length - 1 ? 2 : 0;
                                drag-press => { root.drag-press("tab", i); }
                                drag-move(c_offset) => {
                                    if root.drag-list != "tab" || root.drag-from != i { return; }
                                    if !root.drag-moved && abs(c_offset) < 6px { return; }
                                    root.drag-moved = true;
                                    // 浮动标签限制在标签行内; 向右拖取右沿, 向左拖取左沿作为判定点.
                                    root.tab-ghost-x = max(0px, min(tab-row.width - self.width, self.x + c_offset));
                                    root.tab-ghost-w = self.width;
                                    root.tab-drop-x = c_offset > 0 ? root.tab-ghost-x + self.width : root.tab-ghost-x;
                                }
                                drag-release => { root.drag-release("tab"); }
                                // 当前标签的位置与宽度记下来, 切换或宽度变化时滚动到可见.
                                changed active => { if self.active { root.active-tab-x = self.x; root.active-tab-w = self.width; root.reveal-session-tab(root.active-tab-index); } }
                                changed x => { if self.active { root.active-tab-x = self.x; } }
                                changed width => { if self.active { root.active-tab-w = self.width; } }
                                label: root.tab-label(session);
                                active: root.active-session == session.id;
                                has-connection: !session.empty;
                                connected: session.connected;
                                state: session.state;
                                focused => { root.action("focus_session", session.id); }
                                closed => { root.action("disconnect", session.id); }
                                tab-action(c_action) => { root.action(c_action, session.id); }
                                copy-name => { root.copy-text(session.name); }
                            }
                        }
                        // 拖动中跟随鼠标的浮动标签.
                        if root.drag-list == "tab" && root.drag-moved && root.drag-from >= 0 && root.drag-from < root.sessions.length: tab-ghost := Rectangle {
                            x: root.tab-ghost-x; y: 0px; width: root.tab-ghost-w; height: 32px; border-radius: 6px;
                            background: Theme.panel; border-width: 1px; border-color: Theme.accent;
                            drop-shadow-blur: 10px; drop-shadow-color: #00000055; drop-shadow-offset-y: 1px;
                            property <SessionRow> dragged: root.sessions[root.drag-from];
                            if !tab-ghost.dragged.empty: Rectangle {
                                x: 10px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px;
                                background: tab-ghost.dragged.state == 2 ? Theme.network : tab-ghost.dragged.state == 3 ? Theme.info : tab-ghost.dragged.state == 1 ? Theme.warning : tab-ghost.dragged.state == 4 ? Theme.danger : Theme.muted;
                            }
                            Text {
                                x: tab-ghost.dragged.empty ? 10px : 24px; width: parent.width - self.x - 10px; height: 100%;
                                text: root.tab-label(tab-ghost.dragged); color: Theme.text; font-size: 12.5px; overflow: elide; vertical-alignment: center;
                            }
                        }
                    }
                }
                // 两端渐隐: 左边或右边还有被遮住的标签时显示, 只作提示, 不拦截点击.
                if tab-area.overflowing && tab-strip.content-x < -0.5px: Rectangle {
                    x: 0px; width: 28px; height: 32px;
                    background: @linear-gradient(90deg, Theme.window 0%, Theme.window.with-alpha(0) 100%);
                }
                if tab-area.overflowing && tab-strip.content-x > tab-strip.visible-width - tab-strip.content-width + 0.5px: Rectangle {
                    x: tab-strip.width - self.width; width: 28px; height: 32px;
                    background: @linear-gradient(90deg, Theme.window.with-alpha(0) 0%, Theme.window 100%);
                }
                // 全部标签: 与新建按钮同尺寸, 列出所有标签点击切换.
                if tab-area.overflowing: Rectangle {
                    x: tab-area.usable - 34px; y: 1px; width: 34px; height: 30px;
                    AppButton { width: parent.width; height: parent.height; text: ""; chevron: 3; horizontal-padding: 0px; clicked => { tab-list-popup.show(); } }
                    tab-list-popup := PopupWindow {
                        x: parent.width - 280px; y: parent.height + 4px;
                        width: 280px; height: min(root.sessions.length * 31px + 8px, 400px);
                        close-policy: close-on-click-outside;
                        Rectangle {
                            background: Theme.dialog; border-radius: 6px; border-width: 1px; border-color: Theme.border;
                            drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 2px;
                            ScrollView {
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    padding: 4px; spacing: 1px;
                                    for session in root.sessions: Rectangle {
                                        height: 30px; border-radius: 4px;
                                        background: root.active-session == session.id ? Theme.selected : list-touch.has-hover ? Theme.hover : transparent;
                                        if !session.empty: Rectangle {
                                            x: 10px; y: 11px; width: 8px; height: 8px; border-radius: 4px;
                                            background: session.state == 2 ? Theme.network : session.state == 3 ? Theme.info : session.state == 1 ? Theme.warning : session.state == 4 ? Theme.danger : Theme.muted;
                                        }
                                        Text { x: 26px; width: parent.width - 36px; height: 100%; text: root.tab-label(session); color: root.active-session == session.id ? Theme.text : Theme.secondary; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                        list-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.action("focus_session", session.id); tab-list-popup.close(); }
                                            accessible-role: button; accessible-label: root.tab-label(session);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // 新建标签: 紧跟最后一个标签; 标签放不下时固定在标签区右端.
                AppButton {
                    x: tab-area.overflowing ? tab-area.width - 34px : root.sessions.length == 0 ? 0px : tab-row.preferred-width + 6px;
                    // 与顶栏其他按钮同高 (30px), 在 32px 的标签行中居中.
                    y: 1px; width: 34px; height: 30px;
                    text: "+"; font-size: 14px;
                    clicked => { root.action("new_tab", ""); }
                }
            }
            // 传输按钮常驻, 与设置按钮同尺寸同图标大小: 空闲时与设置图标同色; 上传中上箭头红、下载中下箭头蓝 (与任务页一致),
            // 右上角为进行中数量, 底边为各方向进度, 有失败时显示红点.
            transfer-button := Rectangle {
                property <int> active: root.transfer-uploads + root.transfer-downloads;
                // 面板打开时: 去掉边框, 底色加深一档 (按下态), 像工具栏里被按住的开关.
                width: 40px; height: 30px; border-radius: 6px; border-width: 1px;
                border-color: root.transfers-open ? Theme.button-pressed : Theme.border;
                background: root.transfers-open || transfer-touch.pressed ? Theme.button-pressed : transfer-touch.has-hover ? Theme.button-hover : Theme.button;
                animate background, border-color { duration: 110ms; }
                // 上传、下载进度条同时显示时占两条, 图标上移 2px 免得箭头尖碰到进度条.
                property <bool> two-bars: root.transfer-up-progress >= 0 && root.transfer-down-progress >= 0;
                TransferIcon {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 - (transfer-button.two-bars ? 2px : 0px);
                    // 进行中的方向着色; 另一支面板打开时为默认色, 收起时变灰. 无传输时面板打开两支都着色.
                    up-color: root.transfer-uploads > 0 ? Theme.danger : transfer-button.active > 0 ? (root.transfers-open ? Theme.text : Theme.muted) : root.transfers-open ? Theme.danger : Theme.text;
                    down-color: root.transfer-downloads > 0 ? Theme.cpu : transfer-button.active > 0 ? (root.transfers-open ? Theme.text : Theme.muted) : root.transfers-open ? Theme.cpu : Theme.text;
                }
                // 底边进度条按方向分开: 上传红在上、下载蓝在下, 只有一种时只显示一条 (在最底).
                if root.transfer-up-progress >= 0: Rectangle {
                    x: 6px; y: parent.height - (transfer-button.two-bars ? 8px : 5px); width: parent.width - 12px; height: 2px; border-radius: 1px; background: Theme.border;
                    Rectangle { x: 0px; width: parent.width * root.transfer-up-progress; height: 100%; border-radius: 1px; background: Theme.danger; animate width { duration: 300ms; } }
                }
                if root.transfer-down-progress >= 0: Rectangle {
                    x: 6px; y: parent.height - 5px; width: parent.width - 12px; height: 2px; border-radius: 1px; background: Theme.border;
                    Rectangle { x: 0px; width: parent.width * root.transfer-down-progress; height: 100%; border-radius: 1px; background: Theme.cpu; animate width { duration: 300ms; } }
                }
                if transfer-button.active > 0: Rectangle {
                    x: parent.width - self.width + 5px; y: -5px; height: 15px; width: max(15px, badge-text.preferred-width + 8px); border-radius: 7.5px;
                    background: Theme.accent; border-width: 1.5px; border-color: Theme.window;
                    badge-text := Text { text: transfer-button.active; color: Theme.accent-text; font-size: 9.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                if transfer-button.active == 0 && root.transfer-failed: Rectangle {
                    x: parent.width - 6px; y: -2px; width: 8px; height: 8px; border-radius: 4px; background: Theme.danger; border-width: 1.5px; border-color: Theme.window;
                }
                transfer-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.transfers-open = !root.transfers-open; }
                    accessible-role: button; accessible-label: "传输";
                    accessible-action-default => { self.clicked(); }
                }
            }
            AppButton { text: "连接管理"; font-size: 12px; horizontal-padding: 10px; clicked => { root.managing = true; } }
            VerticalLayout { alignment: center; Rectangle { width: 1px; height: 18px; background: Theme.border; } }
            // 与下方监控收起栏同宽 (40px), 右边缘与监控面板对齐.
            AppButton { text: "设置"; icon: 13; width: 40px; clicked => { root.settings-open = true; } }
        }
        HorizontalBox {
            spacing: 10px; padding: 0px; vertical-stretch: 1;
            VerticalBox {
                horizontal-stretch: 1; spacing: 10px; padding: 0px;
                terminal := Rectangle {
                    background: Theme.terminal; border-radius: 8px; border-width: 1px; border-color: Theme.border; clip: true; vertical-stretch: 1;
                    // 宽窄字符宽度不同说明字体未安装 (回退到比例字体) 或不是等宽字体, 此时终端改用平台默认等宽字体,
                    // 否则文字按比例宽度排布而光标按格子定位, 两者会错开.
                    font-probe-wide := Text { text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"; font-family: root.terminal-font; font-size: root.term-font-size; wrap: no-wrap; visible: false; }
                    font-probe-narrow := Text { text: "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii"; font-family: root.terminal-font; font-size: root.term-font-size; wrap: no-wrap; visible: false; }
                    draft-probe-wide := Text { text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"; font-family: root.font-draft == "" ? root.default-terminal-font : root.font-draft; font-size: 13px; wrap: no-wrap; visible: false; }
                    draft-probe-narrow := Text { text: "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii"; font-family: root.font-draft == "" ? root.default-terminal-font : root.font-draft; font-size: 13px; wrap: no-wrap; visible: false; }
                    cell-probe := Text { text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"; font-family: root.effective-terminal-font; font-size: root.term-font-size; wrap: no-wrap; visible: false; }
                    terminal-scroll := ScrollView {
                        width: parent.width;
                        // 终端列数按可视宽度计算, 内容正好放得下, 平时没有横向滚动; 仅在窗口缩小、远端尚未调整尺寸时才出现.
                        vertical-scrollbar-policy: always-on;
                        content-width: max(self.visible-width, max(0, root.terminal-display-cols) * root.cell-width + 16px);
                        content-height: max(self.visible-height, (root.terminal-history-lines + max(root.terminal-rows, root.terminal-display-rows)) * root.cell-height + 30px);
                        scrolled => {
                            root.clear-terminal-selection();
                            let z_bottom = min(0px, self.visible-height - self.content-height);
                            root.terminal-scroll-offset = min(root.terminal-history-lines, max(0, round((self.content-y - z_bottom) / root.cell-height)));
                        }
                        changed content-y => {
                            let z_bottom = min(0px, self.visible-height - self.content-height);
                            let z_offset = min(root.terminal-history-lines, max(0, round((self.content-y - z_bottom) / root.cell-height)));
                            if z_offset != root.terminal-scroll-offset {
                                root.clear-terminal-selection();
                                root.terminal-scroll-offset = z_offset;
                            }
                        }
                        Rectangle {
                            width: terminal-scroll.content-width; height: terminal-scroll.content-height;
                            for run in root.terminal-runs: Rectangle {
                                // run.row 从历史顶端算起, 与内容区顶端一致.
                                x: 8px + run.col * root.cell-width; y: 8px + run.row * root.cell-height;
                                width: max(1, run.cells) * root.cell-width; height: root.cell-height;
                                property <color> foreground: run.fg-default ? (run.inverse ? Theme.terminal : Theme.terminal-text) : run.fg;
                                background: run.bg-default ? (run.inverse ? Theme.terminal-text : Theme.terminal) : run.bg;
                                Text { visible: run.block == 0; x: 0px; y: 0px; width: parent.width; height: parent.height; text: run.text; color: run.dim ? parent.foreground.with-alpha(0.55) : parent.foreground; font-family: root.effective-terminal-font; font-size: root.term-font-size; font-weight: run.bold ? 700 : 400; font-italic: run.italic; vertical-alignment: center; }
                                // 方块字形铺满终端格子, 避免字体行距把像素图案切断.
                                if run.block != 0: Rectangle {
                                    property <color> block-color: parent.foreground;
                                    for quadrant[i] in [1, 2, 4, 8]: Rectangle {
                                        visible: mod(floor(run.block / quadrant), 2) == 1;
                                        x: mod(i, 2) * parent.width / 2; y: floor(i / 2) * parent.height / 2;
                                        width: parent.width / 2; height: parent.height / 2;
                                        background: parent.block-color;
                                    }
                                }
                                if run.underline: Rectangle { y: parent.height - 2px; height: 1px; background: parent.foreground; }
                            }
                            if root.active-session != "" && root.terminal-scroll-offset == 0 && root.terminal-view-offset == 0 && !root.hide-cursor: Rectangle {
                                x: 8px + root.cursor-col * root.cell-width;
                                y: 8px + (root.terminal-view-first-row + root.cursor-row) * root.cell-height + (root.cursor-shape == 1 ? root.cell-height - 2px : 0px);
                                width: root.cursor-shape == 2 ? 2px : root.cell-width; height: root.cursor-shape == 1 ? 2px : root.cell-height;
                                background: root.cursor-shape == 0 ? Theme.cursor : Theme.cursor-border;
                                border-width: root.cursor-shape == 0 ? 1px : 0px; border-color: Theme.cursor-border;
                            }
                            for span in root.selection-spans: Rectangle {
                                x: 8px + span.col * root.cell-width; y: 8px + (root.terminal-view-first-row + span.row) * root.cell-height;
                                width: span.cells * root.cell-width; height: root.cell-height;
                                background: Theme.accent.with-alpha(Theme.light ? 0.25 : 0.33);
                            }
                            selection-touch := TouchArea {
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                mouse-cursor: text;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.cancel {
                                        root.selection-dragging = false;
                                    } else if event.button == PointerEventButton.left {
                                        if event.kind == PointerEventKind.down {
                                            root.clear-terminal-selection();
                                            root.selection-start-row = max(0, floor((self.mouse-y - 8px) / root.cell-height) - root.terminal-view-first-row);
                                            root.selection-start-col = max(0, floor((self.mouse-x - 8px) / root.cell-width));
                                            root.selection-end-row = root.selection-start-row;
                                            root.selection-end-col = root.selection-start-col;
                                            root.selection-dragging = true;
                                            terminal-input.focus();
                                        } else if event.kind == PointerEventKind.up {
                                            root.selection-dragging = false;
                                        }
                                    }
                                }
                                moved => {
                                    if self.pressed && root.selection-dragging {
                                        let z_row = max(0, floor((self.mouse-y - 8px) / root.cell-height) - root.terminal-view-first-row);
                                        let z_col = max(0, floor((self.mouse-x - 8px) / root.cell-width));
                                        if z_row != root.selection-end-row || z_col != root.selection-end-col {
                                            root.selection-end-row = z_row;
                                            root.selection-end-col = z_col;
                                            root.terminal-selection(root.selection-start-row, root.selection-start-col, z_row, z_col, false);
                                        }
                                    }
                                }
                                scroll-event(event) => {
                                    if root.active-session == "" || root.active-session-empty || (root.mouse-mode == 0 && !root.alternate-screen) { return reject; }
                                    // 触控板的细小增量累计满一行才发送; 正值为向上滚.
                                    root.wheel-rest += event.delta-y;
                                    let z_lines = root.wheel-rest > 0 ? floor(root.wheel-rest / root.cell-height) : -floor(-root.wheel-rest / root.cell-height);
                                    root.wheel-rest -= z_lines * root.cell-height;
                                    if z_lines == 0 { return accept; }
                                    let z_row = max(0, floor((self.mouse-y - 8px) / root.cell-height) - root.terminal-view-first-row);
                                    let z_col = max(0, floor((self.mouse-x - 8px) / root.cell-width));
                                    return root.terminal-wheel(z_lines, z_row, z_col) ? accept : reject;
                                }
                                double-clicked => {
                                    root.selection-dragging = false;
                                    root.terminal-selection(root.selection-start-row, root.selection-start-col, root.selection-start-row, root.selection-start-col, true);
                                }
                            }
                        }
                    }
                    // 输入项固定在视口内, 长输出和横向滚动不会让焦点落到屏幕之外.
                    terminal-input := TextInput {
                        x: min(max(8px, 8px + max(0, root.cursor-col) * root.cell-width + terminal-scroll.content-x), max(8px, parent.width - 296px));
                        y: min(max(4px, 8px + (root.terminal-history-lines + max(0, root.cursor-row)) * root.cell-height + terminal-scroll.content-y), max(4px, parent.height - root.cell-height - 24px));
                        width: min(280px, max(root.cell-width * 2, parent.width - self.x - 24px)); height: root.cell-height;
                        color: Theme.terminal-text; font-family: root.effective-terminal-font; font-size: root.term-font-size;
                        accessible-label: "终端输入";
                        text-cursor-width: 0px;
                        vertical-alignment: center; single-line: false; wrap: no-wrap;
                        enabled: root.active-session != "" && !root.active-session-empty && !root.active-terminal-closed && !root.conflict-open;
                        edited => { if self.text != "" { let z_data = self.text; self.text = ""; root.return-to-live-terminal(); root.terminal-input(z_data, root.terminal-pasting); } }
                        changed text => { if self.text != "" { let z_data = self.text; self.text = ""; root.return-to-live-terminal(); root.terminal-input(z_data, root.terminal-pasting); } }
                        key-pressed(event) => {
                            // 单独按下组合键的修饰键时保留选区, 否则 Command+C 会先清掉所选文字.
                            if event.text == Key.Control || event.text == Key.ControlR || event.text == Key.Meta || event.text == Key.MetaR || event.text == Key.Shift || event.text == Key.ShiftR || event.text == Key.Alt || event.text == Key.AltGr {
                                return accept;
                            }
                            // macOS 的 Command 在 Slint 中对应 control; Ctrl+C 仍可打断远端命令.
                            // 原生修饰键状态只在 macOS 使用 (修饰键事件可能没有对应按键事件); Windows 用 Slint 处理过的状态,
                            // 其中 AltGr 产生字符 (如德语 AltGr+Q 输入 @) 时已清除 Ctrl+Alt, 不会被当成 Ctrl 快捷键.
                            let z_native = root.native-modifiers-valid && root.is-macos;
                            let z_control = z_native ? root.native-control : event.modifiers.control;
                            let z_meta = z_native ? root.native-meta : event.modifiers.meta;
                            let z_alt = z_native ? root.native-alt : event.modifiers.alt;
                            let z_shift = z_native ? root.native-shift : event.modifiers.shift;
                            let z_clipboard = z_control && (root.is-macos || z_shift);
                            if (event.text == "c" || event.text == "C") && (z_clipboard || (!root.is-macos && z_control && root.selected-terminal-text != "")) {
                                if root.selected-terminal-text != "" { root.copy-text(root.selected-terminal-text); }
                                return accept;
                            }
                            if (event.text == "v" || event.text == "V") && (z_clipboard || (!root.is-macos && z_control)) {
                                root.paste-terminal(); return accept;
                            }
                            if z_control && z_shift && (event.text == "p" || event.text == "P") {
                                root.return-to-live-terminal(); root.action("input_admin_password", ""); return accept;
                            }
                            if z_clipboard && (event.text == "a" || event.text == "A") {
                                root.terminal-selection(0, 0, root.terminal-display-rows, root.terminal-display-cols, false); return accept;
                            }
                            root.return-to-live-terminal();
                            // 待提交文字先入队, 避免 Return 超过 IME 提交或粘贴内容.
                            if self.text != "" { let z_data = self.text; self.text = ""; root.terminal-input(z_data, false); }
                            if root.terminal-key(event.text, z_control, z_alt, z_shift, z_meta) { return accept; }
                            return reject;
                        }
                        accepted => { root.action("terminal_enter", ""); }
                    }
                    terminal-menu := ContextMenuArea {
                        x: 0px; y: 0px; width: terminal-scroll.visible-width; height: terminal-scroll.visible-height;
                        Menu {
                            MenuItem { title: "粘贴"; enabled: root.active-session != "" && !root.active-session-empty && !root.active-terminal-closed; activated => { root.paste-terminal(); } }
                            // 输入连接设置的管理员密码并回车; 密码由后台填写, 回显关闭时屏幕上不显示.
                            MenuItem { title: root.is-macos ? "输入管理员密码 (⇧⌘P)" : "输入管理员密码 (Ctrl+Shift+P)"; enabled: root.active-session != "" && !root.active-session-empty && !root.active-terminal-closed; activated => { root.return-to-live-terminal(); root.action("input_admin_password", ""); } }
                            MenuSeparator {}
                            MenuItem { title: "复制所选"; enabled: root.selected-terminal-text != ""; activated => { root.copy-text(root.selected-terminal-text); } }
                            MenuItem { title: "复制当前屏幕"; enabled: root.terminal-text != ""; activated => { root.terminal-selection(0, 0, root.terminal-display-rows, root.terminal-display-cols, false); root.copy-text(root.selected-terminal-text); root.clear-terminal-selection(); } }
                            if root.active-terminal-closed: MenuItem { title: "重新连接终端"; activated => { root.action("open_terminal", root.active-session); } }
                            MenuSeparator {}
                            MenuItem { title: "清屏"; enabled: root.active-session != "" && !root.active-session-empty && !root.active-terminal-closed; activated => { root.return-to-live-terminal(); root.action("terminal_clear", ""); } }
                            MenuItem { title: "发送 Ctrl+C"; enabled: root.active-session != "" && !root.active-session-empty && !root.active-terminal-closed; activated => { root.return-to-live-terminal(); root.action("terminal_interrupt", ""); } }
                        }
                    }
                    // 终端未打开或连接已断开: 遮住旧画面, 居中提示并给出对应的重连按钮.
                    if root.active-terminal-closed || root.active-offline: Rectangle {
                        background: Theme.terminal; border-radius: 8px;
                        VerticalLayout {
                            alignment: center; spacing: 12px;
                            Text { text: root.active-offline ? (root.active-state == 4 ? "连接失败" : "连接已断开") : "终端未打开, 文件传输可正常使用"; color: Theme.secondary; font-size: 13px; horizontal-alignment: center; }
                            // 失败原因直接显示在这里 (如未选择私钥、认证失败), 不必去状态栏找.
                            if root.active-offline && root.active-error != "": Text {
                                text: root.active-error; color: Theme.danger; font-size: 12px; horizontal-alignment: center; wrap: word-wrap;
                                width: min(parent.width - 48px, 520px); x: (parent.width - self.width) / 2;
                            }
                            HorizontalLayout {
                                alignment: center; spacing: 10px;
                                AppButton {
                                    text: root.active-offline ? "重新连接" : "重新连接终端"; primary: true;
                                    clicked => { root.action(root.active-offline ? "reconnect" : "open_terminal", root.active-session); }
                                }
                                if root.active-offline && root.active-connection-id != "": AppButton {
                                    text: "编辑连接";
                                    clicked => { root.edit-connection(root.active-connection-id); }
                                }
                            }
                        }
                    }
                    // 空标签: 居中卡片, 最近连接置顶, 标题栏进入连接管理.
                    if root.active-session == "" || root.active-session-empty: Rectangle {
                        background: Theme.terminal; border-radius: 8px;
                        // 选中只在本次显示内有效: 双击连接时单击也会触发, 选中属性在根组件上, 不清除会留到下次空标签.
                        init => { root.quick-selected = ""; }
                        // 点击行以外的任何位置取消选中.
                        TouchArea { clicked => { root.quick-selected = ""; } }
                        quick-card := Rectangle {
                            width: min(parent.width - 48px, 560px);
                            height: min(parent.height - 48px, 80px + max(1, min(6, root.recent-connections.length)) * 60px);
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                            drop-shadow-blur: 18px; drop-shadow-color: #00000030; drop-shadow-offset-y: 4px;
                            // 单击选中后获得键盘焦点, Delete 或 Backspace (macOS 的 delete 键) 从快速连接移除所选, 不删除连接配置.
                            quick-keys := FocusScope {
                                key-pressed(event) => {
                                    if root.quick-selected != "" && (event.text == Key.Delete || event.text == Key.Backspace) {
                                        root.action("remove_recent_connection", root.quick-selected);
                                        root.quick-selected = "";
                                        return accept;
                                    }
                                    return reject;
                                }
                                VerticalLayout {
                                    padding: 20px; spacing: 12px;
                                    HorizontalLayout {
                                        height: 28px; spacing: 8px;
                                        Text { text: "快速连接"; color: Theme.text; font-size: 22px; font-weight: 700; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        AppButton { height: 28px; font-size: 12px; text: "清空记录"; enabled: root.recent-connections.length > 0; clicked => { root.action("clear_recent_connections", ""); } }
                                        AppButton { height: 28px; font-size: 12px; text: "连接管理"; primary: true; clicked => { root.managing = true; } }
                                    }
                                    Rectangle {
                                        vertical-stretch: 1;
                                        if root.recent-connections.length == 0: Text {
                                            text: "在连接管理中新建或导入服务器"; color: Theme.muted; font-size: 12px;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                        quick-list := ListView {
                                            vertical-scrollbar-policy: always-off;
                                            visible: root.recent-connections.length > 0;
                                            horizontal-scrollbar-policy: always-off;
                                            for connection in root.recent-connections: Rectangle {
                                                width: quick-list.visible-width; height: 60px;
                                                Rectangle {
                                                    x: 0px; y: 4px; width: parent.width - (quick-list.content-height > quick-list.visible-height ? 12px : 0px); height: parent.height - 8px;
                                                    border-radius: 7px; border-width: 1px;
                                                    border-color: root.quick-selected == connection.id || quick-touch.has-hover ? Theme.accent.with-alpha(0.6) : Theme.border;
                                                    background: root.quick-selected == connection.id ? Theme.selected : quick-touch.has-hover ? Theme.hover : Theme.surface;
                                                    animate background, border-color { duration: 110ms; }
                                                    Rectangle {
                                                        x: 12px; y: (parent.height - 30px) / 2; width: 30px; height: 30px; border-radius: 6px;
                                                        background: Theme.accent.with-alpha(0.14);
                                                        Icon { index: 12; x: 7px; y: 7px; colorize: Theme.accent; }
                                                    }
                                                    Text { x: 54px; y: 8px; width: parent.width - 200px; height: 18px; text: connection.label; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                                                    Text { x: 54px; y: 27px; width: parent.width - 200px; height: 16px; text: connection.username + "@" + connection.host + ":" + connection.port; color: Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                                    Chevron { x: parent.width - 26px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; direction: 1; color: quick-touch.has-hover ? Theme.accent : Theme.muted; }
                                                    quick-menu := ContextMenuArea {
                                                        Menu {
                                                            MenuItem { title: "连接"; activated => { root.action("connect", connection.id); } }
                                                            MenuItem { title: "连接 (仅文件)"; activated => { root.action("connect_files", connection.id); } }
                                                            MenuItem { title: "编辑…"; activated => { root.selected-connection = connection.id; root.edit-connection(connection.id); } }
                                                            MenuItem { title: "复制主机地址"; activated => { root.copy-text(connection.host); } }
                                                            MenuItem { title: "从快速连接移除"; activated => { root.action("remove_recent_connection", connection.id); } }
                                                            Menu {
                                                                title: "代理";
                                                                MenuItem { title: "直连"; icon: connection.proxy-id == "" ? @image-url("check.svg") : @image-url(""); activated => { root.action("proxy_connection", connection.id + "\n"); } }
                                                                for proxy in root.proxies: MenuItem { title: proxy.name; icon: connection.proxy-id == proxy.id ? @image-url("check.svg") : @image-url(""); activated => { root.action("proxy_connection", connection.id + "\n" + proxy.id); } }
                                                                MenuSeparator {}
                                                                MenuItem { title: "代理管理…"; activated => { root.proxy-managing = true; } }
                                                            }
                                                        }
                                                        quick-touch := TouchArea {
                                                            // 子触控区会先收到右键并吞掉, 需手动弹出外层菜单.
                                                            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { quick-menu.show({x: self.mouse-x, y: self.mouse-y}); } }
                                                            mouse-cursor: pointer;
                                                            clicked => { root.quick-selected = connection.id; quick-keys.focus(); }
                                                            double-clicked => { root.action("connect", connection.id); }
                                                            accessible-role: button; accessible-label: "快速连接 " + connection.label;
                                                            accessible-action-default => { self.double-clicked(); }
                                                        }
                                                    }
                                                    // 代理快速切换: 显示当前走直连还是哪个代理, 点击直接选择, 下次连接生效. 宽度随内容, 平时无边框.
                                                    Rectangle {
                                                        width: min(100px, proxy-row.preferred-width); height: 22px; border-radius: 5px;
                                                        x: parent.width - 36px - self.width; y: (parent.height - self.height) / 2;
                                                        background: proxy-badge.has-hover ? Theme.hover : transparent;
                                                        proxy-row := HorizontalLayout {
                                                            padding-left: 7px; padding-right: 6px; spacing: 4px;
                                                            proxy-text := Text {
                                                                text: connection.proxy;
                                                                color: connection.proxy-id == "" ? Theme.muted : Theme.accent; font-size: 11px;
                                                                overflow: elide; vertical-alignment: center;
                                                            }
                                                            VerticalLayout { alignment: center; Chevron { width: 8px; height: 8px; direction: 3; color: proxy-text.color; } }
                                                        }
                                                        proxy-badge := TouchArea {
                                                            mouse-cursor: pointer; clicked => { proxy-pick.show({x: 0px, y: 26px}); }
                                                            accessible-role: button; accessible-label: "代理 " + connection.proxy;
                                                        }
                                                        proxy-pick := ContextMenuArea {
                                                            width: 0px; height: 0px;
                                                            Menu {
                                                                MenuItem { title: "直连"; icon: connection.proxy-id == "" ? @image-url("check.svg") : @image-url(""); activated => { root.action("proxy_connection", connection.id + "\n"); } }
                                                                for proxy in root.proxies: MenuItem { title: proxy.name; icon: connection.proxy-id == proxy.id ? @image-url("check.svg") : @image-url(""); activated => { root.action("proxy_connection", connection.id + "\n" + proxy.id); } }
                                                                MenuSeparator {}
                                                                MenuItem { title: "代理管理…"; activated => { root.proxy-managing = true; } }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        SlimScrollBar {
                                            x: quick-list.x + quick-list.width - self.width; y: quick-list.y; height: quick-list.height;
                                            viewport-y <=> quick-list.content-y; viewport-height: quick-list.content-height; visible-height: quick-list.visible-height;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                files-panel := Rectangle {
                    height: root.bottom-collapsed ? 41px : root.bottom-height; background: Theme.panel; border-radius: 8px; border-width: 1px; border-color: Theme.border; clip: true;
                    VerticalBox {
                        padding: 0px; spacing: 0px;
                        Rectangle {
                            height: 40px;
                            // 收起时整条标题栏都可点击展开 (同右侧收起的监控栏), 不必瞄准小按钮.
                            background: root.bottom-collapsed && header-touch.has-hover ? Theme.hover : transparent;
                            header-touch := TouchArea {
                                enabled: root.bottom-collapsed;
                                mouse-cursor: root.bottom-collapsed ? pointer : default;
                                clicked => { root.bottom-collapsed = false; }
                            }
                            HorizontalBox {
                                padding-left: 8px; padding-right: 8px; padding-top: 0px; padding-bottom: 0px; spacing: 2px;
                                PageTab { text: "文件"; active: root.bottom-page == 0; clicked => { root.bottom-page = 0; root.bottom-collapsed = false; } }
                                PageTab { text: "命令"; active: root.bottom-page == 1; clicked => { root.bottom-page = 1; root.bottom-collapsed = false; } }
                                PageTab { text: "任务"; active: root.bottom-page == 2; clicked => { root.bottom-page = 2; root.bottom-collapsed = false; } }
                                // 文件页在标签后显示当前路径: 收起时只显示路径 (整条点击展开); 展开时路径后跟上一级、刷新两个小按钮.
                                // 标签保持原宽, 路径占用剩余空间, 过长时末尾省略.
                                HorizontalLayout {
                                    horizontal-stretch: 1; padding-left: 12px; padding-right: 10px; spacing: 2px;
                                    // 不显示路径时由它占住剩余空间, 否则空布局宽度为 0, 多出的宽度会分给标签把标签拉宽.
                                    if !(root.bottom-page == 0 && root.active-session != "" && !root.active-session-empty && root.browse-path != ""): Rectangle { horizontal-stretch: 1; }
                                    if root.bottom-page == 0 && root.active-session != "" && !root.active-session-empty && root.browse-path != "": HorizontalLayout {
                                        horizontal-stretch: 1; spacing: 6px;
                                        Rectangle { width: 1px; height: 16px; y: (parent.height - 16px) / 2; background: Theme.separator; }
                                        VerticalLayout { alignment: center; padding-left: 6px; FileIcon { index: 0; } }
                                        Text {
                                            horizontal-stretch: 1; min-width: 40px;
                                            text: root.browse-path; color: Theme.secondary; font-size: 12px; overflow: elide; vertical-alignment: center;
                                        }
                                        if !root.bottom-collapsed: VerticalLayout {
                                            alignment: center;
                                            BarButton {
                                                chevron: 2; label: "返回上级目录";
                                                enabled: root.can-go-parent;
                                                clicked => { root.action("remote_parent", ""); }
                                            }
                                        }
                                        if !root.bottom-collapsed: VerticalLayout {
                                            alignment: center;
                                            BarButton {
                                                source: @image-url("refresh.svg"); label: "刷新";
                                                enabled: (root.active-state == 2 || root.active-state == 3) && root.file-loading-path == "";
                                                clicked => { root.action("list_files", root.browse-path); }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    PanelToggle {
                                        direction: root.bottom-collapsed ? 2 : 3;
                                        label: root.bottom-collapsed ? "展开底部面板" : "收起底部面板";
                                        clicked => { root.bottom-collapsed = !root.bottom-collapsed; }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            visible: !root.bottom-collapsed;
                            VerticalBox {
                                padding: 10px; spacing: 0px;
                                if root.bottom-page == 0: VerticalBox {
                                    spacing: 9px; padding: 0px;
                                    dropper := DropArea {
                                        vertical-stretch: 1;
                                        can-drop(event) => { root.remote-ready && root.accepts-files(event.data) ? DragAction.copy : DragAction.none }
                                        dropped(event) => { root.drop-files(event.data); return DragAction.copy; }
                                        HorizontalBox {
                                            padding: 0px; spacing: 6px;
                                            Rectangle {
                                                width: 240px; background: Theme.surface; border-radius: 5px; border-width: 1px; border-color: Theme.border; clip: true;
                                                if !root.remote-ready && root.file-hint != "": Text { text: root.file-hint; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                                ContextMenuArea {
                                                    Menu {
                                                        MenuItem { title: "刷新"; enabled: (root.active-state == 2 || root.active-state == 3) && root.file-loading-path == ""; activated => { root.action("list_files", root.browse-path); } }
                                                        // 读取失败 (如权限不足) 后列表不可用, 仍要能退回上级.
                                                        MenuItem { title: "返回上级目录"; enabled: root.can-go-parent; activated => { root.action("remote_parent", ""); } }
                                                        MenuItem { title: "转到目录…"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.goto-path = root.browse-path; root.goto-editing = true; } }
                                                        MenuItem { title: "转到根目录 /"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.action("list_files", "/"); } }
                                                        MenuItem { title: "转到主目录"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.action("list_files", "."); } }
                                                        MenuSeparator {}
                                                        MenuItem { title: "全部收起"; enabled: root.directory-tree.length > 1; activated => { root.action("tree_collapse_all", ""); } }
                                                        MenuItem { title: "复制当前路径"; activated => { root.copy-text(root.browse-path); } }
                                                    }
                                                tree-list := ListView {
                                                    vertical-scrollbar-policy: always-off;
                                                    content-width: self.visible-width;
                                                    content-y <=> root.tree-scroll-y;
                                                    init => { root.tree-view-height = self.visible-height; }
                                                    changed visible-height => { root.tree-view-height = self.visible-height; }
                                                    for directory in root.directory-tree: Rectangle {
                                                        width: tree-list.visible-width; height: 25px;
                                                        background: root.browse-path == directory.path ? Theme.selected : tree-touch.has-hover ? Theme.hover : transparent;
                                                        FileIcon { x: 20px + directory.depth * 12px; y: 5px; index: directory.expanded ? 1 : 0; }
                                                        if root.file-loading-path == directory.path || root.tree-loading == directory.path: LoadSpinner { x: parent.width - 30px; y: 6px; width: 13px; height: 13px; }
                                                        Text { x: 40px + directory.depth * 12px; width: max(0px, parent.width - self.x - 34px); height: 100%; text: directory.name; color: Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                                        tree-menu := ContextMenuArea {
                                                            Menu {
                                                                MenuItem { title: root.browse-path == directory.path ? "刷新" : "打开目录"; activated => { root.action("list_files", directory.path); } }
                                                                MenuItem { title: directory.expanded ? "收起" : "展开"; enabled: root.tree-loading == ""; activated => { root.action("tree_toggle", directory.path); } }
                                                                Menu {
                                                                    title: "上传到此目录"; enabled: root.remote-ready;
                                                                    MenuItem { title: "文件…"; activated => { root.choose-upload(directory.path, "upload"); } }
                                                                    MenuItem { title: "文件夹…"; activated => { root.choose-upload(directory.path, "upload_folder"); } }
                                                                }
                                                                MenuSeparator {}
                                                                MenuItem { title: "复制路径"; activated => { root.copy-text(directory.path); } }
                                                                MenuSeparator {}
                                                                // 目录只能整体删除, 统一走 rm -rf 并先弹确认框; 根目录不提供.
                                                                MenuItem { title: "删除文件夹 (rm -rf)…"; enabled: root.remote-ready && directory.path != "/"; activated => { root.action("prepare_delete_dir", directory.path); } }
                                                            }
                                                            tree-touch := TouchArea {
                                                                // 子触控区会先收到右键并吞掉, 需手动弹出外层菜单.
                                                                pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { tree-menu.show({x: self.mouse-x, y: self.mouse-y}); } }
                                                                // 单击打开目录并展开; 已是当前目录时不做任何操作, 展开/收起只由左侧箭头或右键菜单完成.
                                                                clicked => {
                                                                    // 打开目录只读一次: 列表返回后会同时补上目录树的子目录并展开.
                                                                    if root.browse-path != directory.path {
                                                                        root.action("list_files", directory.path);
                                                                    }
                                                                }
                                                                accessible-role: button; accessible-label: directory.path;
                                                                accessible-action-default => { self.clicked(); }
                                                            }
                                                            Rectangle {
                                                                x: directory.depth * 12px; width: 20px; height: 100%;
                                                                Chevron { x: 5px; y: (parent.height - 10px) / 2; direction: directory.expanded ? 3 : 1; color: Theme.muted; }
                                                                TouchArea {
                                                                    enabled: root.tree-loading == "";
                                                                    clicked => { root.action("tree_toggle", directory.path); }
                                                                    accessible-role: button; accessible-label: (directory.expanded ? "收起 " : "展开 ") + directory.path;
                                                                    accessible-action-default => { self.clicked(); }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                SlimScrollBar {
                                                    x: tree-list.x + tree-list.width - self.width; y: tree-list.y; height: tree-list.height;
                                                    viewport-y <=> tree-list.content-y; viewport-height: tree-list.content-height; visible-height: tree-list.visible-height;
                                                }
                                                }
                                                // 第一次读取时目录树还没有节点; 之后由读取中的行显示圆圈.
                                                if root.file-loading-path != "" && root.directory-tree.length == 0: LoadingMask { text: "正在读取"; }
                                            }
                                            file-menu := ContextMenuArea {
                                                horizontal-stretch: 1;
                                                Menu {
                                                    MenuItem { title: "返回上级目录"; enabled: root.can-go-parent; activated => { root.action("remote_parent", ""); } }
                                                    MenuItem { title: "转到目录…"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.goto-path = root.browse-path; root.goto-editing = true; } }
                                                    MenuItem { title: "转到根目录 /"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.action("list_files", "/"); } }
                                                    MenuItem { title: "转到主目录"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.action("list_files", "."); } }
                                                    MenuItem { title: "刷新"; enabled: (root.active-state == 2 || root.active-state == 3) && root.file-loading-path == ""; activated => { root.action("list_files", root.browse-path); } }
                                                    MenuSeparator {}
                                                    MenuItem { title: "下载所选"; enabled: root.remote-ready && root.selected-files-count > 0; activated => { root.choose-path("download"); } }
                                                    MenuItem { title: "下载所选到…"; enabled: root.remote-ready && root.selected-files-count > 0; activated => { root.choose-path("download_to"); } }
                                                    Menu {
                                                        title: "上传到当前目录"; enabled: root.remote-ready;
                                                        MenuItem { title: "文件…"; activated => { root.choose-upload(root.browse-path, "upload"); } }
                                                        MenuItem { title: "文件夹…"; activated => { root.choose-upload(root.browse-path, "upload_folder"); } }
                                                    }
                                                    Menu {
                                                        title: "新建"; enabled: root.remote-ready;
                                                        MenuItem { title: "文件夹…"; activated => { root.action("prepare_create_directory", ""); } }
                                                        MenuItem { title: "文件…"; activated => { root.action("prepare_create_file", ""); } }
                                                    }
                                                    MenuSeparator {}
                                                    MenuItem { title: "复制当前目录路径"; activated => { root.copy-text(root.browse-path); } }
                                                    MenuSeparator {}
                                                    MenuItem { title: "删除所选…"; enabled: root.remote-ready && root.selected-files-count > 0; activated => { root.action("prepare_delete", ""); } }
                                                    MenuItem { title: "快速删除所选 (rm -rf)…"; enabled: root.remote-ready && root.selected-files-count > 0; activated => { root.action("prepare_delete", "fast"); } }
                                                }
                                                FileTable {
                                                    rows: root.files; ready: root.remote-ready; has-parent: root.browse-path != "/"; selected-count: root.selected-files-count;
                                                    time-label: root.file-time-label;
                                                    scroll-y <=> root.file-scroll-y;
                                                    view-height <=> root.file-view-height;
                                                    select(c_file, c_toggle, c_range, c_context) => { root.file-selection(c_file, c_toggle, c_range, c_context); }
                                                    activate(c_file) => { root.activate-remote(c_file); }
                                                    file-action(c_action, c_file) => { root.file-action(c_action, c_file); }
                                                    delete-pressed => { root.action("prepare_delete", "key"); }
                                                    select-all-pressed => { root.action("select_all_files", ""); }
                                                    clear-selection => { root.action("clear_file_selection", ""); }
                                                    blank-menu(c_x, c_y) => { file-menu.show({x: c_x, y: c_y}); }
                                                }
                                                // 有缓存时遮罩下透出上次内容, 读取完成后替换.
                                                if root.file-loading-path != "": LoadingMask { text: root.file-loading-path == "." ? "正在读取" : "正在读取 " + root.file-loading-path; }
                                                if root.remote-ready && root.files.length == 0 && root.file-loading-path == "": Text { y: 28px; height: parent.height - 28px; text: "此目录为空"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                                // 读取失败: 原因留在文件区 (状态栏消息会淡出), 并给出返回上级与重试.
                                                if root.show-file-error: Rectangle {
                                                    y: 28px; height: parent.height - 28px;
                                                    VerticalLayout {
                                                        alignment: center; spacing: 12px;
                                                        HorizontalLayout {
                                                            alignment: center;
                                                            ErrorBanner { width: min(440px, parent.width - 40px); text: "无法打开此目录: " + root.file-error; }
                                                        }
                                                        HorizontalLayout {
                                                            alignment: center; spacing: 8px;
                                                            if root.can-go-parent: AppButton { text: "返回上级目录"; primary: true; clicked => { root.action("remote_parent", ""); } }
                                                            AppButton { text: "重试"; clicked => { root.action("list_files", root.browse-path); } }
                                                        }
                                                    }
                                                }
                                                if !root.remote-ready && root.file-hint != "": Text { y: 28px; height: parent.height - 28px; text: root.file-hint; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        if self.has-drag: Rectangle {
                                            border-width: 2px; border-color: Theme.accent; border-radius: 6px; background: Theme.accent.with-alpha(0.08);
                                            Text { text: "上传到 " + root.browse-path; color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                                if root.bottom-page == 1: HorizontalBox {
                                    spacing: 10px; padding: 0px;
                                    VerticalBox {
                                        width: 180px; spacing: 6px; padding: 0px;
                                        Text { text: "分组"; color: Theme.secondary; font-size: 11px; }
                                        Rectangle {
                                            vertical-stretch: 1; background: Theme.surface; border-radius: 6px; border-width: 1px; border-color: Theme.border; clip: true;
                                            ContextMenuArea {
                                                Menu {
                                                    MenuItem { title: "新增分组…"; activated => { root.action("edit_command_group", ""); } }
                                                    MenuItem { title: "新增命令…"; activated => { root.edit-command(""); } }
                                                    MenuSeparator {}
                                                    MenuItem { title: "导入命令…"; activated => { root.choose-path("import_commands"); } }
                                                    MenuItem { title: "导出全部命令…"; activated => { root.choose-path("export_commands"); } }
                                                }
                                            command-folders := ListView {
                                                vertical-scrollbar-policy: always-off;
                                                content-width: self.visible-width;
                                                for group[i] in root.command-groups: Rectangle {
                                                    // 行与高亮铺满, 细滚动条半透明叠在上面; 文字右侧为滚动条预留空间.
                                                    width: command-folders.visible-width; height: 30px;
                                                    opacity: root.drag-list == "cmdgroup" && root.drag-moved && root.drag-from == i ? 0.5 : 1;
                                                    if root.drag-list == "cmdgroup" && root.drag-moved && root.drag-from >= 0 && root.drag-to == i: Rectangle { y: 0px; height: 2px; background: Theme.accent; }
                                                    if root.drag-list == "cmdgroup" && root.drag-moved && root.drag-from >= 0 && root.drag-to == i + 1 && i == root.command-groups.length - 1: Rectangle { y: parent.height - 2px; height: 2px; background: Theme.accent; }

                                                    background: root.selected-command-group == group ? Theme.selected : folder-touch.has-hover ? Theme.hover : transparent;
                                                    FileIcon { x: 8px; y: 7px; index: root.selected-command-group == group ? 1 : 0; }
                                                    Text { x: 30px; width: parent.width - 48px; height: 100%; text: group; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                                    folder-menu := ContextMenuArea {
                                                        Menu {
                                                            MenuItem { title: "新增命令…"; activated => { root.action("select_command_group", group); root.edit-command(""); } }
                                                            MenuItem { title: "新增分组…"; activated => { root.action("edit_command_group", ""); } }
                                                            MenuSeparator {}
                                                            MenuItem { title: "编辑分组…"; activated => { root.action("edit_command_group", group); } }
                                                            MenuSeparator {}
                                                            MenuItem { title: "导入命令…"; activated => { root.choose-path("import_commands"); } }
                                                            MenuItem { title: "导出全部命令…"; activated => { root.choose-path("export_commands"); } }
                                                            MenuSeparator {}
                                                            MenuItem { title: "删除分组"; enabled: root.command-groups.length > 1; activated => { root.action("delete_command_group", group); } }
                                                        }
                                                        folder-touch := TouchArea {
                                                            // 子触控区会先收到右键并吞掉, 需手动弹出外层菜单.
                                                            pointer-event(event) => {
                                                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.action("select_command_group", group); folder-menu.show({x: self.mouse-x, y: self.mouse-y}); }
                                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.drag-press("cmdgroup", i); }
                                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.drag-release("cmdgroup"); }
                                                            }
                                                            moved => { if self.pressed { root.drag-move("cmdgroup", i, root.command-groups.length, self.mouse-y, self.mouse-y - self.pressed-y, 30px); } }
                                                            accessible-role: button; accessible-label: "命令分组 " + group;
                                                            accessible-action-default => { self.clicked(); }
                                                            clicked => { if !root.drag-moved { root.action("select_command_group", group); } }
                                                        }
                                                    }
                                                }
                                            }
                                            SlimScrollBar {
                                                x: command-folders.x + command-folders.width - self.width; y: command-folders.y; height: command-folders.height;
                                                viewport-y <=> command-folders.content-y; viewport-height: command-folders.content-height; visible-height: command-folders.visible-height;
                                            }
                                            }
                                        }
                                    }
                                    VerticalBox {
                                        width: 260px; spacing: 6px; padding: 0px;
                                        Text { text: "常用命令"; color: Theme.secondary; font-size: 11px; }
                                        Rectangle {
                                            vertical-stretch: 1; min-height: 54px; background: Theme.surface; border-radius: 6px; border-width: 1px; border-color: Theme.border; clip: true;
                                            ContextMenuArea {
                                                Menu {
                                                    MenuItem { title: "新增命令…"; activated => { root.edit-command(""); } }
                                                    MenuItem { title: "新增分组…"; activated => { root.action("edit_command_group", ""); } }
                                                    MenuSeparator {}
                                                    MenuItem { title: "导入命令…"; activated => { root.choose-path("import_commands"); } }
                                                    MenuItem { title: "导出全部命令…"; activated => { root.choose-path("export_commands"); } }
                                                }
                                                if root.visible-commands.length == 0: Text { text: "暂无命令, 右键可新增"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                                command-list := ListView {
                                                    vertical-scrollbar-policy: always-off;
                                                    content-width: self.visible-width;
                                                    for command[i] in root.visible-commands: Rectangle {
                                                        width: command-list.visible-width; height: 30px;
                                                        opacity: root.drag-list == "cmd" && root.drag-moved && root.drag-from == i ? 0.5 : 1;
                                                        if root.drag-list == "cmd" && root.drag-moved && root.drag-from >= 0 && root.drag-to == i: Rectangle { y: 0px; height: 2px; background: Theme.accent; }
                                                        if root.drag-list == "cmd" && root.drag-moved && root.drag-from >= 0 && root.drag-to == i + 1 && i == root.visible-commands.length - 1: Rectangle { y: parent.height - 2px; height: 2px; background: Theme.accent; }

                                                        background: root.saved-command-id == command.id ? Theme.selected : command-touch.has-hover ? Theme.hover : transparent;
                                                        FileIcon { x: 10px; y: 7px; index: 12; }
                                                        Text { x: 34px; width: max(0px, parent.width - 52px); height: 100%; text: command.label; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                                        command-menu := ContextMenuArea {
                                                            Menu {
                                                                MenuItem { title: "在当前终端执行"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.action("send_saved_command", command.id); } }
                                                                MenuItem { title: "独立执行"; enabled: root.active-session != "" && !root.active-session-empty; activated => { root.action("run_command", command.command); } }
                                                                MenuSeparator {}
                                                                MenuItem { title: "编辑…"; activated => { root.edit-command(command.id); } }
                                                                MenuItem { title: "新增命令…"; activated => { root.edit-command(""); } }
                                                                MenuItem { title: "复制命令"; activated => { root.copy-text(command.command); } }
                                                                MenuSeparator {}
                                                                MenuItem { title: "删除命令"; activated => { root.action("delete_saved_command", command.id); } }
                                                            }
                                                            command-touch := TouchArea {
                                                                // 子触控区会先收到右键并吞掉, 需手动弹出外层菜单.
                                                                pointer-event(event) => {
                                                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.saved-command-id = command.id; root.command-text = command.command; command-menu.show({x: self.mouse-x, y: self.mouse-y}); }
                                                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.drag-press("cmd", i); }
                                                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.drag-release("cmd"); }
                                                                }
                                                                moved => { if self.pressed { root.drag-move("cmd", i, root.visible-commands.length, self.mouse-y, self.mouse-y - self.pressed-y, 30px); } }
                                                                accessible-role: button; accessible-label: command.label;
                                                                accessible-action-default => { self.clicked(); }
                                                                clicked => {
                                                                    if root.drag-moved { return; }
                                                                    root.saved-command-id = command.id;
                                                                    root.command-text = command.command;
                                                                }
                                                                // 双击在当前终端执行.
                                                                double-clicked => { if root.active-session != "" && !root.active-session-empty { root.action("send_saved_command", command.id); } }
                                                            }
                                                        }
                                                    }
                                                }
                                                SlimScrollBar {
                                                    x: command-list.x + command-list.width - self.width; y: command-list.y; height: command-list.height;
                                                    viewport-y <=> command-list.content-y; viewport-height: command-list.content-height; visible-height: command-list.visible-height;
                                                }
                                            }
                                        }
                                    }
                                    VerticalBox {
                                        horizontal-stretch: 1; spacing: 6px; padding: 0px;
                                        Text { text: "命令内容"; color: Theme.secondary; font-size: 11px; }
                                        TextEdit { text <=> root.command-text; accessible-label: "命令详情"; placeholder-text: "选择左侧命令查看内容"; center-placeholder: true; font-family: root.effective-terminal-font; wrap: no-wrap; command-actions: true; command-connected: root.active-session != "" && !root.active-session-empty; execute-command(independent) => { root.action(independent ? "run_command" : "send_command", root.command-text); } }
                                    }
                                }
                                if root.bottom-page == 2: HorizontalBox {
                                    spacing: 12px; padding: 0px;
                                    VerticalBox {
                                        horizontal-stretch: 1; spacing: 6px; padding: 0px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: "任务"; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
                                            Text { text: root.tasks.length > 0 ? "· " + root.tasks.length : ""; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                                        }
                                        Rectangle {
                                            vertical-stretch: 1; background: Theme.surface; border-radius: 6px; border-width: 1px; border-color: Theme.border; clip: true;
                                            if root.tasks.length == 0: Text { text: "暂无任务"; color: Theme.muted; font-size: 11.5px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                                            task-list := ListView {
                                                vertical-scrollbar-policy: always-off;
                                                horizontal-scrollbar-policy: always-off;
                                                for task in root.tasks: task-row := Rectangle {
                                                    width: task-list.visible-width; height: 54px;
                                                    // 状态色只用于状态文字与圆点; 图标按类型着色: 上传红、下载蓝 (与网络图一致), 命令为主题色.
                                                    property <color> state-color: task.state == 1 ? Theme.network : task.state == 2 ? Theme.danger : task.state == 3 ? Theme.muted : Theme.accent;
                                                    property <color> kind-color: task.kind == 1 ? Theme.danger : task.kind == 2 ? Theme.cpu : Theme.accent;
                                                    property <length> text-width: self.width - 12px - 50px - (task.cancellable ? 46px : 12px);
                                                    Rectangle {
                                                        // 左右留出相同边距; 细滚动条半透明叠在右侧, 取消按钮避开滚动条区域.
                                                        x: 6px; y: 2px; width: parent.width - 12px; height: parent.height - 4px; border-radius: 7px;
                                                        background: root.selected-task == task.id ? Theme.selected : task-touch.has-hover ? Theme.hover : transparent;
                                                        Rectangle {
                                                            x: 10px; y: (parent.height - 30px) / 2; width: 30px; height: 30px; border-radius: 8px;
                                                            background: task-row.kind-color.with-alpha(0.14);
                                                            if task.kind == 0: Icon { index: 12; x: 7px; y: 7px; colorize: task-row.kind-color; }
                                                            if task.kind != 0: TransferArrow { x: (parent.width - 14px) / 2; y: (parent.height - 14px) / 2; width: 14px; height: 14px; up: task.kind == 1; color: task-row.kind-color; }
                                                        }
                                                        HorizontalLayout {
                                                            x: 50px; y: 8px; width: task-row.text-width; height: 18px; spacing: 6px;
                                                            Text { text: task.title; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                                            Rectangle {
                                                                width: source-text.preferred-width + 12px; height: 16px; y: 1px; border-radius: 8px;
                                                                background: task.ai ? Theme.cpu.with-alpha(0.18) : Theme.cache.with-alpha(0.18);
                                                                border-width: 1px; border-color: task.ai ? Theme.cpu.with-alpha(0.45) : Theme.cache.with-alpha(0.45);
                                                                source-text := Text { x: 6px; height: 100%; text: task.source; color: task.ai ? Theme.cpu : Theme.cache; font-size: 9.5px; font-weight: 700; vertical-alignment: center; }
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            x: 50px; y: 28px; width: task-row.text-width; height: 16px; spacing: 6px;
                                                            VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: task-row.state-color; } }
                                                            Text { text: task.status; color: task.state == 2 ? Theme.danger : Theme.secondary; font-size: 10.5px; vertical-alignment: center; }
                                                            Text { text: "·  " + task.server + (task.detail != "" ? "  ·  " + task.detail : ""); color: Theme.muted; font-size: 10.5px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                                        }
                                                        if task.ratio >= 0 && task.state == 0: Rectangle {
                                                            x: 50px; y: parent.height - 6px; width: task-row.text-width; height: 3px; border-radius: 1.5px; background: Theme.track;
                                                            Rectangle { x: 0px; width: parent.width * task.ratio; height: 100%; border-radius: 1.5px; background: task-row.kind-color; animate width { duration: 300ms; } }
                                                        }
                                                        task-menu := ContextMenuArea {
                                                            Menu {
                                                                MenuItem { title: "查看结果"; activated => { root.action("get_task", task.id); } }
                                                                MenuItem { title: "复制任务名称"; activated => { root.copy-text(task.title); } }
                                                                MenuSeparator {}
                                                                MenuItem { title: "取消任务"; enabled: task.cancellable; activated => { root.action("cancel_task", task.id); } }
                                                            }
                                                            task-touch := TouchArea {
                                                                // 子触控区会先收到右键并吞掉, 需手动弹出外层菜单.
                                                                pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { task-menu.show({x: self.mouse-x, y: self.mouse-y}); } }
                                                                accessible-role: button; accessible-label: task.title;
                                                                accessible-action-default => { self.clicked(); }
                                                                clicked => { root.action("get_task", task.id); }
                                                            }
                                                        }
                                                        if task.cancellable: AppButton {
                                                            x: parent.width - 40px; y: (parent.height - 26px) / 2; width: 26px; height: 26px;
                                                            text: "取消任务"; icon: 11; horizontal-padding: 0px; clicked => { root.action("cancel_task", task.id); }
                                                        }
                                                    }
                                                }
                                            }
                                            SlimScrollBar {
                                                x: task-list.x + task-list.width - self.width; y: task-list.y; height: task-list.height;
                                                viewport-y <=> task-list.content-y; viewport-height: task-list.content-height; visible-height: task-list.visible-height;
                                            }
                                        }
                                    }
                                    VerticalBox {
                                        horizontal-stretch: 2; spacing: 6px; padding: 0px;
                                        Text { text: "任务详情"; color: Theme.secondary; font-size: 11px; }
                                        TextEdit { text: root.task-output; placeholder-text: "选择任务查看结果"; center-placeholder: true; accessible-label: "任务详情"; read-only: true; wrap: no-wrap; font-family: root.effective-terminal-font; }
                                    }
                                }
                            }
                        }
                    }
                    // 顶边拖动调整底部面板高度 (展开时), 终端区至少保留约 300px.
                    if !root.bottom-collapsed: Rectangle {
                        height: 6px; y: 0px;
                        background: bottom-resize.has-hover || bottom-resize.pressed ? Theme.accent.with-alpha(0.35) : transparent;
                        bottom-resize := TouchArea {
                            mouse-cursor: row-resize;
                            moved => {
                                if self.pressed {
                                    root.bottom-height = max(150px, min(root.height - 320px, root.bottom-height - (self.mouse-y - self.pressed-y)));
                                }
                            }
                        }
                    }
                }
            }
            // 侧栏: 服务器信息 → 网络 → 进程 → MCP, 每块使用同一种卡片.
            if root.monitor-expanded: Rectangle {
                width: root.monitor-width; background: Theme.panel; border-radius: 8px; border-width: 1px; border-color: Theme.border; clip: true;
                // 高度足够时各卡片按比例拉伸, 窗口较矮时整体滚动.
                side-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    width: side-scroll.visible-width; min-height: side-scroll.visible-height;
                    padding: 10px; spacing: 8px;
                    HorizontalLayout {
                        // 文字左边缘与下方卡片的边框对齐.
                        height: 34px; spacing: 8px; padding-left: 2px;
                        // 标题显示当前服务器名称与地址, 未连接时显示通用标题.
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 1px;
                            Text { text: root.monitor-server-name != "" ? root.monitor-server-name : "服务器监控"; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
                            if root.monitor-server-host != "": Text { text: root.monitor-server-host; color: Theme.muted; font-size: 10.5px; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; PanelToggle { direction: 1; label: "收起监控"; clicked => { root.monitor-expanded = false; } } }
                    }
                    SideCard {
                        UsageBar { label: "CPU"; ratio: root.cpu-ratio; usage: root.cpu-usage; fill: Theme.cpu; }
                        UsageBar { label: "内存"; ratio: root.memory-ratio; usage: root.memory-usage; fill: Theme.memory; }
                        UsageBar { label: "Swap"; ratio: root.swap-ratio; usage: root.swap-usage; fill: Theme.swap; }
                        UsageBar { label: "缓存"; ratio: root.cache-ratio; usage: root.cache-usage; fill: Theme.cache; }
                        if root.monitor-text != "": Text { text: root.monitor-text; color: Theme.secondary; wrap: word-wrap; font-size: 11px; }
                    }
                    SideCard {
                        HorizontalLayout {
                            height: 20px; spacing: 4px;
                            Text { text: "网络"; color: Theme.text; font-size: 12.5px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; TransferArrow { up: true; color: Theme.danger; } }
                            Text { text: root.network-upload-rate; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
                            VerticalLayout { alignment: center; TransferArrow { up: false; color: Theme.cpu; } }
                            Text { text: root.network-download-rate; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
                            MiniDropdown { label: "切换网卡"; model: root.network-interfaces; index <=> root.network-interface-index; changed => { root.monitor-selection-changed(); } }
                        }
                        NetChart { rx-line: root.network-rx-line; rx-area: root.network-rx-area; tx-line: root.network-tx-line; tx-area: root.network-tx-area; peak: root.network-peak; }
                    }
                    SideCard {
                        vertical-stretch: 1;
                        HorizontalLayout {
                            height: 26px;
                            Text { text: "进程"; color: Theme.text; font-size: 12.5px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                            SortSwitch { index <=> root.process-sort; changed => { root.monitor-selection-changed(); } }
                        }
                        process-box := Rectangle {
                            min-height: 96px; vertical-stretch: 1; background: Theme.panel; border-radius: 5px; border-width: 1px; border-color: Theme.border; clip: true;
                            // 列宽含右侧间距, 拖动表头分隔线调整; 默认适配侧栏宽度, 加宽后可左右滚动, 表头随内容横向移动.
                            in-out property <length> pid-w: 44px;
                            in-out property <length> name-w: 74px;
                            in-out property <length> cpu-w: 46px;
                            in-out property <length> mem-w: 58px;
                            property <length> name-x: 6px + self.pid-w;
                            property <length> cpu-x: self.name-x + self.name-w;
                            property <length> mem-x: self.cpu-x + self.cpu-w;
                            property <length> table-w: max(process-list.visible-width, self.mem-x + self.mem-w + 4px);
                            Rectangle {
                                x: process-list.content-x; y: 0px; width: process-box.table-w; height: 24px; background: Theme.header;
                                Text { x: 6px; width: process-box.pid-w - 6px; height: 100%; text: "PID"; color: Theme.secondary; font-size: 10px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                Text { x: process-box.name-x; width: process-box.name-w - 6px; height: 100%; text: "进程名"; color: Theme.secondary; font-size: 10px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                Text { x: process-box.cpu-x; width: process-box.cpu-w - 6px; height: 100%; text: "CPU"; color: Theme.secondary; font-size: 10px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                Text { x: process-box.mem-x; width: process-box.mem-w - 6px; height: 100%; text: "内存"; color: Theme.secondary; font-size: 10px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                ColumnGrip { x: process-box.name-x - 4px; resized(c_delta) => { process-box.pid-w = max(32px, process-box.pid-w + c_delta); } }
                                ColumnGrip { x: process-box.cpu-x - 4px; resized(c_delta) => { process-box.name-w = max(40px, process-box.name-w + c_delta); } }
                                ColumnGrip { x: process-box.mem-x - 4px; resized(c_delta) => { process-box.cpu-w = max(36px, process-box.cpu-w + c_delta); } }
                                ColumnGrip { x: process-box.mem-x + process-box.mem-w - 4px; resized(c_delta) => { process-box.mem-w = max(40px, process-box.mem-w + c_delta); } }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
                            }
                            if root.processes.length == 0: Text { y: 24px; height: parent.height - 24px; text: "暂无进程数据"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            process-list := ListView {
                                vertical-scrollbar-policy: always-off;
                                x: 0px; y: 24px; width: parent.width; height: parent.height - 24px;
                                content-width: process-box.table-w;
                                for process in root.processes: Rectangle {
                                    width: process-list.content-width; height: 24px;
                                    Text { x: 6px; width: process-box.pid-w - 6px; height: 100%; text: process.pid; color: Theme.muted; font-size: 10px; overflow: elide; vertical-alignment: center; }
                                    Text { x: process-box.name-x; width: process-box.name-w - 6px; height: 100%; text: process.name; color: Theme.text; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                    Text { x: process-box.cpu-x; width: process-box.cpu-w - 6px; height: 100%; text: process.cpu-text; color: Theme.secondary; font-size: 10px; overflow: elide; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { x: process-box.mem-x; width: process-box.mem-w - 6px; height: 100%; text: process.memory-text; color: Theme.secondary; font-size: 10px; overflow: elide; horizontal-alignment: right; vertical-alignment: center; }
                                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.separator; }
                                    ContextMenuArea {
                                        Menu {
                                            MenuItem { title: "复制 PID"; activated => { root.copy-text(process.pid); } }
                                            MenuItem { title: "复制进程名"; activated => { root.copy-text(process.name); } }
                                        }
                                    }
                                }
                            }
                            SlimScrollBar {
                                x: process-list.x + process-list.width - self.width; y: process-list.y; height: process-list.height;
                                viewport-y <=> process-list.content-y; viewport-height: process-list.content-height; visible-height: process-list.visible-height;
                            }
                        }
                    }
                    McpCard {
                        vertical-stretch: 1;
                        running: root.mcp-running;
                        servers: root.mcp-servers.length;
                        activity: root.mcp-activity;
                        window-width: root.width;
                        window-height: root.height;
                    }
                }
                }
                // 左边拖动调整侧栏宽度, 220–520px.
                Rectangle {
                    x: 0px; width: 6px;
                    background: side-resize.has-hover || side-resize.pressed ? Theme.accent.with-alpha(0.35) : transparent;
                    side-resize := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                root.monitor-width = max(220px, min(520px, root.monitor-width - (self.mouse-x - self.pressed-x)));
                            }
                        }
                    }
                }
            }
            if !root.monitor-expanded: Rectangle {
                width: 40px; background: strip-touch.has-hover ? Theme.hover : Theme.panel; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                // 整条收起栏都可点击展开, 不必瞄准小按钮.
                strip-touch := TouchArea { mouse-cursor: pointer; clicked => { root.monitor-expanded = true; } }
                VerticalBox {
                    padding: 4px; spacing: 6px;
                    PanelToggle { direction: 0; label: "展开监控"; clicked => { root.monitor-expanded = true; } }
                    Text { text: "监\n控"; color: Theme.secondary; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
                    Rectangle { vertical-stretch: 1; }
                    MiniBar { ratio: root.cpu-ratio; fill: Theme.cpu; }
                    MiniBar { ratio: root.memory-ratio; fill: Theme.memory; }
                    MiniBar { ratio: root.swap-ratio; fill: Theme.swap; }
                    MiniBar { ratio: root.cache-ratio; fill: Theme.cache; }
                }
            }
        }
        // 状态栏: 左侧为最近一条消息 (按类别着色, 自动淡出, 可重试的失败带“重试”), 右侧为当前会话与终端尺寸, 固定宽度;
        // 传输进度在顶栏传输按钮和面板中显示. 消息区只在宽度不够时收窄.
        status-bar := Rectangle {
            height: 30px; background: Theme.panel; border-radius: 6px; border-width: 1px; border-color: Theme.border;
            property <color> kind-color: root.status-kind == 3 ? Theme.danger : root.status-kind == 2 ? Theme.caution : root.status-kind == 1 ? Theme.network : Theme.accent;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 10px;
                HorizontalLayout {
                    // 最小窗口下也留出一段消息.
                    spacing: 7px; horizontal-stretch: 1; min-width: 100px;
                    // 单个圆点按类别着色: 绿色成功, 青色提示, 琥珀警告, 红色错误, 空闲为灰色.
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.status-idle ? Theme.muted.with-alpha(0.6) : status-bar.kind-color; }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            width: parent.width; height: parent.height;
                            text: root.status-idle ? "就绪" : root.status;
                            color: root.status-idle ? Theme.muted : root.status-kind == 3 ? Theme.danger : root.status-kind == 2 ? Theme.caution : Theme.text;
                            font-size: 11.5px; overflow: elide; vertical-alignment: center;
                        }
                        // 点击消息立即收起.
                        TouchArea { enabled: !root.status-idle; clicked => { root.status-idle = true; } }
                    }
                    if !root.status-idle && root.status-retry != "": Rectangle {
                        width: 40px;
                        retry-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.status-idle = true;
                                root.action(root.status-retry, root.status-retry-arg);
                            }
                        }
                        Text {
                            width: parent.width; height: parent.height; text: "重试"; font-size: 11.5px; font-weight: 600;
                            color: retry-touch.has-hover ? Theme.accent-hover : Theme.accent;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout { alignment: center; Rectangle { width: 1px; height: 13px; background: Theme.border; } }
                HorizontalLayout {
                    width: 330px; spacing: 7px;
                    VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.active-state == 2 ? Theme.network : root.active-state == 3 ? Theme.info : root.active-state == 1 ? Theme.caution : root.active-state == 4 ? Theme.danger : Theme.muted; } }
                    Text { text: root.peer-status; color: Theme.secondary; font-size: 11.5px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    // 固定宽度: 尺寸文字不能参与布局计算, 否则会与终端行列数互相依赖.
                    Rectangle {
                        // 按最宽的 "999 列 · 999 行" 预留.
                        width: 96px;
                        Text { width: parent.width; height: parent.height; text: root.active-connected ? root.terminal-size-text : ""; color: Theme.muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
            }
        }
        // 消息自动淡出: 提示与成功 5 秒, 警告 10 秒, 错误 20 秒; 每秒累计一次, 新消息到来时清零.
        Timer {
            interval: 1s; running: !root.status-idle;
            triggered => {
                root.status-age += 1;
                if root.status-age >= (root.status-kind == 3 ? 20 : root.status-kind == 2 ? 10 : 5) { root.status-idle = true; }
            }
        }
    }

    // 传输面板: 挂在顶栏传输按钮下方, 右边与按钮对齐. 透明遮罩铺满窗口, 点面板外任意处 (包括传输按钮) 都只收起面板;
    // 画在各对话框之前, 下载同名询问等对话框显示在面板上方.
    if root.transfers-open: Rectangle {
        TouchArea { clicked => { root.transfers-open = false; } }
        transfer-panel := Rectangle {
            property <length> row-h: 56px;
            // 列表固定最多显示 5 行, 更多时在面板内滚动 (滚动条随之出现); 窗口较矮时再按窗口收窄.
            width: 360px;
            x: max(8px, transfer-button.absolute-position.x + transfer-button.width - self.width);
            y: transfer-button.absolute-position.y + transfer-button.height + 6px;
            height: min(root.height - self.y - 12px, 80px + min(5, max(1, root.transfers.length)) * self.row-h + 8px);
            background: Theme.dialog; border-radius: 10px; border-width: 1px; border-color: Theme.border; clip: true;
            drop-shadow-blur: 22px; drop-shadow-color: #00000066; drop-shadow-offset-y: 4px;
            // 吞掉面板内的点击, 不传给下面的遮罩.
            TouchArea {}
            VerticalLayout {
                // 标题行: 标题后紧跟进行中的各方向合计速度 (无传输时不显示, 字号小一档区分标题与内容), 右边为清空 (只隐藏已结束的项).
                // 标题与清空按钮在 44px 行内垂直居中; 速度不居中, 底边与标题文字底边对齐.
                HorizontalLayout {
                    height: 44px; padding-left: 14px; padding-right: 10px; spacing: 10px;
                    // 标题与速度间隔 6px; 上传、下载同时显示时两组之间再加宽, 不粘在一起.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px; height: title-text.preferred-height;
                            title-text := Text { text: "传输"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                            if root.transfer-up-speed != "": VerticalLayout {
                                alignment: end;
                                HorizontalLayout {
                                    spacing: 2px;
                                    VerticalLayout { alignment: center; TransferArrow { width: 9px; height: 9px; up: true; color: Theme.danger; } }
                                    Text { text: root.transfer-up-speed; color: Theme.danger; font-size: 10.5px; vertical-alignment: bottom; }
                                }
                            }
                            if root.transfer-down-speed != "": VerticalLayout {
                                alignment: end; padding-left: root.transfer-up-speed != "" ? 6px : 0px;
                                HorizontalLayout {
                                    spacing: 2px;
                                    VerticalLayout { alignment: center; TransferArrow { width: 9px; height: 9px; up: false; color: Theme.cpu; } }
                                    Text { text: root.transfer-down-speed; color: Theme.cpu; font-size: 10.5px; vertical-alignment: bottom; }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        AppButton {
                            height: 24px; font-size: 11.5px; horizontal-padding: 9px; text: "清空";
                            enabled: root.transfers.length > transfer-button.active;
                            clicked => { root.action("clear_transfers", ""); }
                        }
                    }
                }
                // 下载目录: 点路径在文件管理器中打开, "更改" 选择新目录并保存.
                Rectangle {
                    height: 36px; background: Theme.window.with-alpha(0.55);
                    Rectangle { y: 0px; height: 1px; background: Theme.separator; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 10px; spacing: 8px;
                        VerticalLayout { alignment: center; Icon { index: 0; width: 15px; height: 15px; } }
                        Text { text: "下载到"; color: Theme.secondary; font-size: 11.5px; vertical-alignment: center; }
                        Rectangle {
                            horizontal-stretch: 1;
                            Text {
                                width: 100%; height: 100%; text: root.download-dir;
                                color: dir-touch.has-hover ? Theme.accent : Theme.text; font-size: 11.5px; vertical-alignment: center; overflow: elide;
                            }
                            dir-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.action("open_download_dir", root.download-dir); }
                                accessible-role: button; accessible-label: "打开下载目录";
                            }
                        }
                        VerticalLayout { alignment: center; AppButton { height: 24px; font-size: 11.5px; horizontal-padding: 9px; text: "更改"; clicked => { root.choose-path("download_dir"); } } }
                    }
                }
                if root.transfers.length == 0: Text {
                    height: transfer-panel.row-h; text: "暂无传输";
                    color: Theme.muted; font-size: 11.5px; horizontal-alignment: center; vertical-alignment: center;
                }
                if root.transfers.length > 0: Rectangle {
                    vertical-stretch: 1;
                    transfer-list := ScrollView {
                        horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding-top: 4px; padding-bottom: 4px;
                            for task[i] in root.transfers: transfer-row := Rectangle {
                                // 失败整行用红色; 进行中进度条按方向着色, 完成后不再显示进度条.
                                property <color> kind-color: task.state == 2 ? Theme.danger : task.kind == 1 ? Theme.danger : Theme.cpu;
                                property <bool> progress: task.state == 0 && task.ratio >= 0;
                                property <length> text-x: 50px;
                                // 已完成且本机文件可定位: 点左侧方向图标在文件夹中显示 (不再单独放文件夹按钮, 文字多出一截).
                                property <bool> revealable: task.state == 1 && task.local != "";
                                // 只有进行中的任务右侧有取消按钮; 细滚动条叠在最右 14px 内, 不压住按钮.
                                property <length> text-w: self.width - self.text-x - (task.cancellable ? 44px : 18px);
                                height: transfer-panel.row-h;
                                Rectangle {
                                    x: 6px; width: parent.width - 12px; height: parent.height - 4px; y: 2px; border-radius: 7px;
                                    background: row-touch.has-hover ? Theme.hover : transparent;
                                }
                                row-touch := TouchArea {}
                                Rectangle {
                                    x: 12px; y: (parent.height - 28px) / 2; width: 28px; height: 28px; border-radius: 7px;
                                    background: transfer-row.kind-color.with-alpha(transfer-row.revealable && icon-touch.has-hover ? 0.28 : 0.14);
                                    TransferArrow { x: (parent.width - 13px) / 2; y: (parent.height - 13px) / 2; width: 13px; height: 13px; up: task.kind == 1; color: transfer-row.kind-color; }
                                    icon-touch := TouchArea {
                                        enabled: transfer-row.revealable;
                                        mouse-cursor: transfer-row.revealable ? pointer : default;
                                        clicked => { root.action("reveal_local", task.local); }
                                        accessible-role: button; accessible-label: "在文件夹中显示 " + task.title;
                                    }
                                }
                                // 行间细分割线, 最后一行不画.
                                if i < root.transfers.length - 1: Rectangle { x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px; background: Theme.separator; }
                                // 第一行: 文件名独占 (长文件名不挤掉其他信息), 后面只跟发起的 AI 客户端.
                                HorizontalLayout {
                                    x: transfer-row.text-x; y: 8px; width: transfer-row.text-w; height: 18px; spacing: 6px;
                                    Text { text: task.title; color: Theme.text; font-size: 12.5px; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                    if task.ai: Rectangle {
                                        width: ai-text.preferred-width + 10px; height: 15px; y: 1.5px; border-radius: 7.5px;
                                        background: Theme.cpu.with-alpha(0.18); border-width: 1px; border-color: Theme.cpu.with-alpha(0.45);
                                        ai-text := Text { x: 5px; height: 100%; text: task.source; color: Theme.cpu; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                    }
                                }
                                // 进行中多一条进度条; 末行左边为大小/速度/剩余或用时 (已完成不再写"已完成", 失败等其他状态写出),
                                // 右边为服务器名称 (不带分组), 最多占三分之一宽.
                                if transfer-row.progress: Rectangle {
                                    x: transfer-row.text-x; y: 30px; width: transfer-row.text-w; height: 3px; border-radius: 1.5px; background: Theme.track;
                                    Rectangle { x: 0px; width: parent.width * task.ratio; height: 100%; border-radius: 1.5px; background: transfer-row.kind-color; animate width { duration: 300ms; } }
                                }
                                HorizontalLayout {
                                    x: transfer-row.text-x; y: transfer-row.progress ? 36px : 30px; width: transfer-row.text-w; height: 14px; spacing: 8px;
                                    Text {
                                        text: (task.state == 1 || (transfer-row.progress && task.status == "进行中") ? "" : task.status + " · ") + task.detail;
                                        color: task.state == 2 ? Theme.danger : Theme.muted; font-size: 10.5px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
                                    }
                                    Text {
                                        text: task.server; max-width: transfer-row.text-w / 3; horizontal-stretch: 0;
                                        color: Theme.muted; font-size: 10.5px; overflow: elide; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                }
                                // 进行中可取消.
                                if task.cancellable: AppButton {
                                    x: parent.width - 40px; y: (parent.height - 26px) / 2; width: 26px; height: 26px;
                                    text: "取消"; icon: 11; horizontal-padding: 0px; clicked => { root.action("cancel_task", task.id); }
                                }
                            }
                        }
                    }
                    SlimScrollBar {
                        x: parent.width - self.width; y: 0px; height: parent.height;
                        viewport-y <=> transfer-list.content-y; viewport-height: transfer-list.content-height; visible-height: transfer-list.visible-height;
                    }
                }
            }
        }
    }

    // 一次下载 3 项及以上到默认下载目录时先确认目录; 回车即开始下载.
    if root.conflict-open && root.conflict-kind == 1: Dialog {
        panel-width: 440px; panel-height: 206px; autofocus: true;
        cancel => { root.conflict-decided(0); }
        confirm => { root.conflict-decided(1); }
        VerticalBox {
            padding: 20px; spacing: 14px;
            HorizontalLayout {
                spacing: 12px; height: 44px;
                Rectangle {
                    width: 40px; height: 40px; y: 2px; border-radius: 20px; background: Theme.cpu.with-alpha(0.16);
                    TransferArrow { x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2; width: 18px; height: 18px; up: false; color: Theme.cpu; }
                }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: "下载 " + root.conflict-count + " 项"; color: Theme.text; font-size: 16px; font-weight: 700; }
                    Text { text: "请确认保存目录"; color: Theme.secondary; font-size: 11.5px; }
                }
            }
            // 路径最多两行, 过长省略; 点击在文件管理器中打开, 便于核对.
            Rectangle {
                height: 52px; border-radius: 7px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                Icon { x: 12px; y: (parent.height - 15px) / 2; width: 15px; height: 15px; index: 0; }
                Text {
                    x: 36px; width: parent.width - 48px; height: 100%; text: root.download-dir;
                    color: confirm-dir-touch.has-hover ? Theme.accent : Theme.text; font-family: root.effective-terminal-font; font-size: 12px;
                    wrap: char-wrap; overflow: elide; vertical-alignment: center;
                }
                confirm-dir-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.action("open_download_dir", root.download-dir); }
                    accessible-role: button; accessible-label: "打开下载目录";
                }
            }
            HorizontalLayout {
                spacing: 8px; alignment: end;
                AppButton { text: "取消"; clicked => { root.conflict-decided(0); } }
                AppButton { text: "开始下载"; primary: true; clicked => { root.conflict-decided(1); } }
            }
        }
    }
    if root.conflict-open && root.conflict-kind == 0: Dialog {
        // 所选方式对本次全部同名项生效; 文件夹覆盖即合并, 只替换同名文件.
        panel-width: 460px; panel-height: 280px; autofocus: true; enter-confirms: false;
        cancel => { root.conflict-decided(0); }
        VerticalBox {
            padding: 20px; spacing: 12px;
            Text { text: "文件已存在"; color: Theme.text; font-size: 16px; font-weight: 700; }
            Text { text: "目标位置已有以下同名项:"; color: Theme.secondary; font-size: 12px; }
            TextEdit { text: root.conflict-names; read-only: true; accessible-label: "已有同名文件"; wrap: no-wrap; }
            HorizontalLayout {
                spacing: 8px; alignment: end;
                AppButton { text: "取消"; clicked => { root.conflict-decided(0); } }
                AppButton { text: "保留两者"; clicked => { root.conflict-decided(2); } }
                AppButton { text: "覆盖"; danger: true; clicked => { root.conflict-decided(1); } }
                AppButton { text: "跳过"; primary: true; clicked => { root.conflict-decided(3); } }
            }
        }
    }
    if root.permissions-editing: perm-dialog := Dialog {
        // 高度随内容: 出现错误条时自动加高.
        panel-width: 420px; panel-height: max(268px, perm-layout.preferred-height); autofocus: true;
        cancel => { if !root.file-operation-busy { root.permissions-editing = false; } }
        confirm => { if !root.file-operation-busy { root.action("set_permissions", root.permissions-path); } }
        property <int> owner-bits: (root.owner-read ? 4 : 0) + (root.owner-write ? 2 : 0) + (root.owner-execute ? 1 : 0);
        property <int> group-bits: (root.group-read ? 4 : 0) + (root.group-write ? 2 : 0) + (root.group-execute ? 1 : 0);
        property <int> other-bits: (root.other-read ? 4 : 0) + (root.other-write ? 2 : 0) + (root.other-execute ? 1 : 0);
        property <string> symbolic: (root.owner-read ? "r" : "-") + (root.owner-write ? "w" : "-") + (root.owner-execute ? "x" : "-")
            + (root.group-read ? "r" : "-") + (root.group-write ? "w" : "-") + (root.group-execute ? "x" : "-")
            + (root.other-read ? "r" : "-") + (root.other-write ? "w" : "-") + (root.other-execute ? "x" : "-");
        perm-layout := VerticalBox {
            padding: 18px; spacing: 10px;
            VerticalLayout {
                spacing: 3px;
                Text { text: "修改权限"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { text: root.permissions-path; color: Theme.muted; font-size: 11px; overflow: elide; }
            }
            Rectangle {
                height: 28px + 3 * 34px + 2px; border-radius: 7px; background: Theme.surface; border-width: 1px; border-color: Theme.border; clip: true;
                Rectangle {
                    y: 0px; height: 28px; background: Theme.header;
                    Text { x: parent.width - 186px; width: 48px; height: 100%; text: "读取"; color: Theme.muted; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    Text { x: parent.width - 126px; width: 48px; height: 100%; text: "写入"; color: Theme.muted; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    Text { x: parent.width - 66px; width: 48px; height: 100%; text: "执行"; color: Theme.muted; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
                PermissionRow { y: 28px; width: parent.width; label: "所有者"; detail: root.permissions-owner; read <=> root.owner-read; write <=> root.owner-write; execute <=> root.owner-execute; }
                Rectangle { y: 62px; height: 1px; background: Theme.separator; }
                PermissionRow { y: 63px; width: parent.width; label: "用户组"; detail: root.permissions-group; read <=> root.group-read; write <=> root.group-write; execute <=> root.group-execute; }
                Rectangle { y: 97px; height: 1px; background: Theme.separator; }
                PermissionRow { y: 98px; width: parent.width; label: "其他"; detail: "其他所有用户"; read <=> root.other-read; write <=> root.other-write; execute <=> root.other-execute; }
            }
            if root.file-operation-error != "": ErrorBanner { text: root.file-operation-error; }
            HorizontalBox {
                padding: 0px; spacing: 8px;
                // 实时结果放在按钮行左侧, 便于对照 chmod 写法.
                Rectangle {
                    width: perm-result.preferred-width + 20px; height: 26px; y: 2px; border-radius: 13px; background: Theme.accent.with-alpha(0.14);
                    perm-result := Text { x: 10px; height: 100%; text: perm-dialog.owner-bits + "" + perm-dialog.group-bits + "" + perm-dialog.other-bits + "  ·  " + perm-dialog.symbolic; color: Theme.accent; font-family: root.effective-terminal-font; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "取消"; enabled: !root.file-operation-busy; clicked => { root.permissions-editing = false; } }
                AppButton { text: root.file-operation-busy ? "保存中…" : "确定"; enabled: !root.file-operation-busy; primary: true; clicked => { root.action("set_permissions", root.permissions-path); } }
            }
        }
    }
    if root.create-editing: Dialog {
        panel-width: 380px; panel-height: max(196px, create-layout.preferred-height);
        cancel => { if !root.file-operation-busy { root.create-editing = false; } }
        confirm => { root.submit-create(); }
        create-layout := VerticalBox {
            padding: 16px; spacing: 10px;
            Text { text: root.create-directory ? "新建文件夹" : "新建文件"; color: Theme.text; font-size: 15px; font-weight: 600; }
            Text { text: root.create-parent; color: Theme.secondary; overflow: elide; }
            LineEdit {
                text <=> root.create-name; accessible-label: "新建名称"; placeholder-text: "名称";
                init => { self.focus(); }
                accepted => { root.submit-create(); }
            }
            if root.file-operation-error != "": ErrorBanner { text: root.file-operation-error; }
            HorizontalBox {
                padding: 0px; spacing: 8px; alignment: end;
                AppButton { text: "取消"; enabled: !root.file-operation-busy; clicked => { root.create-editing = false; } }
                AppButton { text: root.file-operation-busy ? "创建中…" : "确定"; enabled: !root.file-operation-busy; primary: true; clicked => { root.submit-create(); } }
            }
        }
    }
    if root.rename-editing: Dialog {
        panel-width: 380px; panel-height: max(196px, rename-layout.preferred-height);
        cancel => { if !root.file-operation-busy { root.rename-editing = false; } }
        confirm => { root.submit-rename(); }
        rename-layout := VerticalBox {
            padding: 16px; spacing: 10px;
            Text { text: "重命名"; color: Theme.text; font-size: 15px; font-weight: 600; }
            Text { text: root.rename-path; color: Theme.secondary; overflow: elide; }
            LineEdit {
                text <=> root.rename-name; accessible-label: "新的文件名";
                init => { self.focus(); self.select-all(); }
                accepted => { root.submit-rename(); }
            }
            if root.file-operation-error != "": ErrorBanner { text: root.file-operation-error; }
            HorizontalBox {
                padding: 0px; spacing: 8px; alignment: end;
                AppButton { text: "取消"; enabled: !root.file-operation-busy; clicked => { root.rename-editing = false; } }
                AppButton { text: root.file-operation-busy ? "保存中…" : "确定"; enabled: !root.file-operation-busy; primary: true; clicked => { root.submit-rename(); } }
            }
        }
    }
    if root.delete-editing: Dialog {
        // 列表区可伸缩, 出现错误条 (最多两行, 50px) 时固定加高, 列表不被压缩.
        panel-width: 460px; panel-height: (root.delete-fast ? 380px : 340px) + (root.file-operation-error == "" ? 0px : 62px); autofocus: true;
        // rm -rf 不响应回车, 必须明确点击确认.
        enter-confirms: !root.delete-fast;
        cancel => { if !root.file-operation-busy { root.delete-editing = false; } }
        confirm => { if !root.file-operation-busy { root.action("delete_files", ""); } }
        VerticalBox {
            padding: 20px; spacing: 12px;
            HorizontalLayout {
                spacing: 12px; height: 44px;
                Rectangle {
                    width: 40px; height: 40px; y: 2px; border-radius: 20px;
                    background: (root.delete-fast ? Theme.danger : Theme.cache).with-alpha(0.16);
                    Text { width: 100%; height: 100%; text: "!"; color: root.delete-fast ? Theme.danger : Theme.cache; font-size: 22px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: root.delete-fast ? "快速删除 (rm -rf)" : "删除所选项目"; color: Theme.text; font-size: 16px; font-weight: 700; }
                    Text { text: "共 " + root.delete-paths.length + " 项 · 删除后无法恢复"; color: Theme.secondary; font-size: 11.5px; }
                }
            }
            if root.delete-fast: Rectangle {
                height: 40px; border-radius: 6px; background: Theme.danger.with-alpha(0.12); border-width: 1px; border-color: Theme.danger.with-alpha(0.4);
                Text { x: 12px; width: parent.width - 24px; height: 100%; text: "执行 rm -rf, 文件夹连同内容一起删除, 无法恢复"; color: Theme.danger; font-size: 11.5px; wrap: word-wrap; vertical-alignment: center; }
            }
            if !root.delete-fast: Text { text: "只能删除空文件夹, 非空文件夹请用快速删除"; color: Theme.secondary; font-size: 11.5px; wrap: word-wrap; }
            Rectangle {
                vertical-stretch: 1; border-radius: 6px; background: Theme.surface; border-width: 1px; border-color: Theme.border; clip: true;
                ListView {
                    for path in root.delete-paths: Rectangle {
                        height: 28px;
                        Icon { x: 10px; y: 6px; index: 2; colorize: Theme.muted; }
                        Text { x: 34px; width: parent.width - 48px; height: 100%; text: path; color: Theme.text; font-family: root.effective-terminal-font; font-size: 11.5px; overflow: elide; vertical-alignment: center; }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
                    }
                }
            }
            if root.file-operation-error != "": ErrorBanner { text: root.file-operation-error; }
            HorizontalBox {
                padding: 0px; spacing: 8px; alignment: end;
                AppButton { text: "取消"; enabled: !root.file-operation-busy; clicked => { root.delete-editing = false; } }
                AppButton { text: root.file-operation-busy ? "删除中…" : root.delete-fast ? "确认 rm -rf" : "删除"; enabled: !root.file-operation-busy; danger: true; clicked => { root.action("delete_files", ""); } }
            }
        }
    }
    // 连接管理: 单击分组展开/收起, 单击连接选中, 双击连接; 导入导出目标为当前选中的分组.
    if root.managing: Dialog {
        panel-width: min(740px, self.width - 48px); panel-height: min(520px, self.height - 72px); autofocus: true; enter-confirms: false;
        cancel => { root.managing = false; }
        VerticalBox {
            padding: 18px; spacing: 12px;
            HorizontalLayout {
                height: 34px; spacing: 8px;
                Text { text: "连接管理"; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                AppButton { y: 2px; text: "新建连接"; primary: true; clicked => { root.edit-connection(""); } }
                AppButton { y: 2px; text: "新建分组"; clicked => { root.action("edit_connection_group", ""); } }
                AppButton { y: 2px; text: "代理"; clicked => { root.proxy-managing = true; } }
                // 菜单与按钮包在同一格内, 布局中不多占一份间距, 所有按钮间距一致.
                // 顶部只放全局操作; 针对某个分组或服务器的操作在其右键菜单中.
                Rectangle {
                    width: data-button.preferred-width;
                    data-button := AppButton { y: 2px; text: "导入导出"; chevron: 3; clicked => { data-menu.show({x: 0px, y: 34px}); } }
                    data-menu := ContextMenuArea {
                        width: 0px; height: 0px;
                        Menu {
                            // 保留文件中原有的分组; 导入到指定分组请在分组上右键.
                            MenuItem { title: "导入连接文件…"; activated => { root.choose-path("import_all"); } }
                            MenuItem { title: "导入整个文件夹…"; activated => { root.choose-path("import_folder_all"); } }
                            MenuSeparator {}
                            MenuItem { title: "导出全部连接…"; enabled: root.connections.length > 0; activated => { root.choose-path("export_all"); } }
                        }
                    }
                }
                AppButton { y: 2px; text: "关闭"; icon: 11; width: 30px; horizontal-padding: 0px; clicked => { root.managing = false; } }
            }
            Rectangle {
                vertical-stretch: 1; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border; clip: true;
                // 表头: 主机及之后各列左边缘有拖动区 (光标变为左右箭头), 向左拖加宽该列、向右拖收窄; 名称列占剩余宽度, 至少留 120px.
                conn-header := Rectangle {
                    x: 0px; y: 0px; width: 100%; height: 30px; background: Theme.header;
                    // 列宽与列间距 12px、右边距 20px 一起从右往左排, 拖动区按同样的位置计算.
                    property <length> proxy-x: self.width - 20px - root.conn-col-proxy * 1px;
                    property <length> auth-x: self.proxy-x - 12px - root.conn-col-auth * 1px;
                    property <length> user-x: self.auth-x - 12px - root.conn-col-user * 1px;
                    property <length> port-x: self.user-x - 12px - root.conn-col-port * 1px;
                    property <length> host-x: self.port-x - 12px - root.conn-col-host * 1px;
                    // 拖动开始时的列宽与指针的窗口横坐标; 拖动区随列宽移动, 位移须按窗口坐标算, 否则会抖动.
                    property <int> drag-start;
                    property <length> drag-press-x;
                    HorizontalBox {
                        padding-left: 58px; padding-right: 20px; padding-top: 0px; padding-bottom: 0px; spacing: 12px;
                        Text { text: "名称"; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: "主机"; color: Theme.muted; font-size: 11px; width: root.conn-col-host * 1px; vertical-alignment: center; }
                        Text { text: "端口"; color: Theme.muted; font-size: 11px; width: root.conn-col-port * 1px; vertical-alignment: center; }
                        Text { text: "用户"; color: Theme.muted; font-size: 11px; width: root.conn-col-user * 1px; vertical-alignment: center; }
                        Text { text: "认证"; color: Theme.muted; font-size: 11px; width: root.conn-col-auth * 1px; vertical-alignment: center; }
                        Text { text: "代理"; color: Theme.muted; font-size: 11px; width: root.conn-col-proxy * 1px; vertical-alignment: center; }
                    }
                    // 用固定个数的重复 (而不是以各列位置为数据的数组): 拖动时位置变化不会重建拖动区, 否则按住的状态随之丢失, 只能拖动一点.
                    for i in 5: Rectangle {
                        x: (i == 0 ? conn-header.host-x : i == 1 ? conn-header.port-x : i == 2 ? conn-header.user-x : i == 3 ? conn-header.auth-x : conn-header.proxy-x) - 6px - 4px;
                        width: 8px; height: parent.height;
                        // 分隔线: 平时淡, 悬停或拖动时高亮.
                        Rectangle { x: 3px; y: 8px; width: 2px; height: parent.height - 16px; border-radius: 1px; background: col-touch.has-hover || col-touch.pressed ? Theme.accent : Theme.border; }
                        col-touch := TouchArea {
                            mouse-cursor: col-resize;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    conn-header.drag-start = i == 0 ? root.conn-col-host : i == 1 ? root.conn-col-port : i == 2 ? root.conn-col-user : i == 3 ? root.conn-col-auth : root.conn-col-proxy;
                                    conn-header.drag-press-x = self.absolute-position.x + self.mouse-x;
                                }
                                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.conn-columns-changed(); }
                            }
                            moved => {
                                if self.pressed {
                                    // 名称列至少保留 120px: 本列最多加宽到名称列剩余空间用完为止.
                                    let z_room = (conn-header.host-x - 58px - 12px - 120px) / 1px;
                                    let z_current = i == 0 ? root.conn-col-host : i == 1 ? root.conn-col-port : i == 2 ? root.conn-col-user : i == 3 ? root.conn-col-auth : root.conn-col-proxy;
                                    let z_width = round(max(40, min(400, min(z_current + z_room, conn-header.drag-start + (conn-header.drag-press-x - self.absolute-position.x - self.mouse-x) / 1px))));
                                    if i == 0 { root.conn-col-host = z_width; }
                                    if i == 1 { root.conn-col-port = z_width; }
                                    if i == 2 { root.conn-col-user = z_width; }
                                    if i == 3 { root.conn-col-auth = z_width; }
                                    if i == 4 { root.conn-col-proxy = z_width; }
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
                }
                // 空白处不弹菜单: 全局操作在顶部按钮, 分组与服务器的操作在各自右键菜单.
                Rectangle {
                    y: 30px; height: parent.height - 30px;
                connection-list := ListView {
                    vertical-scrollbar-policy: always-off;
                    for connection[i] in root.connection-tree: Rectangle {
                        // 行高统一, 拖动时按行高换算插入位置.
                        width: connection-list.visible-width; height: 36px;
                        opacity: root.drag-list == "conn" && root.drag-moved && root.drag-from == i ? 0.5 : 1;
                    if root.drag-list == "conn" && root.drag-moved && root.drag-from >= 0 && root.drag-to == i: Rectangle { y: 0px; height: 2px; background: Theme.accent; }
                    if root.drag-list == "conn" && root.drag-moved && root.drag-from >= 0 && root.drag-to == i + 1 && i == root.connection-tree.length - 1: Rectangle { y: parent.height - 2px; height: 2px; background: Theme.accent; }

                        // 连接行按 ID 选中; 分组行在未选具体连接时按分组名选中, 导入导出都以此为目标.
                        property <bool> selected: connection.folder ? root.selected-connection == "" && root.selected-connection-group == connection.group : root.selected-connection == connection.id;
                        Rectangle {
                            x: 6px; y: 2px; width: parent.width - 12px; height: parent.height - 4px; border-radius: 6px;
                            // 分组行带默认底色, 多个分组时与连接行区分明显.
                            background: parent.selected ? Theme.selected : connection-touch.has-hover ? Theme.hover : connection.folder ? Theme.header : transparent;
                        }
                        if connection.folder: Chevron { x: 14px; y: (parent.height - 10px) / 2; direction: connection.expanded ? 3 : 1; color: Theme.secondary; }
                        if connection.folder: FileIcon { x: 28px; y: (parent.height - 16px) / 2; index: connection.expanded ? 1 : 0; }
                        // 服务器只比分组缩进半格 (图标 34px, 名称 58px, 与表头"名称"左对齐), 层级可辨又不空出一大段.
                        if !connection.folder: Icon { x: 34px; y: (parent.height - 16px) / 2; index: 12; colorize: parent.selected ? Theme.accent : Theme.muted; }
                        HorizontalBox {
                            padding-left: connection.folder ? 50px : 58px; padding-right: 20px; padding-top: 0px; padding-bottom: 0px; spacing: 12px;
                            Text { text: connection.folder ? connection.name + "  (" + connection.count + ")" : connection.name; color: Theme.text; font-size: 12.5px; font-weight: connection.folder ? 600 : 400; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: connection.host; color: Theme.secondary; font-size: 12px; width: root.conn-col-host * 1px; overflow: elide; vertical-alignment: center; }
                            Text { text: connection.port; color: Theme.secondary; font-size: 12px; width: root.conn-col-port * 1px; overflow: elide; vertical-alignment: center; }
                            Text { text: connection.username; color: Theme.secondary; font-size: 12px; width: root.conn-col-user * 1px; overflow: elide; vertical-alignment: center; }
                            Text { text: connection.auth; color: Theme.secondary; font-size: 12px; width: root.conn-col-auth * 1px; overflow: elide; vertical-alignment: center; }
                            Text { text: connection.proxy; color: connection.proxy-id == "" ? Theme.muted : Theme.accent; font-size: 12px; width: root.conn-col-proxy * 1px; overflow: elide; vertical-alignment: center; }
                        }
                        connection-menu := ContextMenuArea {
                            // 连接: 连接 → 编辑 → 导出 → 删除; 分组: 新建 → 导入导出 → 重命名删除.
                            Menu {
                                // 服务器: 连接 → 设置 (编辑、代理) → 复制与导出 → 删除.
                                if !connection.folder: MenuItem { title: "连接"; activated => { root.managing = false; root.action("connect", connection.id); } }
                                if !connection.folder: MenuItem { title: "连接 (仅文件)"; activated => { root.managing = false; root.action("connect_files", connection.id); } }
                                if !connection.folder: MenuSeparator {}
                                if !connection.folder: MenuItem { title: "编辑…"; activated => { root.edit-connection(connection.id); } }
                                if !connection.folder: Menu {
                                    title: "代理";
                                    MenuItem { title: "直连"; icon: connection.proxy-id == "" ? @image-url("check.svg") : @image-url(""); activated => { root.action("proxy_connection", connection.id + "\n"); } }
                                    for proxy in root.proxies: MenuItem { title: proxy.name; icon: connection.proxy-id == proxy.id ? @image-url("check.svg") : @image-url(""); activated => { root.action("proxy_connection", connection.id + "\n" + proxy.id); } }
                                    MenuSeparator {}
                                    MenuItem { title: "代理管理…"; activated => { root.proxy-managing = true; } }
                                }
                                if !connection.folder: MenuSeparator {}
                                if !connection.folder: MenuItem { title: "复制主机地址"; activated => { root.copy-text(connection.host); } }
                                if !connection.folder: MenuItem { title: "导出此连接…"; activated => { root.choose-path("export"); } }
                                if !connection.folder: MenuSeparator {}
                                if !connection.folder: MenuItem { title: "删除连接"; activated => { root.action("remove_connection", connection.id); } }
                                // 分组: 组内新建 → 导入导出与代理 → 重命名删除 (默认分组没有这两项).
                                if connection.folder: MenuItem { title: "在此分组新建连接…"; activated => { root.edit-connection(""); } }
                                if connection.folder: MenuSeparator {}
                                if connection.folder: Menu {
                                    title: "导入到此分组";
                                    MenuItem { title: "连接文件…"; activated => { root.choose-path("import"); } }
                                    MenuItem { title: "整个文件夹…"; activated => { root.choose-path("import_folder"); } }
                                }
                                if connection.folder: MenuItem { title: "导出此分组…"; enabled: connection.count > 0; activated => { root.choose-path("export_group"); } }
                                if connection.folder: Menu {
                                    title: "整组使用代理";
                                    MenuItem { title: "直连"; enabled: connection.count > 0; activated => { root.action("proxy_group", connection.group + "\n"); } }
                                    for proxy in root.proxies: MenuItem { title: proxy.name; enabled: connection.count > 0; activated => { root.action("proxy_group", connection.group + "\n" + proxy.id); } }
                                    MenuSeparator {}
                                    MenuItem { title: "代理管理…"; activated => { root.proxy-managing = true; } }
                                }
                                if connection.folder && connection.group != "默认": MenuSeparator {}
                                if connection.folder && connection.group != "默认": MenuItem { title: "重命名分组…"; activated => { root.action("edit_connection_group", connection.group); } }
                                if connection.folder && connection.group != "默认": MenuItem { title: "删除分组 (连接移到默认)"; activated => { root.action("delete_connection_group", connection.group); } }
                            }
                            connection-touch := TouchArea {
                                mouse-cursor: pointer;
                                // 子触控区会先收到右键并吞掉, 需手动弹出外层菜单; 右键同时选中该行, 菜单操作都以它为目标.
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                        root.selected-connection-group = connection.group;
                                        root.selected-connection = connection.id;
                                        connection-menu.show({x: self.mouse-x, y: self.mouse-y});
                                    }
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.drag-press("conn", i); }
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.drag-release("conn"); }
                                }
                                moved => { if self.pressed { root.drag-move("conn", i, root.connection-tree.length, self.mouse-y, self.mouse-y - self.pressed-y, 36px); } }
                                clicked => {
                                    if root.drag-moved { return; }
                                    root.selected-connection-group = connection.group;
                                    root.selected-connection = connection.id;
                                    if connection.folder { root.action("toggle_connection_group", connection.group); }
                                }
                                double-clicked => { if !connection.folder { root.managing = false; root.action("connect", connection.id); } }
                                accessible-role: button;
                                accessible-label: connection.folder ? "分组 " + connection.name : "服务器 " + connection.name;
                                accessible-action-default => { self.clicked(); }
                            }
                        }
                    }
                }
                SlimScrollBar {
                    x: connection-list.x + connection-list.width - self.width; y: connection-list.y; height: connection-list.height;
                    viewport-y <=> connection-list.content-y; viewport-height: connection-list.content-height; visible-height: connection-list.visible-height;
                }
                }
            }
            // 底栏: 分组数在前、服务器数在后, 各带与列表相同的 SVG 图标 (不用字符符号, Windows 与 macOS 显示一致);
            // 左边与列表框边缘对齐, 与右侧按钮同一中线.
            HorizontalLayout {
                // 图标线条内收, 与列表框边缘齐平时看起来偏左, 右移 3px 视觉上对齐.
                height: 30px; spacing: 6px; padding-left: 3px;
                VerticalLayout { alignment: center; FileIcon { index: 0; width: 14px; height: 14px; } }
                Text { text: root.connection-groups.length + " 个分组"; color: Theme.secondary; font-size: 12px; vertical-alignment: center; }
                Rectangle { width: 4px; }
                VerticalLayout { alignment: center; Icon { index: 12; width: 14px; height: 14px; colorize: Theme.muted; } }
                Text { text: root.connections.length + " 台服务器"; color: Theme.secondary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                AppButton { text: "连接"; primary: true; width: 96px; enabled: root.selected-connection != ""; clicked => { root.managing = false; root.action("connect", root.selected-connection); } }
            }
        }
    }

    if root.goto-editing: Dialog {
        panel-width: 440px; panel-height: 168px;
        cancel => { root.goto-editing = false; }
        confirm => { if root.goto-path != "" { root.goto-editing = false; root.action("list_files", root.goto-path); } }
        VerticalBox {
            padding: 16px; spacing: 10px;
            Text { text: "转到目录"; color: Theme.text; font-size: 15px; font-weight: 600; }
            LineEdit {
                text <=> root.goto-path; placeholder-text: "/var/log"; accessible-label: "目标目录";
                init => { self.focus(); self.select-all(); }
                accepted => { if root.goto-path != "" { root.goto-editing = false; root.action("list_files", root.goto-path); } }
            }
            HorizontalBox {
                padding: 0px; spacing: 8px; alignment: end;
                AppButton { text: "取消"; clicked => { root.goto-editing = false; } }
                AppButton { text: "转到"; primary: true; clicked => { if root.goto-path != "" { root.goto-editing = false; root.action("list_files", root.goto-path); } } }
            }
        }
    }
    if root.group-editing: Dialog {
        panel-width: 380px; panel-height: max(208px, group-layout.preferred-height);
        cancel => { root.group-editing = false; }
        confirm => { root.submit-group(); }
        group-layout := VerticalBox {
            padding: 18px; spacing: 12px;
            Text { text: (root.group-old-name == "" ? "新增" : "编辑") + (root.group-target == "connection" ? "连接分组" : "命令分组"); color: Theme.text; font-size: 16px; font-weight: 600; }
            LineEdit { text <=> root.group-name; placeholder-text: "分组名称"; accessible-label: "命令分组名称"; init => { self.focus(); self.select-all(); } accepted => { root.submit-group(); } }
            if root.form-error != "": ErrorBanner { text: root.form-error; }
            Text { text: root.group-old-name == "" ? "" : root.group-target == "connection" ? "删除分组时, 其中的连接会移到默认分组." : "删除分组时, 其中的命令会移到其他分组."; color: Theme.secondary; font-size: 11px; }
            HorizontalBox {
                padding: 0px; spacing: 8px;
                AppButton { text: "删除分组"; danger: true; enabled: root.group-old-name != "" && (root.group-target == "connection" || root.command-groups.length > 1); clicked => { root.action(root.group-target == "connection" ? "delete_connection_group" : "delete_command_group", root.group-old-name); } }
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "取消"; clicked => { root.group-editing = false; } }
                AppButton { text: "保存"; primary: true; clicked => { root.submit-group(); } }
            }
        }
    }
    if root.command-editing: Dialog {
        panel-width: min(640px, self.width - 48px); panel-height: min(480px, self.height - 72px);
        // 命令内容为多行输入, 回车用于换行, 不触发保存.
        enter-confirms: false;
        cancel => { root.command-editing = false; }
        VerticalBox {
            padding: 20px; spacing: 10px;
            Text { text: root.saved-command-id == "" ? "新增命令" : "编辑命令"; color: Theme.text; font-size: 18px; font-weight: 700; }
            HorizontalBox {
                padding: 0px; spacing: 8px; height: 32px;
                LineEdit { text <=> root.saved-command-name; placeholder-text: "命令名称"; horizontal-stretch: 1; init => { self.focus(); } accepted => { root.save-command(); } }
                AppSelect { width: 180px; horizontal-stretch: 0; model: root.command-groups; current-index <=> root.saved-command-group-index; label: "命令分组"; selected(value) => { root.saved-command-group = value; } }
            }
            if root.form-error != "": ErrorBanner { text: root.form-error; }
            TextEdit { text <=> root.saved-command-text; placeholder-text: "多行命令内容"; font-family: root.effective-terminal-font; wrap: no-wrap; vertical-stretch: 1; }
            HorizontalBox {
                height: 30px; spacing: 8px; padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "取消"; clicked => { root.command-editing = false; } }
                AppButton { text: "保存"; primary: true; clicked => { root.save-command(); } }
            }
        }
    }

    // 连接编辑: 服务器、登录、AI 控制三张卡片. 每张卡片行数固定, 切换认证方式或 sudo 选项时窗口大小不变.
    // 两栏行 (分组/代理、用户/密码、sudo/密码) 左栏同宽、右栏标签同宽, 各卡片的列上下对齐. 密码一律保存在连接文件中.
    if root.editing: Dialog {
        // 面板高度只随错误提示变化; 窗口较窄时收窄.
        panel-width: min(520px, root.width - 32px); panel-height: edit-layout.preferred-height;
        cancel => { root.edit-password = ""; root.edit-admin-password = ""; root.editing = false; }
        confirm => { root.save-connection(); }
        edit-layout := VerticalLayout {
            padding: 24px; spacing: 14px;
            Text { text: root.edit-id == "" ? "新建连接" : "编辑连接"; color: Theme.text; font-size: 17px; font-weight: 700; }
            FormCard {
                title: "服务器";
                FormRow {
                    label: "名称";
                    LineEdit { text <=> root.edit-name; placeholder-text: "默认用主机地址"; init => { self.focus(); } accepted => { root.save-connection(); } }
                }
                FormRow {
                    label: "主机";
                    LineEdit { text <=> root.edit-host; horizontal-stretch: 1; placeholder-text: "IP 或域名"; accepted => { root.save-connection(); } }
                    Text { text: "端口"; width: 26px; color: Theme.secondary; font-size: 12.5px; vertical-alignment: center; }
                    LineEdit { text <=> root.edit-port; width: 72px; horizontal-stretch: 0; accepted => { root.save-connection(); } }
                }
                FormRow {
                    label: "分组";
                    AppSelect { width: 160px; horizontal-stretch: 0; model: root.connection-groups; current-index <=> root.edit-group-index; label: "连接分组"; selected(c_value) => { root.edit-group = c_value; } }
                    Text { text: "代理"; width: 26px; color: Theme.secondary; font-size: 12.5px; vertical-alignment: center; }
                    AppSelect { model: root.edit-proxy-choices; current-index <=> root.edit-proxy-index; label: "代理"; selected => { root.edit-proxy-id = root.edit-proxy-ids[self.current-index]; } }
                    AppButton { text: "代理管理"; icon: 13; width: 32px; horizontal-padding: 0px; clicked => { root.proxy-managing = true; } }
                }
            }
            // 登录: 第一行选认证方式, 选密钥时同一行接着选私钥文件; 第二行用户与密码, 密钥方式下密码即私钥密码.
            // 键盘交互认证 (验证码等) 少用, 只在已是该方式的连接上作为第三项出现, 保证旧连接仍可编辑; 此时密码在连接时输入.
            FormCard {
                title: "登录";
                FormRow {
                    label: "认证";
                    Segmented {
                        items: root.edit-auth == 2 ? ["密码", "密钥", "键盘交互"] : ["密码", "密钥"]; current: root.edit-auth; label: "认证方式";
                        selected(c_index) => { root.edit-auth = c_index; }
                    }
                    if root.edit-auth == 1: LineEdit { horizontal-stretch: 1; text <=> root.edit-key-path; placeholder-text: "选择本机私钥"; accepted => { root.save-connection(); } }
                    if root.edit-auth == 1: AppButton { text: "选择…"; horizontal-padding: 10px; clicked => { root.choose-path("key"); } }
                    if root.edit-auth != 1: Rectangle { horizontal-stretch: 1; }
                }
                FormRow {
                    label: "用户";
                    LineEdit { width: 160px; horizontal-stretch: 0; text <=> root.edit-user; accepted => { root.save-connection(); } }
                    Text { text: "密码"; width: 26px; color: Theme.secondary; font-size: 12.5px; vertical-alignment: center; }
                    PasswordEdit {
                        text <=> root.edit-password; enabled: root.edit-auth != 2;
                        placeholder-text: root.edit-auth == 2 ? "连接时输入" : root.edit-auth == 1 ? "私钥无密码可留空" : "留空则连接时输入";
                        accepted => { root.save-connection(); }
                    }
                }
            }
            // AI 控制: MCP 授权与 sudo 密码 (终端右键或快捷键一键输入; 授权后 AI 也可在密码提示处代填).
            // sudo 行与登录的用户/密码行同样两栏: "单独设置"时右侧可输入; "同登录密码"时只读显示登录密码 (可用眼睛查看);
            // 密钥登录没有登录密码, 此时提示改用单独设置.
            FormCard {
                title: "AI 控制";
                FormRow {
                    label: "MCP";
                    AppCheckBox { text: "允许 AI 操作此服务器"; checked <=> root.edit-mcp; }
                    Rectangle { horizontal-stretch: 1; }
                }
                FormRow {
                    label: "sudo";
                    AppSelect { width: 160px; horizontal-stretch: 0; model: ["不使用", "同登录密码", "单独设置"]; current-index <=> root.edit-admin; label: "sudo 密码"; }
                    Text { text: "密码"; width: 26px; color: Theme.secondary; font-size: 12.5px; vertical-alignment: center; }
                    if root.edit-admin == 2: PasswordEdit {
                        text <=> root.edit-admin-password;
                        placeholder-text: root.edit-admin-saved ? "留空不修改" : "输入 sudo 密码";
                        accepted => { root.save-connection(); }
                    }
                    if root.edit-admin != 2: PasswordEdit {
                        text: root.edit-admin == 1 && root.edit-auth == 0 ? root.edit-password : "";
                        enabled: root.edit-admin == 1 && root.edit-auth == 0; read-only: true;
                        placeholder-text: root.edit-admin == 0 ? "" : root.edit-auth != 0 ? "非密码登录, 请单独设置" : "先填写登录密码";
                    }
                }
            }
            if root.form-error != "": ErrorBanner { text: root.form-error; }
            HorizontalLayout {
                height: 30px; spacing: 8px; padding-top: 4px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "取消"; clicked => { root.edit-password = ""; root.edit-admin-password = ""; root.editing = false; } }
                AppButton { text: "保存"; primary: true; width: 90px; clicked => { root.save-connection(); } }
            }
        }
    }
    // 代理对话框放在连接编辑之后, 从编辑连接中打开时显示在其上方.
    // 代理管理: 列出全部代理, 新建、编辑、删除; 服务器在连接管理右键或编辑连接中选择使用哪个.
    if root.proxy-managing: Dialog {
        panel-width: min(620px, self.width - 48px); panel-height: min(420px, self.height - 72px); autofocus: true; enter-confirms: false;
        cancel => { root.proxy-managing = false; }
        VerticalBox {
            padding: 18px; spacing: 12px;
            HorizontalLayout {
                height: 34px; spacing: 8px;
                Text { text: "代理管理"; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                AppButton { y: 2px; text: "新建代理"; primary: true; clicked => { root.edit-proxy({}); } }
                AppButton { y: 2px; text: "关闭"; icon: 11; width: 30px; horizontal-padding: 0px; clicked => { root.proxy-managing = false; } }
            }
            Rectangle {
                vertical-stretch: 1; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border; clip: true;
                if root.proxies.length == 0: Text { text: "暂无代理"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                // 每行: 类型标签 | 名称与地址 | 使用数 | 编辑 删除 (文字按钮, 删除悬停才变红). 双击或右键同样可编辑.
                proxy-list := ListView {
                    vertical-scrollbar-policy: always-off;
                    for proxy in root.proxies: Rectangle {
                        width: proxy-list.visible-width; height: 56px;
                        Rectangle {
                            x: 6px; y: 3px; width: parent.width - 12px; height: parent.height - 6px; border-radius: 6px;
                            background: root.proxy-selected == proxy.id ? Theme.selected : proxy-touch.has-hover ? Theme.hover : transparent;
                        }
                        proxy-menu := ContextMenuArea {
                            Menu {
                                MenuItem { title: "编辑…"; activated => { root.edit-proxy(proxy); } }
                                MenuItem { title: "删除"; activated => { root.action("delete_proxy", proxy.id); } }
                            }
                            proxy-touch := TouchArea {
                                pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { proxy-menu.show({x: self.mouse-x, y: self.mouse-y}); } }
                                clicked => { root.proxy-selected = proxy.id; }
                                double-clicked => { root.edit-proxy(proxy); }
                            }
                        }
                        Rectangle {
                            x: 18px; y: (parent.height - 22px) / 2; width: 56px; height: 22px; border-radius: 4px;
                            background: proxy.kind == "http" ? Theme.cpu.with-alpha(0.14) : Theme.accent.with-alpha(0.14);
                            Text { width: 100%; height: 100%; text: proxy.kind == "http" ? "HTTP" : "SOCKS5"; color: proxy.kind == "http" ? Theme.cpu : Theme.accent; font-size: 10.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { x: 88px; y: 10px; width: parent.width - 300px; height: 18px; text: proxy.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                        Text {
                            x: 88px; y: 29px; width: parent.width - 300px; height: 16px;
                            text: proxy.host + ":" + proxy.port + (proxy.username != "" ? "  ·  用户 " + proxy.username : "");
                            color: Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center;
                        }
                        Text { x: parent.width - 200px; width: 80px; height: 100%; text: proxy.users > 0 ? proxy.users + " 台使用" : "未使用"; color: proxy.users > 0 ? Theme.secondary : Theme.muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                        Text {
                            x: parent.width - 108px; width: 40px; height: 100%; text: "编辑"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                            color: edit-link.has-hover ? Theme.accent : Theme.secondary;
                            edit-link := TouchArea { mouse-cursor: pointer; clicked => { root.edit-proxy(proxy); } }
                        }
                        Text {
                            x: parent.width - 62px; width: 40px; height: 100%; text: "删除"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                            color: delete-link.has-hover ? Theme.danger : Theme.muted;
                            delete-link := TouchArea { mouse-cursor: pointer; clicked => { root.action("delete_proxy", proxy.id); } }
                        }
                    }
                }
                SlimScrollBar {
                    x: proxy-list.x + proxy-list.width - self.width; y: proxy-list.y; height: proxy-list.height;
                    viewport-y <=> proxy-list.content-y; viewport-height: proxy-list.content-height; visible-height: proxy-list.visible-height;
                }
            }
            Text { text: "在编辑连接或右键菜单中选择代理; 删除后相关服务器改为直连"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        }
    }
    if root.proxy-editing: Dialog {
        panel-width: 440px; panel-height: proxy-layout.preferred-height;
        cancel => { root.proxy-edit-password = ""; root.proxy-editing = false; }
        confirm => { root.save-proxy(); }
        proxy-layout := VerticalLayout {
            padding: 22px; spacing: 12px;
            Text { text: root.proxy-edit-id == "" ? "新建代理" : "编辑代理"; color: Theme.text; font-size: 16px; font-weight: 700; }
            GridLayout {
                spacing-horizontal: 10px; spacing-vertical: 8px;
                Row {
                    Text { text: "名称"; color: Theme.secondary; width: 44px; vertical-alignment: center; }
                    LineEdit { colspan: 3; text <=> root.proxy-edit-name; placeholder-text: ""; init => { self.focus(); } accepted => { root.save-proxy(); } }
                }
                Row {
                    Text { text: "类型"; color: Theme.secondary; vertical-alignment: center; }
                    AppSelect { colspan: 3; model: ["SOCKS5", "HTTP"]; current-index <=> root.proxy-edit-kind; label: "代理类型"; }
                }
                Row {
                    Text { text: "地址"; color: Theme.secondary; vertical-alignment: center; }
                    LineEdit { text <=> root.proxy-edit-host; horizontal-stretch: 1; placeholder-text: "IP 或域名"; accepted => { root.save-proxy(); } }
                    Text { text: "端口"; color: Theme.secondary; width: 32px; vertical-alignment: center; horizontal-alignment: right; }
                    LineEdit { text <=> root.proxy-edit-port; width: 80px; accepted => { root.save-proxy(); } }
                }
                Row {
                    Text { text: "用户"; color: Theme.secondary; vertical-alignment: center; }
                    LineEdit { colspan: 3; text <=> root.proxy-edit-user; placeholder-text: "可选"; accepted => { root.save-proxy(); } }
                }
                Row {
                    Text { text: "密码"; color: Theme.secondary; vertical-alignment: center; }
                    LineEdit {
                        colspan: 3; text <=> root.proxy-edit-password; input-type: password;
                        placeholder-text: root.proxy-edit-has-password ? "留空不修改" : "可选";
                        accepted => { root.save-proxy(); }
                    }
                }
            }
            if root.form-error != "": ErrorBanner { text: root.form-error; }
            HorizontalLayout {
                height: 30px; spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "取消"; clicked => { root.proxy-edit-password = ""; root.proxy-editing = false; } }
                AppButton { text: "保存"; primary: true; width: 90px; clicked => { root.save-proxy(); } }
            }
        }
    }

    if root.settings-open: Rectangle {
        background: Theme.overlay;
        FocusScope {
            init => {
                TipState.text = "";
                root.font-draft = root.terminal-font;
                root.font-draft-index = root.font-index(root.terminal-font);
                root.font-size-draft = round(root.term-font-size / 1px);
                self.focus();
            }
            key-pressed(event) => { if event.text == Key.Escape { root.settings-open = false; terminal-input.focus(); return accept; } return reject; }
            Rectangle {
                width: 700px; height: min(parent.height - 40px, 496px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: Theme.dialog; border-radius: 10px; border-width: 1px; border-color: Theme.border; clip: true;
                // 左侧竖排页签, 右侧为当前页内容; 新增设置时在 settings-pages 追加一项并补对应页面.
                Rectangle {
                    x: 0px; y: 0px; width: 160px; height: 100%; background: Theme.surface;
                    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.separator; }
                    VerticalBox {
                        padding: 12px; spacing: 4px; alignment: start;
                        Text { height: 34px; text: "设置"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                        for page[i] in root.settings-pages: Rectangle {
                            height: 32px; border-radius: 6px;
                            background: root.settings-page == i ? Theme.selected : page-touch.has-hover ? Theme.hover : transparent;
                            Rectangle { x: 0px; y: 8px; width: 3px; height: parent.height - 16px; border-radius: 2px; background: root.settings-page == i ? Theme.accent : transparent; }
                            Text { x: 14px; width: parent.width - 20px; height: 100%; text: page; color: root.settings-page == i ? Theme.text : Theme.secondary; font-size: 13px; font-weight: root.settings-page == i ? 600 : 400; vertical-alignment: center; }
                            page-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.settings-page = i; settings-scroll.content-y = 0px; }
                                accessible-role: tab; accessible-label: page;
                                accessible-action-default => { self.clicked(); }
                            }
                        }
                    }
                }
                AppButton { x: parent.width - 40px; y: 12px; text: "关闭设置"; icon: 11; width: 28px; clicked => { root.settings-open = false; terminal-input.focus(); } }
                // 设置窗口大小固定; 页面标题固定在顶部, 只有标题下方的内容区滚动 (统一的细滚动条); 新增设置不需要调整窗口.
                // 底部留白统一 20px: MCP 页的服务器列表填满剩余高度, 底边正好留 20px; 其他页内容超出时出现滚动条,
                // 滚到底时同样留 20px; 内容不足一屏的页从顶部排列.
                Text {
                    x: 180px; y: 16px; width: parent.width - 180px - 50px; height: 34px;
                    text: root.settings-pages[root.settings-page]; color: Theme.text; font-size: 19px; font-weight: 700; vertical-alignment: center;
                }
                SlimScrollBar {
                    x: parent.width - self.width - 2px; y: 62px; height: parent.height - 70px;
                    viewport-y <=> settings-scroll.content-y; viewport-height: settings-scroll.content-height; visible-height: settings-scroll.visible-height;
                }
                settings-scroll := ScrollView {
                    x: 160px; y: 62px; width: parent.width - 160px - 16px; height: parent.height - 62px;
                    horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
                    content-height: max(self.visible-height, settings-page-box.preferred-height);
                settings-page-box := VerticalBox {
                    width: settings-scroll.visible-width; height: settings-scroll.content-height;
                    // 右侧已为滚动条让出 16px, 右边距相应减小, 与左边视觉一致.
                    padding: 20px; padding-top: 0px; padding-bottom: 20px; padding-right: 6px; spacing: 12px;
                    if root.settings-page == 0: VerticalLayout {
                        alignment: start;
                        spacing: 18px;
                        SettingsGroup {
                            title: "界面";
                            SettingsRow {
                                label: "主题";
                                Segmented {
                                    items: ["深色", "浅色"]; current: root.theme-index; label: "主题";
                                    selected(c_index) => { root.theme-index = c_index; root.theme-changed(c_index); }
                                }
                            }
                            SettingsRow {
                                divider: true;
                                label: "显示分组"; tip: "服务器名称前显示 [分组]";
                                Segmented {
                                    items: ["显示", "不显示"]; current: root.tab-show-group ? 0 : 1; label: "显示分组";
                                    selected(c_index) => { root.tab-show-group = c_index == 0; root.tab-show-group-changed(root.tab-show-group); }
                                }
                            }
                            SettingsRow {
                                divider: true;
                                label: "窗口布局"; tip: "窗口大小、监控栏和底部面板";
                                AppButton { text: "恢复默认"; clicked => { root.reset-layout(); } }
                            }
                        }
                        SettingsGroup {
                            title: "终端字体";
                            SettingsRow {
                                label: "字体";
                                AppSelect {
                                    width: 170px; model: root.font-candidates; current-index <=> root.font-draft-index;
                                    label: "终端字体";
                                    selected(c_value) => { root.font-draft = c_value; }
                                }
                                download-button := AppButton {
                                    text: "下载字体";
                                    clicked => { download-popup.show(); }
                                }
                                download-popup := PopupWindow {
                                    x: download-button.x; y: download-button.y + download-button.height + 4px;
                                    width: 230px; height: root.font-downloads.length * 31px + 8px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        background: Theme.dialog; border-radius: 6px; border-width: 1px; border-color: Theme.border;
                                        drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 2px;
                                        VerticalLayout {
                                            padding: 4px; spacing: 1px;
                                            for font in root.font-downloads: Rectangle {
                                                height: 30px; border-radius: 4px;
                                                background: font-touch.has-hover && font.state != 1 ? Theme.hover : transparent;
                                                Text { x: 10px; width: parent.width - 90px; height: 100%; text: font.name; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                                Text {
                                                    x: parent.width - 80px; width: 70px; height: 100%; horizontal-alignment: right; vertical-alignment: center; font-size: 11px;
                                                    text: font.state == 0 ? "下载" : font.state == 1 ? "下载中…" : "已下载 · 使用";
                                                    color: font.state == 0 ? Theme.accent : Theme.muted;
                                                }
                                                font-touch := TouchArea {
                                                    mouse-cursor: font.state == 1 ? default : pointer;
                                                    clicked => {
                                                        if font.state == 0 { root.font-download(font.name); }
                                                        if font.state == 2 { root.font-draft = font.name; root.font-draft-index = root.font-index(font.name); download-popup.close(); }
                                                    }
                                                    accessible-role: button; accessible-label: font.state == 2 ? "使用 " + font.name : "下载 " + font.name;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            SettingsRow {
                                divider: true; label: "字号";
                                Stepper { minimum: 9; maximum: 28; value <=> root.font-size-draft; label: "字号"; }
                            }
                            // 预览按未应用的草稿显示, 应用后才影响终端.
                            VerticalLayout {
                                padding-bottom: 12px; spacing: 10px;
                                Rectangle {
                                    height: 84px; background: Theme.terminal; border-radius: 6px; border-width: 1px; border-color: Theme.border; clip: true;
                                    Text {
                                        x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px;
                                        text: "user@server:~$ ls -la /etc\ndrwxr-xr-x  2 root root  4096 nginx\n中文显示 English 0O 1lI {}[]() => != <=";
                                        font-family: root.font-draft != "" && root.draft-font-mono ? root.font-draft : root.default-terminal-font;
                                        font-size: root.font-size-draft * 1px;
                                        color: Theme.terminal-text; wrap: no-wrap; overflow: clip;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px; alignment: end;
                                    AppButton { text: "恢复默认"; clicked => { root.font-draft = root.default-terminal-font; root.font-draft-index = root.font-index(root.default-terminal-font); root.font-size-draft = 13; } }
                                    AppButton {
                                        text: "应用"; primary: true;
                                        enabled: (root.font-draft == "" ? root.default-terminal-font : root.font-draft) != root.terminal-font || root.font-size-draft * 1px != root.term-font-size;
                                        clicked => {
                                            root.terminal-font = root.font-draft == "" ? root.default-terminal-font : root.font-draft;
                                            root.term-font-size = root.font-size-draft * 1px;
                                            root.terminal-font-changed(root.terminal-font, root.font-size-draft);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.settings-page == 1: VerticalLayout {
                        spacing: 18px; alignment: start;
                        SettingsGroup {
                            title: "历史记录";
                            SettingsRow {
                                label: "回看行数";
                                tip: "每个标签可上翻的行数, 新连接生效";
                                Segmented {
                                    items: ["1000 行", "2000 行", "5000 行", "10000 行"]; label: "历史行数";
                                    current: root.terminal-history-limit == 1000 ? 0 : root.terminal-history-limit == 2000 ? 1 : root.terminal-history-limit == 5000 ? 2 : 3;
                                    selected(c_index) => {
                                        root.terminal-history-limit = c_index == 0 ? 1000 : c_index == 1 ? 2000 : c_index == 2 ? 5000 : 10000;
                                        root.terminal-history-changed(root.terminal-history-limit);
                                    }
                                }
                            }
                        }
                        SettingsGroup {
                            title: "文件传输";
                            SettingsRow {
                                label: "下载目录";
                                tip: "右键“下载”保存到这里";
                                hint: root.download-dir;
                                AppButton { text: "更改"; clicked => { root.choose-path("download_dir"); } }
                            }
                        }
                    }
                    // MCP: 服务卡片三行 (开关与状态、端口、复制配置), 下面是可操作的服务器.
                    if root.settings-page == 2: VerticalLayout {
                        spacing: 18px;
                        SettingsGroup {
                            title: "服务";
                            SettingsRow {
                                label: "MCP 服务";
                                hint: !root.mcp-enabled ? "已关闭" : root.mcp-error != "" ? root.mcp-error : root.mcp-url;
                                hint-color: !root.mcp-enabled ? Theme.muted : root.mcp-error != "" ? Theme.danger : Theme.secondary;
                                // 状态标签兼作检测按钮: 未检测时显示运行状态, 检测后显示结论, 悬停看原因.
                                if root.mcp-enabled: VerticalLayout {
                                    alignment: center;
                                    StatusTip {
                                        enabled: root.mcp-url != "" && !root.mcp-checking;
                                        tone: root.mcp-checking ? Theme.muted
                                            : root.mcp-error != "" ? Theme.danger
                                            : root.mcp-check-title == "" ? Theme.network
                                            : root.mcp-check-level == 0 ? Theme.network : root.mcp-check-level == 1 ? Theme.caution : Theme.danger;
                                        text: root.mcp-checking ? "检测中…" : root.mcp-error != "" ? "异常" : root.mcp-check-title == "" ? "运行中" : root.mcp-check-title;
                                        tip: root.mcp-error != "" ? root.mcp-error : root.mcp-check-title == "" ? "AI 连不上时点击检测" : root.mcp-check-detail;
                                        clicked => { root.mcp-self-check(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    ToggleSwitch { checked: root.mcp-enabled; label: "启用 MCP 服务"; toggled => { root.mcp-apply(!root.mcp-enabled, root.mcp-port); } }
                                }
                            }
                            SettingsRow {
                                divider: true; label: "端口"; tip: "默认 7391, 被占用时换一个";
                                // 改动后才出现应用, 也可直接回车.
                                if root.mcp-port-draft != root.mcp-port: AppButton {
                                    text: "应用"; primary: true;
                                    clicked => { root.mcp-apply(root.mcp-enabled, root.mcp-port-draft); }
                                }
                                LineEdit {
                                    width: 84px; text <=> root.mcp-port-draft; input-type: number; accessible-label: "MCP 端口";
                                    accepted => { if root.mcp-port-draft != root.mcp-port { root.mcp-apply(root.mcp-enabled, root.mcp-port-draft); } }
                                }
                            }
                            SettingsRow {
                                divider: true; label: "复制配置"; tip: "安装说明发给 AI 自动配置; 网址和 JSON 供手动配置";
                                AppButton { text: "网址"; enabled: root.mcp-url != ""; clicked => { root.copy-text(root.mcp-url); root.notify(1, "网址已复制"); } }
                                AppButton { text: "JSON"; enabled: root.mcp-config != ""; clicked => { root.copy-text(root.mcp-config); root.notify(1, "JSON 配置已复制"); } }
                                AppButton { text: "安装说明"; primary: true; enabled: root.mcp-prompt != ""; clicked => { root.copy-text(root.mcp-prompt); root.notify(1, "已复制, 粘贴给 AI 即可"); } }
                            }
                        }
                        // 服务器列表组填满页面剩余高度, 使页面底边留白与其他页滚到底时一致.
                        SettingsGroup {
                            vertical-stretch: 1;
                            title: "AI 可操作的服务器 · " + root.mcp-servers.length + " 台";
                            tip: "在连接编辑中勾选“允许 MCP 使用此连接”添加";
                            if root.mcp-servers.length == 0: SettingsRow {
                                label: "暂无";
                            }
                            // 列表区至少 6 行高, 并伸展填满剩余高度; 服务器更多时在列表内滚动.
                            if root.mcp-servers.length > 0: server-area := Rectangle {
                                min-height: 6 * 34px; vertical-stretch: 1;
                                // 空行也画分隔线, 列表区看起来是完整的若干行.
                                for k in max(0, floor(server-area.height / 34px) - root.mcp-servers.length): Rectangle {
                                    x: 0px; y: (root.mcp-servers.length + k) * 34px; width: parent.width; height: 1px; background: Theme.separator;
                                }
                                server-list := ListView {
                                    vertical-scrollbar-policy: always-off;
                                    for server[i] in root.mcp-servers: Rectangle {
                                        width: server-list.visible-width; height: 34px;
                                        if i > 0: Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.separator; }
                                        Rectangle { x: 0px; y: 13px; width: 8px; height: 8px; border-radius: 4px; background: Theme.network; }
                                        // 右侧留出滚动条位置.
                                        Text { x: 16px; width: parent.width - 30px; height: 100%; text: server; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                    }
                                }
                                // 组卡片有 14px 内边距, 滚动条右移贴近卡片边缘.
                                SlimScrollBar {
                                    x: parent.width - self.width + 8px; y: 0px; height: parent.height;
                                    viewport-y <=> server-list.content-y; viewport-height: server-list.content-height; visible-height: server-list.visible-height;
                                }
                            }
                        }
                    }
                    // 关于: 图标、名称、版本与一句简介, 下方只列作者与基础架构.
                    if root.settings-page == 3: VerticalBox {
                        padding: 0px; spacing: 16px; alignment: start;
                        HorizontalLayout {
                            spacing: 14px; height: 56px;
                            Image { width: 56px; height: 56px; source: @image-url("../assets/hipshell-icon.png"); }
                            VerticalLayout {
                                alignment: center; spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Text { text: "HiPShell"; color: Theme.text; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: version-text.preferred-width + 14px; height: 18px; border-radius: 9px;
                                            background: Theme.accent.with-alpha(0.15);
                                            version-text := Text { x: 7px; height: 100%; text: root.app-version; color: Theme.accent; font-size: 10.5px; font-weight: 600; vertical-alignment: center; }
                                        }
                                    }
                                }
                                Text { text: "轻量 SSH 客户端, 终端、文件与 MCP 共用会话."; color: Theme.secondary; font-size: 12px; }
                            }
                        }
                        Rectangle {
                            height: about-rows.preferred-height; background: Theme.panel; border-width: 1px; border-color: Theme.border; border-radius: 6px;
                            about-rows := VerticalLayout {
                                padding: 4px;
                                for item[i] in [
                                    { key: "作者", value: "HiPsHoW" },
                                    { key: "架构", value: "Rust · Slint · russh · vt100 · MCP" },
                                ]: Rectangle {
                                    height: 30px;
                                    if i > 0: Rectangle { x: 8px; y: 0px; width: parent.width - 16px; height: 1px; background: Theme.separator; }
                                    Text { x: 10px; width: 48px; height: 100%; text: item.key; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    Text { x: 64px; width: parent.width - 74px; height: 100%; text: item.value; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                    }
                }
                }
            }
        }
    }
    if root.trust-session != "": Dialog {
        panel-width: 500px; panel-height: 252px; autofocus: true;
        // 信任主机必须明确点击; Esc 视为拒绝.
        enter-confirms: false;
        cancel => { root.action("trust_reject", root.trust-session); }
        VerticalBox {
            padding: 18px; spacing: 10px;
            Text { text: root.trust-changed ? "警告: 主机指纹已变化" : "确认首次连接的主机指纹"; color: root.trust-changed ? Theme.warning : Theme.text; font-size: 16px; font-weight: 600; }
            Text { text: "请核对服务器指纹后决定是否连接."; color: Theme.secondary; }
            TextEdit { text: root.trust-fingerprint; read-only: true; vertical-stretch: 1; }
            HorizontalBox {
                height: 30px; spacing: 8px; padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "拒绝"; danger: true; clicked => { root.action("trust_reject", root.trust-session); } }
                AppButton { text: "信任一次"; clicked => { root.action("trust_once", root.trust-session); } }
                AppButton { text: "永久信任"; primary: true; clicked => { root.action("trust_permanent", root.trust-session); } }
            }
        }
    }
    if root.auth-session != "" && root.trust-session == "": Dialog {
        panel-width: 600px; panel-height: min(600px, 170px + root.prompts.length * 68px);
        cancel => { root.action("disconnect", root.auth-session); }
        confirm => { root.action("answer_auth", root.auth-session); }
        VerticalBox {
            padding: 20px; spacing: 10px;
            Text { text: "登录认证"; color: Theme.text; font-size: 18px; font-weight: 700; }
            ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    for prompt[i] in root.prompts: VerticalBox {
                        Text { text: prompt.prompt; color: Theme.secondary; wrap: word-wrap; }
                        answer := LineEdit {
                            property <int> generation: root.auth-generation;
                            input-type: prompt.echo ? text : password;
                            init => { if i == 0 { self.focus(); } }
                            changed generation => { self.text = ""; }
                            edited => { root.auth-edit(i, self.text); }
                            accepted => { if i == root.prompts.length - 1 { root.action("answer_auth", root.auth-session); } }
                        }
                    }
                }
            }
            HorizontalBox {
                height: 30px; spacing: 8px; padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "取消认证"; clicked => { root.action("disconnect", root.auth-session); } }
                AppButton { text: "提交回答"; primary: true; clicked => { root.action("answer_auth", root.auth-session); } }
            }
        }
    }
    // 悬停说明画在窗口最上层: 箭头对准悬停区域下边缘中点并留 8px 间隔, 气泡左右不超出窗口.
    if TipState.text != "" && root.settings-open: TipBubble {
        x: max(8px, min(root.width - self.width - 8px, TipState.x - 16px));
        y: TipState.y + 8px;
        arrow-x: TipState.x - self.x;
        text: TipState.text;
    }
}
